---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import PostCard from '../../components/cards/PostCard.astro'
import SeriesCard from '../../components/cards/SeriesCard.astro'
import { buildFeed } from '@/lib/blog/feed'

const FRESH_DAYS = 14

const posts = (await getCollection('blog')).filter(
  (post) =>
    import.meta.env.DEV ||
    import.meta.env.PUBLIC_PREVIEW === 'true' ||
    post.data.published !== false,
)

const seriesDescriptions = await getCollection('series-descriptions')
const seriesTitleBySlug = new Map(
  seriesDescriptions.map((entry) => [entry.slug, entry.data.title]),
)

const feed = buildFeed(posts, { now: new Date(), freshDays: FRESH_DAYS })
---

<Layout title="Blog">
  <section class="section-full">
    <div class="container-bordered">
      <div class="cards-grid cards-grid--top-aligned">
        {
          feed.map((entry) =>
            entry.kind === 'post' ? (
              <PostCard
                title={entry.post.data.title}
                date={entry.post.data.date}
                category={entry.post.data.category}
                excerpt={entry.post.data.excerpt}
                authorVersion={entry.post.data.author}
                link={`/blog/${entry.post.slug}`}
              />
            ) : (
              <SeriesCard
                title={seriesTitleBySlug.get(entry.slug) ?? entry.slug}
                slug={entry.slug}
                parts={entry.parts}
                newestSlug={entry.newestSlug}
                isFresh={entry.isFresh}
              />
            ),
          )
        }
      </div>
    </div>
  </section>
</Layout>
