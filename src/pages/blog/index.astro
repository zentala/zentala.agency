---
import Layout from '../../layouts/Layout.astro'
import BlogIndex from '@/components/blog/index/BlogIndex.astro'
import { loadBlogIndexData } from '@/lib/blog/index-data'

const BLOG_DESCRIPTION =
  'Architecture and strategy notes on agent-native tooling, developer experience and information architecture.'
const ARCHIVE_HREF = '/blog/archive'

const data = await loadBlogIndexData()
---

<Layout title="Blog" description={BLOG_DESCRIPTION}>
  <h1 class="sr-only">Blog</h1>
  <BlogIndex data={data} archiveHref={ARCHIVE_HREF} />
</Layout>
