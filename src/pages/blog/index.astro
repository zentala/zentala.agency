---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import PostCard from '../../components/cards/PostCard.astro'

const posts = (await getCollection('blog'))
  .filter(
    (post) =>
      import.meta.env.DEV ||
      import.meta.env.PUBLIC_PREVIEW === 'true' ||
      post.data.published !== false,
  )
  .sort(
    (a, b) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )

const seriesSlugs = [...new Set(posts.map((p) => p.data.series).filter(Boolean))]
---

<Layout title="Blog">
  <section class="section-full">
    <div class="container-bordered">
      {
        seriesSlugs.length > 0 && (
          <div class="padding-responsive-md border-b border-gray-800">
            {seriesSlugs.map((series) => (
              <a
                href={`/series/${series}`}
                class="text-sm text-gray-400 hover:text-white"
              >
                View series: {series} →
              </a>
            ))}
          </div>
        )
      }
      <div class="cards-grid">
        {
          posts.map((post) => (
            <PostCard
              title={post.data.title}
              date={post.data.date}
              category={post.data.category}
              excerpt={post.data.excerpt}
              authorVersion={post.data.author}
              link={`/blog/${post.slug}`}
            />
          ))
        }
      </div>
    </div>
  </section>
</Layout>
