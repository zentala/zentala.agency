---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import PostCta from '../../components/PostCta.astro'
import PostMeta from '../../components/blog/PostMeta.astro'
import PostNav from '../../components/blog/PostNav.astro'
import PostToc from '../../components/blog/PostToc.astro'
import SeriesRail from '../../components/blog/SeriesRail.astro'
import ShareButtons from '../../components/blog/ShareButtons.astro'
import DraftBadge from '../../components/primitives/DraftBadge.astro'
import { SHOW_AUTHOR } from '@/config/blog'
import { partLabel } from '@/lib/blog/part-label'
import { getVisiblePosts } from '@/lib/blog/visibility'

import BlogVersionPanelMount from '../../components/react-stuff/dev/blog-version-panel/BlogVersionPanelMount.astro'

const isDev = import.meta.env.DEV
const RELATED_POST_COUNT = 3
const WORDS_PER_MINUTE = 200
const SITE_URL = 'https://zentala.agency'

export async function getStaticPaths() {
  const posts = await getVisiblePosts()
  return posts.map((post) => ({
    params: { postSlug: post.slug },
  }))
}

const { postSlug } = Astro.params
const visiblePosts = await getVisiblePosts()
const post = visiblePosts.find((p) => p.slug === postSlug)

if (!post) {
  return Astro.redirect('/404')
}

const authorData = (await getCollection('authors'))[0].data
const author = authorData.find((a) => a.slug === post.data.author)
const authorRole = post.data.authorRole || author?.role

if (!author) {
  throw new Error(`Author not found for slug: ${post.data.author}`)
}

const { Content, headings } = await post.render()

// Series siblings, ordered by part number.
const seriesPosts = post.data.series
  ? visiblePosts
      .filter((p) => p.data.series === post.data.series)
      .sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0))
  : []
const visiblePartNumbers = seriesPosts.flatMap((p) =>
  p.data.part === undefined ? [] : [p.data.part],
)
const currentPartLabel =
  post.data.series && post.data.part !== undefined
    ? partLabel(post.data.part, visiblePartNumbers)
    : undefined

// Non-series posts end with other posts from the same category.
const relatedPosts = post.data.series
  ? []
  : visiblePosts
      .filter(
        (p) => p.slug !== post.slug && p.data.category === post.data.category,
      )
      .sort((a, b) => b.data.date.localeCompare(a.data.date))
      .slice(0, RELATED_POST_COUNT)

// Series display title and CTA copy variant.
const seriesDescription = post.data.series
  ? (await getCollection('series-descriptions')).find(
      (entry) => entry.slug === post.data.series,
    )
  : undefined
const ctaVariant = seriesDescription?.data.ctaVariant
const seriesTitle = seriesDescription?.data.title ?? post.data.series ?? ''
const hasSeriesNav = Boolean(post.data.series) && seriesPosts.length > 0

// TOC: only h2 + h3, which keeps it scannable.
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3)

const wordCount = post.body.trim().split(/\s+/).length
const readingMinutes = Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE))

// Share URL is built against the live domain so it works in dev too.
const postUrl = `${SITE_URL}/blog/${post.slug}/`

// SEO: canonical, OG image, and JSON-LD (Article + BreadcrumbList)
const canonicalUrl = postUrl
const ogImageUrl = post.data.imageUrl
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.excerpt,
  ...(post.data.imageUrl ? { image: post.data.imageUrl } : {}),
  datePublished: post.data.date,
}
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Blog',
      item: `${SITE_URL}/blog`,
    },
    { '@type': 'ListItem', position: 2, name: post.data.title, item: postUrl },
  ],
}

// Import banner if exists
let Banner = null
if (post.data.bannerEnd) {
  try {
    Banner = (
      await import(`../../sections/banners/${post.data.bannerEnd}.astro`)
    ).default
  } catch (error) {
    console.error('Banner loading error:', error)
  }
}

const collapsibleClass = 'py-3'
const summaryClass =
  'cursor-pointer text-label uppercase text-fg-secondary hover:text-fg'
---

<Layout
  title={post.data.title}
  description={post.data.excerpt}
  canonical={canonicalUrl}
  ogImage={ogImageUrl}
  ogType="article"
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <!-- HERO BOX (meta + title + excerpt) -->
  <section class="section-full">
    <div class="container-bordered">
      <div class="px-responsive py-responsive-lg relative">
        {post.data.published === false && <DraftBadge />}
        <div class="blog-hero mx-auto flex max-w-6xl flex-col">
          <div class="blog-hero__content">
            {
              SHOW_AUTHOR && (
                <div class="mb-6 flex items-center gap-x-3 text-lg">
                  <img
                    class="h-10 w-10 rounded-full"
                    src={author.avatar}
                    alt={`Avatar of ${author.name}`}
                  />
                  <span class="text-fg">
                    <span class="font-semibold">{author.name}</span>
                    <span class="ml-2 text-fg-muted">{authorRole}</span>
                  </span>
                </div>
              )
            }

            <h1
              class="text-4xl font-light leading-tight text-fg sm:text-5xl lg:text-6xl"
              data-blog-title
            >
              {post.data.title}
            </h1>

            <div class="mt-6">
              <PostMeta
                date={post.data.date}
                category={post.data.category}
                partLabel={currentPartLabel}
                size="sm"
                tone="muted"
              />
            </div>

            <div
              class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-fg-muted xl:hidden"
            >
              <span>{readingMinutes} min read</span>
              <ShareButtons postUrl={postUrl} title={post.data.title} />
            </div>

            {
              post.data.excerpt && (
                <p
                  class="mt-6 text-xl font-light leading-relaxed text-fg-secondary md:text-2xl"
                  data-blog-excerpt
                >
                  {post.data.excerpt}
                </p>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BODY: at xl a line-grid of three cells (left rail | article | right rail), so the
       rail dividers are real cell lines joining the section's top and bottom lines.
       Below xl it is one column and the rails are hidden. -->
  <section class="section-full">
    <div class="container-bordered">
      <div class="line-grid blog-post-grid">
        <aside
          class="blog-aside blog-aside--left py-responsive-md"
          aria-label="Article meta"
        >
          <div class="blog-aside__sticky">
            <a
              href="/blog"
              class="block text-sm font-light text-fg-muted no-underline transition-colors duration-fast ease-standard hover:text-fg"
            >
              ← All posts
            </a>
            <p class="mt-3 text-sm text-fg-subtle">{readingMinutes} min read</p>

            {
              hasSeriesNav && (
                <div class="mt-10">
                  <SeriesRail
                    seriesSlug={post.data.series!}
                    seriesTitle={seriesTitle}
                    posts={seriesPosts}
                    currentSlug={post.slug}
                    currentLabel={currentPartLabel ?? ''}
                  />
                </div>
              )
            }

            <div class="mt-10">
              <p class="mb-3 text-label uppercase text-fg-subtle">Share</p>
              <ShareButtons postUrl={postUrl} title={post.data.title} />
            </div>
          </div>
        </aside>

        <div class="blog-post-grid__article px-responsive py-responsive-md">
          <div class="mx-auto w-full min-w-0 max-w-3xl">
            <!-- Below xl the rails are gone: series and TOC collapse above the article. -->
            {
              (hasSeriesNav || tocHeadings.length > 0) && (
                <div class="mb-6 xl:hidden">
                  {hasSeriesNav && (
                    <details class={collapsibleClass} data-series-details>
                      <summary class={summaryClass}>In this series</summary>
                      <div class="pt-4">
                        <SeriesRail
                          seriesSlug={post.data.series!}
                          seriesTitle={seriesTitle}
                          posts={seriesPosts}
                          currentSlug={post.slug}
                          currentLabel={currentPartLabel ?? ''}
                        />
                      </div>
                    </details>
                  )}
                  {tocHeadings.length > 0 && (
                    <details class={collapsibleClass} data-toc-details>
                      <summary class={summaryClass}>On this page</summary>
                      <div class="pt-4">
                        <PostToc headings={tocHeadings} />
                      </div>
                    </details>
                  )}
                </div>
              )
            }

            <article
              id="post-content"
              class="custom-markdown prose-blog prose w-full max-w-[70ch]"
              style="scroll-margin-top: calc(var(--header-spacer-height) + 24px);"
            >
              <Content />
            </article>
          </div>
        </div>

        <aside class="blog-aside blog-aside--right py-responsive-md">
          <div class="blog-aside__sticky">
            {tocHeadings.length > 0 && <PostToc headings={tocHeadings} />}
          </div>
        </aside>
      </div>
    </div>
  </section>

  <PostNav
    seriesSlug={post.data.series}
    seriesPosts={seriesPosts}
    related={relatedPosts}
    currentSlug={post.slug}
  />

  {
    Banner && (
      <section class="section-full">
        <div class="container-bordered">
          <Banner />
        </div>
      </section>
    )
  }
  {isDev && <BlogVersionPanelMount collection="blog" slug={post.slug} />}
  <section class="section-full">
    <div class="container-bordered">
      <PostCta variant={ctaVariant} />
    </div>
  </section>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // TOC scroll-spy: highlights the heading currently in view
    const article = document.getElementById('post-content')
    const tocLinks = document.querySelectorAll('[data-toc-link]')

    if (article && tocLinks.length) {
      const itemsBySlug = new Map()
      tocLinks.forEach((link) => {
        const slug = link.getAttribute('data-toc-link')
        const item = link.closest('.blog-toc__item')
        if (!slug || !item) return
        itemsBySlug.set(slug, [...(itemsBySlug.get(slug) ?? []), item])
      })

      const headings = article.querySelectorAll('h2[id], h3[id]')
      if (headings.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const items = itemsBySlug.get(entry.target.id)
              if (!items || !entry.isIntersecting) return
              document
                .querySelectorAll('.blog-toc__item.is-active')
                .forEach((el) => el.classList.remove('is-active'))
              items.forEach((item) => item.classList.add('is-active'))
            })
          },
          { rootMargin: '-15% 0px -75% 0px', threshold: 0 },
        )
        headings.forEach((h) => observer.observe(h))
      }
    }

    // Copy-link share button: writes URL to clipboard, briefly toggles icon
    document.querySelectorAll('[data-copy-url]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const url = btn.getAttribute('data-copy-url') || ''
        try {
          await navigator.clipboard.writeText(url)
        } catch {
          const ta = document.createElement('textarea')
          ta.value = url
          ta.style.position = 'fixed'
          ta.style.opacity = '0'
          document.body.appendChild(ta)
          ta.select()
          try {
            document.execCommand('copy')
          } catch {}
          document.body.removeChild(ta)
        }
        btn.classList.add('is-copied')
        setTimeout(() => btn.classList.remove('is-copied'), 1500)
      })
    })
  })
</script>

<style lang="scss">
  /* Smooth in-page scrolling for TOC anchors (page-scoped via :global). */
  :global(html) {
    scroll-behavior: smooth;
  }

  /* Respect users who prefer reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }

  /* Post body = .line-grid of three cells at xl. The cells are static (no hover overlay).
     Below xl it is one column: both rails are hidden and the article fills it. */
  .blog-post-grid {
    --cols-wide: 1;
    --cols-medium: 1;
    --cols-narrow: 1;
  }

  .blog-aside {
    display: none;
  }

  @media (min-width: 1280px) {
    .blog-post-grid {
      --grid-columns: minmax(15rem, 1fr) minmax(0, 54rem) minmax(18rem, 1fr);
    }

    .blog-post-grid > * {
      padding-inline: 2rem;
    }

    .blog-aside {
      display: block;
    }

    /* Rails sit next to the reading column; the cell itself spans the section height. */
    .blog-aside__sticky {
      position: sticky;
      top: calc(var(--header-spacer-height, 0px) + 2.5rem);
      max-height: calc(100vh - var(--header-spacer-height, 0px) - 4rem);
      overflow-y: auto;
    }

    .blog-aside--left .blog-aside__sticky {
      width: 11rem;
      margin-left: auto;
    }

    .blog-aside--right .blog-aside__sticky {
      width: 14rem;
    }
  }
</style>
