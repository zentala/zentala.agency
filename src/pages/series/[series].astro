---
import Layout from '../../layouts/Layout.astro'
import PostCard from '../../components/cards/PostCard.astro'
import PostCta from '../../components/PostCta.astro'
import { getCollection, type CollectionEntry } from 'astro:content'

const isPreview =
  import.meta.env.DEV || import.meta.env.PUBLIC_PREVIEW === 'true'

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(
    (post: CollectionEntry<'blog'>) =>
      post.data.series &&
      (import.meta.env.DEV ||
        import.meta.env.PUBLIC_PREVIEW === 'true' ||
        post.data.published !== false),
  )
  const seriesMap = new Map<string, CollectionEntry<'blog'>[]>()

  posts.forEach((post) => {
    const series = post.data.series as string
    const existing = seriesMap.get(series)
    if (existing) {
      existing.push(post)
    } else {
      seriesMap.set(series, [post])
    }
  })

  return Array.from(seriesMap.entries()).map(([series, seriesPosts]) => ({
    params: { series },
    props: {
      posts: seriesPosts.sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0)),
    },
  }))
}

interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { series } = Astro.params as { series: string }
const { posts } = Astro.props as { posts: CollectionEntry<'blog'>[] }

const descriptions = await getCollection('series-descriptions')
const description = descriptions.find((entry) => entry.slug === series)
const { Content } = description
  ? await description.render()
  : { Content: undefined }

const headline = description?.data.title ?? series

const SITE_URL = 'https://zentala.agency'
const seriesUrl = `${SITE_URL}/series/${series}/`
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: posts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: post.data.title,
    url: `${SITE_URL}/blog/${post.slug}/`,
  })),
}
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Blog', item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 2, name: headline, item: seriesUrl },
  ],
}
---

<Layout
  title={headline}
  canonical={seriesUrl}
  jsonLd={[itemListJsonLd, breadcrumbJsonLd]}
>
  <section class="section-full">
    <div class="container-bordered">
      <div class="padding-responsive-md border-b border-gray-800">
        <h1 class="text-4xl font-light text-white">{headline}</h1>
        {
          description?.data.tagline && (
            <p class="mt-2 text-lg text-gray-400">{description.data.tagline}</p>
          )
        }
        {
          Content ? (
            <div class="mt-4 max-w-none text-gray-300">
              <Content />
            </div>
          ) : (
            <p class="mt-4 max-w-none text-gray-300">
              {posts.length} part{posts.length === 1 ? '' : 's'} in this series.
            </p>
          )
        }
      </div>
      <div class="cards-grid">
        {
          posts.map((post) => {
            const partLabel = post.data.part
              ? `Part ${post.data.part}/${posts.length}`
              : undefined
            return (
              <div class="relative">
                <PostCard
                  title={post.data.title}
                  date={post.data.date}
                  category={post.data.category}
                  imageUrl={post.data.imageUrl}
                  excerpt={post.data.excerpt}
                  authorVersion={post.data.author}
                  link={`/blog/${post.slug}`}
                  partLabel={partLabel}
                />
                {isPreview && post.data.linkedinPost && (
                  <a
                    href={`/linkedin-preview/${post.slug}`}
                    class="relative z-10 mt-2 inline-block rounded-full bg-blue-900/40 px-3 py-1 text-xs text-blue-300 hover:bg-blue-900/60"
                  >
                    LinkedIn draft →
                  </a>
                )}
              </div>
            )
          })
        }
      </div>
    </div>
  </section>
  <section class="section-full">
    <div class="container-bordered">
      <PostCta variant={description?.data.ctaVariant} />
    </div>
  </section>
</Layout>
