---
import Layout from '../../layouts/Layout.astro'
import SeriesParts from '../../components/blog/SeriesParts.astro'
import PostCta from '../../components/PostCta.astro'
import SectionHeader from '../../components/primitives/sections/SectionHeader.astro'
import { getCollection, type CollectionEntry } from 'astro:content'
import { getVisiblePosts } from '@/lib/blog/visibility'

export async function getStaticPaths() {
  const posts = (await getVisiblePosts()).filter(
    (post: CollectionEntry<'blog'>) => post.data.series,
  )
  const seriesMap = new Map<string, CollectionEntry<'blog'>[]>()

  posts.forEach((post) => {
    const series = post.data.series as string
    const existing = seriesMap.get(series)
    if (existing) {
      existing.push(post)
    } else {
      seriesMap.set(series, [post])
    }
  })

  return Array.from(seriesMap.entries()).map(([series, seriesPosts]) => ({
    params: { series },
    props: {
      posts: seriesPosts.sort(
        (a, b) => (a.data.part ?? 0) - (b.data.part ?? 0),
      ),
    },
  }))
}

interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { series } = Astro.params as { series: string }
const { posts } = Astro.props as { posts: CollectionEntry<'blog'>[] }

const descriptions = await getCollection('series-descriptions')
const description = descriptions.find((entry) => entry.slug === series)
const { Content } = description
  ? await description.render()
  : { Content: undefined }

const headline = description?.data.title ?? series

const SITE_URL = 'https://zentala.agency'
const seriesUrl = `${SITE_URL}/series/${series}/`
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: posts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: post.data.title,
    url: `${SITE_URL}/blog/${post.slug}/`,
  })),
}
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Blog',
      item: `${SITE_URL}/blog`,
    },
    { '@type': 'ListItem', position: 2, name: headline, item: seriesUrl },
  ],
}
---

<Layout
  title={headline}
  canonical={seriesUrl}
  jsonLd={[itemListJsonLd, breadcrumbJsonLd]}
>
  <section class="section-full">
    <div class="container-bordered">
      <SectionHeader
        tag="h1"
        eyebrow="Series"
        eyebrowIcon="series"
        headline={headline}
        subhead={description?.data.tagline}
        compact
      >
        {
          Content ? (
            <div class="max-w-[70ch] text-base leading-[1.65] text-fg-secondary [&_p+p]:mt-4">
              <Content />
            </div>
          ) : (
            <p class="max-w-[70ch] text-base leading-[1.65] text-fg-secondary">
              {posts.length} part{posts.length === 1 ? '' : 's'} in this series.
            </p>
          )
        }
      </SectionHeader>
      <SeriesParts parts={posts} />
    </div>
  </section>
  <section class="section-full">
    <div class="container-bordered">
      <PostCta variant={description?.data.ctaVariant} />
    </div>
  </section>
</Layout>
