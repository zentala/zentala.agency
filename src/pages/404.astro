---
import Layout from '../layouts/Layout.astro'
import Button from '../components/Button.astro'
import CardContainer from '../components/cards/CardContainer.astro'

const destinations = [
  { href: '/', title: 'Home', description: 'Return to homepage' },
  {
    href: '/about/capabilities',
    title: 'Capabilities',
    description: 'Areas of expertise',
  },
  { href: '/portfolio', title: 'Portfolio', description: 'See our work' },
  { href: '/blog', title: 'Blog', description: 'Read insights' },
]
---

<Layout
  title="404 - Page Not Found"
  description="Page not found. Explore our services, portfolio, blog, or contact us directly."
>
  <section class="section-full">
    <div class="container-padded py-responsive-lg text-center">
      <div class="mx-auto max-w-4xl">
        <h1 class="mb-8 text-8xl font-light text-fg-muted">404</h1>
        <h2 class="mb-6 text-4xl font-light text-fg">Page Not Found</h2>
        <p class="mb-12 text-xl text-fg-muted">
          The page you're looking for doesn't exist or has been moved.
        </p>
        <Button href="/contact" text="Contact Us" variant="accent" />
      </div>
    </div>
  </section>
  <section class="section-full">
    <div class="container-bordered">
      <div class="line-grid" style="--cols-wide: 4">
        {
          destinations.map(({ href, title, description }) => (
            <CardContainer href={href}>
              <h3 class="mb-2 text-xl font-medium text-fg">{title}</h3>
              <p class="truncate text-sm text-fg-muted">{description}</p>
            </CardContainer>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
