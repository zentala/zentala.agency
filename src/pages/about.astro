---
import Layout from '../layouts/Layout.astro'
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import Hero from '../components/Hero.astro'
import TrustedMe from '../components/TrustedMe.astro'

const heroProps = {
  title: 'About',
  subtitle: '...',
}
---

<Layout
  title="About"
  noindex
  description="Learn more about Paweł Żentała, the founder of Żentała Innovation Agency. Discover the skills, experience, and passion behind the mission to drive innovation."
>
  <Hero {...heroProps} />
  <section class="section-full">
    <div class="container-padded">
      <!-- <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-8">
        :)
      </div> -->
      --- ---

      <section id="about-me" class="my-8">
        <div class="flex items-center space-x-4">
          <img
            src="https://cdn.zentala.agency/images/avatar.jpg"
            alt="Paweł Żentała"
            class="w-32 h-32 rounded-full"
          />
          <div>
            <h2 class="text-3xl font-medium">Paweł Żentała</h2>
            <p class="mt-2">
              Developer, Therapist, Manager with skills in TypeScript, React,
              Redux, DB, architecture, and more.
            </p>
            <div class="mt-4 flex space-x-2">
              <a
                href="https://www.linkedin.com/in/zentala/"
                class="text-accent hover:text-accent-hover"
              >
                <SiteIcon name="linkedin" size="lg" />
              </a>
              <a
                href="https://github.com/zentala"
                class="text-fg-secondary hover:text-fg"
              >
                <SiteIcon name="github" size="lg" />
              </a>
            </div>
          </div>
        </div>
      </section>

      <TrustedMe />

      <section id="skills" class="my-8">
        <h2 class="text-3xl font-medium mb-4">Umiejętności</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          <div class="bg-white p-4 rounded shadow">
            <h3 class="text-xl font-medium">TypeScript</h3>
            <p>Zaawansowane umiejętności w TypeScript</p>
          </div>
          <div class="bg-white p-4 rounded shadow">
            <h3 class="text-xl font-medium">React</h3>
            <p>Doświadczenie w budowaniu interfejsów użytkownika z React</p>
          </div>
          <!-- Dodaj więcej umiejętności w podobnym formacie -->
        </div>
      </section>
      <section>
        <p>1990 - urodziny</p>
        <p>2002 - pierszwe przygody z HTML i Linuxem</p>
        <p>
          2004-2007 - prowadzenie WiFi-Live.pl & administracja WiFi-Forum.pl
        </p>
        <p>2007 - pierwsza komercyjna strona WWW na WordPress</p>
        <p>
          2009 - rozpoczynam pracę jako marketer trenerów i coachów rozwoju
          osobistego
        </p>
        <p>
          2016 - przejscie do korporacji, full time jako developer dla Agecji
          Marketingu jak Hyperedia
        </p>
        <p>2017 - wybieram specjalizacje w kierunku IoT, jako full stack</p>
        <p>
          2017-2018 - rozwijam system do RTLS w dziale R&D francuskiego startupu
        </p>
        <p>2018-2019 - implemenetuje rozwiazzania IoT w Hongkongu</p>
        <p>2020 - buduje prototyp robota mercha do brandstorow</p>
        <p>
          2020-2023 - rozwijam ororgramowanie dla smart home appliaces dla BSH
        </p>
        <p>2023 - zakładam agencje innowacji</p>
      </section>
      <section id="experience" class="my-8">
        <h2 class="text-3xl font-medium mb-4">Doświadczenie</h2>
        <div class="timeline">
          <div class="timeline-item">
            <div class="timeline-content bg-white p-4 rounded shadow">
              <h3 class="text-xl font-medium">Stanowisko</h3>
              <p>Opis doświadczenia i osiągnięć.</p>
            </div>
          </div>
          <!-- Dodaj więcej doświadczeń w podobnym formacie -->
        </div>
      </section>
    </div>
  </section>
</Layout>
