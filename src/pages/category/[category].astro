---
import Layout from '../../layouts/Layout.astro'
import PostCard from '../../components/cards/PostCard.astro'
import { getEntry, type CollectionEntry } from 'astro:content'
import { getVisiblePosts } from '@/lib/blog/visibility'
import { slugify } from '@/lib/blog/slug'

export async function getStaticPaths() {
  const posts = await getVisiblePosts()
  const categoryMap = new Map<
    string,
    { title: string; posts: CollectionEntry<'blog'>[] }
  >()

  posts.forEach((post) => {
    const title = post.data.category
    const slug = slugify(title)
    const existing = categoryMap.get(slug)

    if (existing) {
      existing.posts.push(post)
    } else {
      categoryMap.set(slug, { title, posts: [post] })
    }
  })

  return Array.from(categoryMap.entries()).map(([category, data]) => ({
    params: { category },
    props: {
      posts: data.posts,
      displayTitle: data.title,
    },
  }))
}

interface Props {
  posts: CollectionEntry<'blog'>[]
  displayTitle: string
}

const { category } = Astro.params
const { posts, displayTitle } = Astro.props

// Only some categories have a description file; getEntry returns undefined for the rest.
const categoryDescriptionEntry = await getEntry(
  'category-descriptions',
  category as 'devex',
)

const Content = categoryDescriptionEntry
  ? (await categoryDescriptionEntry.render()).Content
  : undefined
---

<Layout title={displayTitle}>
  <section class="section-full">
    <div class="container-bordered">
      <div class="padding-responsive-md border-b border-line">
        <p class="text-xs uppercase tracking-wide text-fg-subtle">Category</p>
        <h1 class="mt-2 text-4xl font-light text-fg">{displayTitle}</h1>
        {
          Content && (
            <div class="category-description-content prose prose-invert mt-4 max-w-none text-fg-secondary prose-strong:text-fg">
              <Content />
            </div>
          )
        }
      </div>
      <div class="cards-grid line-grid--fill-last">
        {
          posts.map((post) => (
            <PostCard
              title={post.data.title}
              date={post.data.date}
              category={post.data.category}
              imageUrl={post.data.imageUrl}
              excerpt={post.data.excerpt}
              authorVersion={post.data.author}
              link={`/blog/${post.slug}`}
              isDraft={post.data.published === false}
            />
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style lang="postcss" is:global>
  .category-description-content p,
  .category-description-content li {
    @apply text-xl;
  }
</style>
