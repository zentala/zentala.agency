---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import LinkedInPostCard from '../../components/preview/LinkedInPostCard.astro'

export async function getStaticPaths() {
  const isPreview =
    import.meta.env.DEV || import.meta.env.PUBLIC_PREVIEW === 'true'
  if (!isPreview) return []

  const posts = await getCollection('blog')
  const sidecars = await getCollection('linkedin')
  // The `linkedin` collection's generateId (config.ts) already resolves
  // `_<slug>.li.md` to the blog post's own `<slug>`.
  const sidecarBySlug = new Map(sidecars.map((entry) => [entry.id, entry]))

  return posts
    .filter(
      (post) => sidecarBySlug.has(post.slug) || Boolean(post.data.linkedinPost),
    )
    .map((post) => ({
      params: { postSlug: post.slug },
      props: { post, sidecar: sidecarBySlug.get(post.slug) ?? null },
    }))
}

const { post, sidecar } = Astro.props
const authorData = (await getCollection('authors'))[0].data
const author = authorData.find((a) => a.slug === post.data.author)
// Sidecar file (new pattern) wins over the legacy linkedinPost frontmatter
// field, which older posts still carry until they're migrated.
const text = sidecar ? sidecar.body ?? '' : (post.data.linkedinPost ?? '')
---

<Layout title={`LinkedIn preview: ${post.data.title}`}>
  <section class="section-full">
    <div class="container-bordered padding-responsive-md">
      <p class="mb-6 text-sm text-gray-500">
        LinkedIn draft preview — not a live post.
      </p>
      <LinkedInPostCard
        title={post.data.title}
        text={text}
        articleLink={`/blog/${post.slug}`}
        authorName={author?.name ?? post.data.author}
        authorAvatar={author?.avatar ?? ''}
      />
    </div>
  </section>
</Layout>
