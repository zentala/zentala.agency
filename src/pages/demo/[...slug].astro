---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'

/**
 * Component gallery route, dev only. getStaticPaths is empty in a production build and
 * the gallery is imported only under DEV, so no gallery code or CSS reaches dist.
 */
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { slug: undefined } }] : []
}

const GalleryPage = import.meta.env.DEV
  ? ((await import('@/components/demo/GalleryPage.astro')).default as AstroComponentFactory)
  : null
---

{GalleryPage && <GalleryPage />}
