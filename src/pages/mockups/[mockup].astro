---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'
import Layout from '@/layouts/Layout.astro'

/**
 * Dev-only mockups at /mockups/<name>. getStaticPaths returns nothing in a
 * production build, so no mockup ships; an unknown name is a 404.
 * The registry is imported only under DEV, so a production build bundles no
 * mockup component or CSS. The list lives in the registry next to the components.
 */
export async function getStaticPaths() {
  const mockups = import.meta.env.DEV
    ? (await import('@/components/blog/mockups/registry')).MOCKUPS
    : {}
  return Object.keys(mockups).map((mockup) => ({ params: { mockup } }))
}

const { mockup } = Astro.params as { mockup: string }
const registry = import.meta.env.DEV
  ? (await import('@/components/blog/mockups/registry')).MOCKUPS
  : {}
const entry = (registry as Record<string, { title: string; Component: AstroComponentFactory }>)[
  mockup
]
const { title, Component } = entry
---

<Layout title={title} noindex>
  <Component />
</Layout>
