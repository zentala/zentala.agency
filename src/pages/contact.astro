---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import Button from '../components/Button.astro'
import CardContainer from '../components/cards/CardContainer.astro'
import Section from '../components/primitives/sections/Section.astro'
import SectionHeader from '../components/primitives/sections/SectionHeader.astro'
import ContactForm from '../components/ContactForm.astro'

const heroProps = {
  title: 'Contact',
  subtitle: 'I have time for you. Contact me.',
}
---

<Layout
  title="Contact"
  description="Contact Żentała Innovation Agency. Let's talk about your project. I am always ready to help you."
>
  <Hero {...heroProps} />
  <section class="section-full">
    <div class="container-bordered">
      <div class="line-grid">
        <CardContainer hasHover backgroundIcon="message">
          <div class="contact-card__head">
            <h2 class="contact-card__title">Let's Talk</h2>
          </div>
          <p class="contact-card__text">
            Let's discuss your project and explore how we can work together.
          </p>
          <div class="mb-4 flex items-center">
            <img
              src="https://avatars.githubusercontent.com/u/7286123?v=4"
              alt="Paweł Żentała"
              class="mr-4 h-24 w-24 rounded-full"
            />
            <div>
              <h3 class="text-2xl font-medium text-fg">Paweł Żentała</h3>
              <p class="mt-1 text-fg-secondary">
                <a
                  href="mailto:zentala@gmail.com"
                  class="transition-colors duration-fast hover:text-fg"
                  >zentala@gmail.com</a
                >
              </p>
              <a
                href="tel:+48517178984"
                class="text-fg-secondary transition-colors duration-fast hover:text-fg"
                >+48 517 17 89 84</a
              >
            </div>
          </div>
        </CardContainer>

        <CardContainer hasHover backgroundIcon="book-call">
          <div class="contact-card__head">
            <h2 class="contact-card__title">Schedule Meeting</h2>
          </div>
          <p class="contact-card__text">
            Let's discuss your needs in a 20-minute free consultation call.
          </p>
          <Button
            href="http://cal.com/zentala"
            text="Book a Call"
            target="_blank"
            tier="cta"
            icon="book-call"
          />
        </CardContainer>

        <CardContainer hasHover backgroundIcon="linkedin">
          <div class="contact-card__head">
            <h2 class="contact-card__title">Follow Me</h2>
          </div>
          <p class="contact-card__text">
            Connect with me on LinkedIn to stay updated with my latest insights
            and projects.
          </p>
          <Button
            href="https://linkedin.com/in/zentala"
            text="Add on LinkedIn"
            target="_blank"
            tier="secondary"
            icon="linkedin"
          />
        </CardContainer>
      </div>
    </div>
  </section>

  <Section id="write">
    <SectionHeader
      headline="Write to me"
      subhead="Prefer text? Send a message and I will answer within a day or two."
    />
    <ContactForm />
  </Section>
</Layout>

<style>
  /* Owner choice I1 C: contact background icons rest at .1 (hover still caps at .12). */
  :global(.line-grid) {
    --icon-bg-rest-opacity: 0.1;
  }

  .contact-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .contact-card__title {
    font-size: var(--text-h2);
    font-weight: 400;
    color: var(--color-text);
  }

  .contact-card__text {
    margin-bottom: 1.5rem;
    font-size: var(--text-lead);
    color: var(--color-text-secondary);
  }
</style>
