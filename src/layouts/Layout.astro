---
import '../styles/global.scss'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'

interface Props {
  title: string
  description?: string
  /** Absolute canonical URL. Defaults to Astro.site + the current path. */
  canonical?: string
  /** Absolute or site-relative OG/Twitter image. Defaults to the site's OG image. */
  ogImage?: string
  /** OpenGraph type, e.g. "article" for blog posts. Defaults to "website". */
  ogType?: string
  /** One or more JSON-LD objects to emit as <script type="application/ld+json"> tags. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const DEFAULT_OG_IMAGE = '/og-default.png'

const {
  title,
  description = 'Żentała Innovation Agency provides 360° services in implementing cutting-edge technologies, from IoT and automation to bespoke software solutions.',
  canonical,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  jsonLd,
} = Astro.props

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString()
const ogImageUrl = new URL(ogImage, Astro.site).toString()
const jsonLdEntries = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Żentała Innovation Agency" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      jsonLdEntries.map((entry) => (
        <script type="application/ld+json" set:html={JSON.stringify(entry)} />
      ))
    }

    <!-- Preload critical resources -->
    <link
      rel="preload"
      href="https://kit.fontawesome.com/71aeb2a21d.js"
      as="script"
      crossorigin="anonymous"
    />

    <!-- Font loading optimization -->
    <script is:inline>
      // Preload system fonts
      document.head.insertAdjacentHTML(
        'beforeend',
        '<link rel="preload" href="data:font/woff2;base64," as="font" type="font/woff2" crossorigin>',
      )
    </script>

    <script
      src="https://kit.fontawesome.com/71aeb2a21d.js"
      crossorigin="anonymous"
      defer
      is:inline></script>
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Żentała Innovation Agency</title>
  </head>
  <body class="min-h-screen overflow-x-hidden bg-black">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Zentala Chat Widget -->
    <script is:inline src="https://hub.zentala.agency/widget.js?site=zentala.agency"
    ></script>
  </body>
</html>
