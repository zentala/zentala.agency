---
export interface LinkedInPostProps {
  title: string
  text: string
  articleLink: string
  authorName: string
  authorAvatar: string
}

const { title, text, articleLink, authorName, authorAvatar } = Astro.props

const paragraphs = text
  .split('\n')
  .map((line) => line.trim())
  .filter(Boolean)
---

<div class="li-card">
  <div class="li-card__header">
    <img src={authorAvatar} alt={authorName} class="li-card__avatar" />
    <div class="li-card__identity">
      <p class="li-card__name">{authorName}</p>
      <p class="li-card__role">DevEx Consultant · 1st</p>
    </div>
  </div>

  <div class="li-card__body">
    {paragraphs.map((line) => <p>{line}</p>)}
  </div>

  <a href={articleLink} class="li-card__link" aria-label={`Read: ${title}`}>
    <span class="li-card__link-domain">zentala.agency</span>
    <span class="li-card__link-title">{title}</span>
  </a>

  <div class="li-card__stats" aria-hidden="true">
    <span>👍 42</span>
    <span>8 comments</span>
  </div>

  <div class="li-card__actions" aria-hidden="true">
    <span>Like</span>
    <span>Comment</span>
    <span>Share</span>
  </div>
</div>

<style lang="scss">
  .li-card {
    max-width: 34rem;
    margin: 0 auto;
    border: 1px solid rgb(31 41 55); /* gray-800 */
    border-radius: 0.5rem;
    background: rgb(17 24 39); /* gray-900 */
    overflow: hidden;
  }

  .li-card__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem 0.5rem;
  }

  .li-card__avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .li-card__name {
    margin: 0;
    font-weight: 600;
    color: white;
    font-size: 0.9375rem;
  }

  .li-card__role {
    margin: 0;
    font-size: 0.8125rem;
    color: rgb(156 163 175); /* gray-400 */
  }

  .li-card__body {
    padding: 0.5rem 1.25rem 1rem;
    color: rgb(229 231 235); /* gray-200 */
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .li-card__body p {
    margin: 0 0 0.75rem;
  }

  .li-card__body p:last-child {
    margin-bottom: 0;
  }

  .li-card__link {
    display: block;
    margin: 0 1.25rem 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid rgb(31 41 55);
    border-radius: 0.375rem;
    text-decoration: none;
    background: rgb(31 41 55 / 0.4);
    transition: background 200ms ease;
  }

  .li-card__link:hover {
    background: rgb(31 41 55 / 0.7);
  }

  .li-card__link-domain {
    display: block;
    font-size: 0.75rem;
    color: rgb(156 163 175);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .li-card__link-title {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: white;
  }

  .li-card__stats {
    display: flex;
    justify-content: space-between;
    padding: 0 1.25rem 0.5rem;
    font-size: 0.75rem;
    color: rgb(107 114 128); /* gray-500 */
  }

  .li-card__actions {
    display: flex;
    justify-content: space-around;
    padding: 0.5rem 0;
    border-top: 1px solid rgb(31 41 55);
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgb(156 163 175);
  }
</style>
