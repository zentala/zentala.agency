---
export interface Props {
  title: string
  text: string
  articleLink: string
  authorName: string
  authorAvatar: string
}

const { title, text, articleLink, authorName, authorAvatar } = Astro.props

const paragraphs = text
  .split('\n')
  .map((line) => line.trim())
  .filter(Boolean)
---

<div class="li-card">
  <div class="li-card__header">
    <img src={authorAvatar} alt={authorName} class="li-card__avatar" />
    <div class="li-card__identity">
      <p class="li-card__name">{authorName}</p>
      <p class="li-card__role">DevEx Consultant · 1st</p>
    </div>
  </div>

  <div class="li-card__body">
    {paragraphs.map((line) => <p>{line}</p>)}
  </div>

  <a href={articleLink} class="li-card__link" aria-label={`Read: ${title}`}>
    <span class="li-card__link-domain">zentala.agency</span>
    <span class="li-card__link-title">{title}</span>
  </a>

  <div class="li-card__stats" aria-hidden="true">
    <span>Likes: -</span>
    <span>Comments: -</span>
  </div>

  <div class="li-card__actions" aria-hidden="true">
    <span>Like</span>
    <span>Comment</span>
    <span>Share</span>
  </div>
</div>

<style lang="scss">
  .li-card {
    max-width: 34rem;
    margin: 0 auto;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-surface-raised);
    overflow: hidden;
  }

  .li-card__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem 0.5rem;
  }

  .li-card__avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .li-card__name {
    margin: 0;
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.9375rem;
  }

  .li-card__role {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .li-card__body {
    padding: 0.5rem 1.25rem 1rem;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .li-card__body p {
    margin: 0 0 0.75rem;
  }

  .li-card__body p:last-child {
    margin-bottom: 0;
  }

  .li-card__link {
    display: block;
    margin: 0 1.25rem 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.375rem;
    text-decoration: none;
    background: var(--color-surface-hover);
    transition: background-color var(--motion-fast) var(--ease-standard);
  }

  .li-card__link:hover {
    background: var(--color-line);
  }

  .li-card__link-domain {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .li-card__link-title {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .li-card__stats {
    display: flex;
    justify-content: space-between;
    padding: 0 1.25rem 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-subtle);
  }

  .li-card__actions {
    display: flex;
    justify-content: space-around;
    padding: 0.5rem 0;
    border-top: 1px solid var(--color-line);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }
</style>
