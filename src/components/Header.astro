---
/**
 * Site header. From 771 px up it is 88 px high at the top and shrinks to 61 px (bottom
 * line included) once the page scrolls: `data-scrolled` on `<html>` drives the shrink and
 * the spacer keeps the full height, so content never jumps (DESIGN.md, Page header).
 * From 1201 px the menu carries 18 px icons; below 771 px the mobile header is unchanged.
 */
import Logo from '../components/Logo.astro'
import SiteIcon from '@/components/primitives/SiteIcon.astro'
const headerLogoProps = {
  link: '/',
  color: '#fff',
  type: 'full',
  height: '40px',
  width: '200px',
  alt: 'Żentała',
}

const links = [
  { href: '/', text: 'Home', icon: 'home' },
  // { path: '/mission', text: 'Mission' },
  // { path: '/about', text: 'About' },
  { href: '/about/capabilities', text: 'Capabilities', icon: 'capabilities' },
  // { path: '/faq', text: 'FAQ' },
  { href: '/portfolio', text: 'Portfolio', icon: 'portfolio' },
  { href: '/blog', text: 'Blog', icon: 'blog' },
  { href: '/contact', text: 'Contact', icon: 'email' },
] as const

const NAV_ICON_SIZE = 18

const { pathname } = Astro.url
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href)
---

<style lang="scss">
  $header-top: 5.5rem;
  $header-scrolled: 3.8125rem; // 61px, the bottom line included
  $logo-scrolled-scale: 0.8;
  $desktop-from: 771px;
  $icons-from: 1201px; // the nav has room for icons
  $tagline-from: 1400px; // the tagline needs a wider bar still
  $tagline-gap: 2rem;
  $nav-gap: 2rem;

  .tracking-wide {
    letter-spacing: 0.26rem;
  }

  // Animated Hamburger Menu
  .hamburger {
    @apply relative flex h-5 w-7 cursor-pointer flex-col justify-center;
    gap: 4px;

    // Hide on desktop
    @media (min-width: 771px) {
      @apply hidden;
    }

    .line {
      @apply w-full bg-fg transition-[transform,opacity] duration-base ease-standard;
      height: 3px; // Thicker lines
      transform-origin: center;
    }

    &.active {
      .line:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }

      .line:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
      }

      .line:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }
    }
  }

  // Mobile nav overlay
  .mobile-nav-overlay {
    @apply fixed hidden bg-black bg-opacity-80 transition-opacity duration-base;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40; /* Above content but BELOW header (50) and mobile nav (1100) */

    &.active {
      @apply block;
    }

    @media (min-width: 771px) {
      display: none !important; /* Force hide on desktop */
    }
  }

  // Medium desktop nav adjustments
  .desktop-nav {
    a {
      @apply text-fg-muted transition-colors duration-fast;

      // No underline: hover and the current page are a brighter colour
      &:hover,
      &:focus-visible,
      &[aria-current='page'] {
        @apply text-fg;
      }
    }

    // Hide first link (Home) on medium desktop
    @media (min-width: 771px) and (max-width: 999px) {
      a:first-child {
        @apply hidden;
      }
    }
  }

  .desktop-nav :global(.nav-icon) {
    display: none;
  }

  // Shrinking header: 88 px at the top, 61 px once scrolled
  @media (min-width: $desktop-from) {
    .header-spacer {
      height: $header-top;
    }

    .container-header {
      min-height: calc(#{$header-top} - 1px);
      padding-top: 0;
      padding-bottom: 0;
      transition: min-height var(--motion-base) var(--ease-standard);
    }

    .logo-container > :global(div) {
      line-height: 0;
      transform-origin: left center;
      transition: transform var(--motion-base) var(--ease-standard);
    }

    .desktop-nav {
      align-self: center;
      margin-bottom: 0;
    }

    :global(html[data-scrolled]) {
      .container-header {
        min-height: calc(#{$header-scrolled} - 1px);
      }

      .logo-container > :global(div) {
        transform: scale($logo-scrolled-scale);
      }
    }
  }

  // Below this width the tagline would run into the nav
  @media (min-width: $desktop-from) and (max-width: #{$tagline-from - 1px}) {
    .tagline {
      display: none;
    }
  }

  @media (min-width: $icons-from) {
    .tagline {
      margin-left: $tagline-gap;
      white-space: nowrap;
      transition: opacity var(--motion-fast) var(--ease-standard);
    }

    .desktop-nav {
      column-gap: $nav-gap;

      a {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-left: 0;
      }

      :global(.nav-icon) {
        display: block;
      }
    }

    :global(html[data-scrolled]) .tagline {
      opacity: 0;
    }
  }

  // The tagline wraps under the logo on phones and doubles the header height
  @media (max-width: 480px) {
    .tagline {
      display: none;
    }

    // Drop the inline line-box gap under the logo so the header stays at 56px
    .logo-container > :global(div) {
      line-height: 0;
    }
  }

  @media (max-width: 1200px) {
    .logo-container {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .text-lg {
      font-size: 0.82rem;
      margin-left: 0;
      margin-bottom: -4px;
      padding-bottom: 0;
      position: relative;
      top: -4px;
      opacity: 0.5;
    }

    nav {
      align-self: flex-end;
      margin-bottom: 7px;
    }
  }
</style>

<div class="header-spacer bg-black"></div>

<header
  id="header"
  class="fixed top-0 z-50 w-full border-b border-line bg-black bg-opacity-90 backdrop-blur transition-[background-color,border-color,box-shadow] duration-base"
>
  <div class="container-header flex items-center justify-between">
    <div class="logo-container flex items-center">
      <Logo {...headerLogoProps} />
      <a href="/" class="flex cursor-pointer items-center">
        <span
          class="tagline text-md ml-[40px] font-medium uppercase tracking-wide text-fg"
        >
          Innovation Agency
        </span>
      </a>
    </div>
    <!-- Desktop Navigation -->
    <nav class="desktop-nav">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="font-medium uppercase tracking-wide"
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            <SiteIcon name={link.icon} size={NAV_ICON_SIZE} class="nav-icon" />
            {link.text}
          </a>
        ))
      }
    </nav>

    <!-- Mobile Hamburger Button -->
    <button class="mobile-nav-toggle hamburger" id="mobile-toggle">
      <div class="line"></div>
      <div class="line"></div>
      <div class="line"></div>
    </button>
  </div>

  <!-- Mobile Navigation Menu -->
  <div class="mobile-nav" id="mobile-nav">
    <nav>
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.text}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<!-- Mobile Navigation Overlay - Outside header to cover full page -->
<div class="mobile-nav-overlay" id="mobile-overlay"></div>

<style>
  header {
    /* background: #13151a;
        background-size: 224px; */
  }
</style>

<script>
  // Header spacer height now handled by CSS only - no JS needed

  // Mobile navigation toggle
  document.addEventListener('DOMContentLoaded', function () {
    const mobileToggle = document.getElementById('mobile-toggle')
    const mobileNav = document.getElementById('mobile-nav')
    const mobileOverlay = document.getElementById('mobile-overlay')
    const header = document.getElementById('header')

    function updateMobileNavPosition() {
      if (header && mobileNav) {
        const headerHeight = header.offsetHeight
        mobileNav.style.top = `${headerHeight}px`
      }
    }

    function closeMobileNav() {
      if (mobileNav && mobileToggle && mobileOverlay) {
        mobileNav.classList.remove('active')
        mobileToggle.classList.remove('active')
        mobileOverlay.classList.remove('active')
        document.body.classList.remove('mobile-nav-open')
      }
    }

    function openMobileNav() {
      if (mobileNav && mobileToggle && mobileOverlay && header) {
        updateMobileNavPosition()
        const headerHeight = header.offsetHeight
        mobileOverlay.style.top = `${headerHeight}px`
        mobileNav.classList.add('active')
        mobileToggle.classList.add('active')
        mobileOverlay.classList.add('active')
        document.body.classList.add('mobile-nav-open')
      }
    }

    function toggleMobileNav() {
      if (mobileNav) {
        const isActive = mobileNav.classList.contains('active')
        if (isActive) {
          closeMobileNav()
        } else {
          openMobileNav()
        }
      }
    }

    if (mobileToggle && mobileNav) {
      mobileToggle.addEventListener('click', toggleMobileNav)

      // Close mobile nav when clicking on a link
      const mobileLinks = mobileNav.querySelectorAll('a')
      mobileLinks.forEach((link) => {
        link.addEventListener('click', closeMobileNav)
      })

      // Close mobile nav when clicking on overlay
      if (mobileOverlay) {
        mobileOverlay.addEventListener('click', closeMobileNav)
      }

      // Close mobile nav when clicking outside
      document.addEventListener('click', function (e) {
        const target = e.target as HTMLElement
        if (
          target &&
          !mobileToggle.contains(target) &&
          !mobileNav.contains(target)
        ) {
          closeMobileNav()
        }
      })

      // Close mobile nav when resizing to desktop view + update position on resize
      window.addEventListener('resize', function () {
        if (window.innerWidth >= 771) {
          closeMobileNav()
        } else {
          updateMobileNavPosition()
        }
      })

      // Update position on initial load
      updateMobileNavPosition()
    }
  })
</script>

<script>
  const siteHeader = document.getElementById('header')
  const root = document.documentElement
  const DESKTOP_FROM_PX = 771
  const DESKTOP_SPACER_PX = 88
  const SCROLLED_AFTER_PX = 24

  // Scroll flag: the shrink of the desktop header reads it from <html>
  const syncScrolled = () =>
    root.toggleAttribute('data-scrolled', window.scrollY > SCROLLED_AFTER_PX)
  window.addEventListener('scroll', syncScrolled, { passive: true })
  syncScrolled()

  // The spacer var is the full desktop height at any scroll position (no shift);
  // below the desktop width the header height varies, so it follows the real height
  if (siteHeader) {
    const syncSpacer = () => {
      const height =
        window.innerWidth >= DESKTOP_FROM_PX ? DESKTOP_SPACER_PX : siteHeader.offsetHeight
      root.style.setProperty('--header-spacer-height', `${height}px`)
    }
    new ResizeObserver(syncSpacer).observe(siteHeader)
    window.addEventListener('resize', syncSpacer)
    syncSpacer()
  }
</script>
