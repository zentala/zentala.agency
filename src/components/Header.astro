---
import Logo from '../components/Logo.astro'
const headerLogoProps = {
  link: '/',
  color: '#fff',
  type: 'full',
  height: '40px',
  width: '200px',
  alt: 'Żentała',
}

const links = [
  { href: '/', text: 'Home' },
  // { path: '/mission', text: 'Mission' },
  // { path: '/about', text: 'About' },
  { href: '/about/capabilities', text: 'Capabilities' },
  // { path: '/faq', text: 'FAQ' },
  { href: '/portfolio', text: 'Portfolio' },
  { href: '/blog', text: 'Blog' },
  { href: '/contact', text: 'Contact' },
]
---

<style lang="scss">
  #header {
    container: site-header / inline-size;
  }

  .logo-container {
    flex: 0 1 auto;
    min-width: 0;
    white-space: nowrap;
  }

  .desktop-nav {
    flex-shrink: 0;
  }

  .tracking-wide {
    letter-spacing: 0.26rem;
  }

  // Animated Hamburger Menu
  .hamburger {
    @apply relative flex h-5 w-7 cursor-pointer flex-col justify-center;
    gap: 4px;

    display: none;

    .line {
      @apply w-full bg-white transition-all duration-300 ease-in-out;
      height: 3px; // Thicker lines
      transform-origin: center;
    }

    &.active {
      .line:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }

      .line:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
      }

      .line:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }
    }
  }

  // Mobile nav overlay
  .mobile-nav-overlay {
    @apply fixed hidden bg-black bg-opacity-80 transition-opacity duration-300;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40; /* Above content but BELOW header (50) and mobile nav (1100) */

    &.active {
      @apply block;
    }
  }

  @container site-header (width < 1180px) {
    .desktop-nav {
      display: none;
    }
    .hamburger {
      display: flex;
      flex-shrink: 0;
    }
    .mobile-nav.active {
      display: block !important;
    }
  }

  @container site-header (width < 600px) {
    .agency-descriptor {
      display: none;
    }
  }

  @container site-header (width >= 1180px) {
    .mobile-nav {
      display: none !important;
    }
  }
</style>

<div class="header-spacer bg-black"></div>

<header
  id="header"
  class="fixed top-0 z-50 w-full border-b border-gray-800 bg-black bg-opacity-90 shadow-md backdrop-blur transition-all duration-300"
>
  <div class="container-header flex items-center justify-between">
    <div class="logo-container flex items-center">
      <Logo {...headerLogoProps} />
      <a href="/" class="flex cursor-pointer items-center">
        <span
          class="agency-descriptor text-md ml-[40px] font-medium uppercase tracking-wide text-white"
        >
          Innovation Agency
        </span>
      </a>
    </div>
    <!-- Desktop Navigation -->
    <nav class="desktop-nav">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="font-medium uppercase tracking-wide text-white hover:text-gray-400"
          >
            {link.text}
          </a>
        ))
      }
    </nav>

    <!-- Mobile Hamburger Button -->
    <button
      class="mobile-nav-toggle hamburger"
      id="mobile-toggle"
      aria-label="Toggle navigation"
      aria-controls="mobile-nav"
      aria-expanded="false"
    >
      <div class="line"></div>
      <div class="line"></div>
      <div class="line"></div>
    </button>
  </div>

  <!-- Mobile Navigation Menu -->
  <div class="mobile-nav" id="mobile-nav">
    <nav>
      {
        links.map((link) => (
          <a
            href={link.href}
            class="border-b border-gray-800 py-2 font-medium uppercase tracking-wide text-white hover:text-gray-400"
          >
            {link.text}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<!-- Mobile Navigation Overlay - Outside header to cover full page -->
<div class="mobile-nav-overlay" id="mobile-overlay"></div>

<style>
  header {
    /* background: #13151a;
        background-size: 224px; */
  }
</style>

<script>
  // One module-wide listener set. Resolve the current DOM after every swap.
  function closeMobileNav() {
    document.getElementById('mobile-nav')?.classList.remove('active')
    document.getElementById('mobile-toggle')?.classList.remove('active')
    document
      .getElementById('mobile-toggle')
      ?.setAttribute('aria-expanded', 'false')
    document.getElementById('mobile-overlay')?.classList.remove('active')
    document.body.classList.remove('mobile-nav-open')
  }

  function updateMobileNavPosition() {
    const header = document.getElementById('header')
    const nav = document.getElementById('mobile-nav')
    const overlay = document.getElementById('mobile-overlay')
    if (!header || !nav || !overlay) return
    nav.style.top = overlay.style.top = `${header.offsetHeight}px`
    if (header.clientWidth >= 1180) closeMobileNav()
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement
    const toggle = document.getElementById('mobile-toggle')
    const nav = document.getElementById('mobile-nav')
    if (toggle?.contains(target)) {
      const opening = !nav?.classList.contains('active')
      closeMobileNav()
      if (opening) {
        updateMobileNavPosition()
        nav?.classList.add('active')
        toggle.classList.add('active')
        toggle.setAttribute('aria-expanded', 'true')
        document.getElementById('mobile-overlay')?.classList.add('active')
        document.body.classList.add('mobile-nav-open')
      }
    } else if (!nav?.contains(target) || target.closest('a')) {
      closeMobileNav()
    }
  })
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMobileNav()
  })
  window.addEventListener('resize', updateMobileNavPosition)
  let headerObserver: ResizeObserver | undefined
  document.addEventListener('astro:before-swap', () => {
    headerObserver?.disconnect()
    headerObserver = undefined
    closeMobileNav()
  })
  document.addEventListener('astro:page-load', () => {
    updateMobileNavPosition()
    const header = document.getElementById('header')
    if (header) {
      headerObserver = new ResizeObserver(updateMobileNavPosition)
      headerObserver.observe(header)
    }
  })
</script>
