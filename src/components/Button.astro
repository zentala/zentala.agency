---
import { Icon } from 'astro-icon/components'

interface Props {
  href: string
  text: string
  target?: string
  /** primary: solid white. secondary: outlined. accent: solid blue, one main action per page. */
  variant?: 'primary' | 'secondary' | 'accent'
  icon?: string // Lucide icon name from astro-icon (left icon)
  arrow?: boolean // Show arrow on right (default true)
}

const { href, text, target, variant = 'primary', icon, arrow = true } = Astro.props

// Every variant has a 1px border so buttons in one row have equal height.
const baseClasses =
  'inline-flex items-center justify-center border px-8 py-3 font-semibold transition-colors duration-fast ease-standard focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white'

const variantClasses = {
  primary: 'border-white bg-white text-surface hover:border-fg-secondary hover:bg-fg-secondary',
  secondary: 'border-line-strong text-fg hover:bg-surface-hover',
  accent:
    'border-accent-solid bg-accent-solid text-fg hover:border-accent hover:bg-accent-solid',
} as const

const buttonClasses = `${baseClasses} ${variantClasses[variant]}`
---

<a href={href} target={target} class={buttonClasses}>
  {icon && <Icon name={`lucide:${icon}`} class="mr-2 h-5 w-5" style="stroke-width: 1.5;" />}
  <span>{text}</span>
  {arrow && <Icon name="lucide:chevron-right" class="ml-2 h-4 w-4" style="stroke-width: 2;" />}
</a>
