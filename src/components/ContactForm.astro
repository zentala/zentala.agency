---
/**
 * ContactForm - the contact fields as cells of one line grid (DESIGN.md P8, F1-B).
 * Fields share lines, have no radius, no container border and no inner padding; the
 * grid draws the vertical line between the two columns. The last row is `FormFoot`.
 * The dev "Formularz" axis switches to variant C (horizontal lines only).
 */
import ThemedInput from './ThemedInput.astro'
import ThemedTextarea from './ThemedTextarea.astro'
import FormFoot from './FormFoot.astro'

// NOTE(intent): placeholder copy, to be confirmed by the owner (DESIGN.md section 5, Forms).
const PRIVACY_NOTE = 'I use your details only to answer you. No newsletter, no sharing.'
---

<form class="line-grid contact-form" action="mailto:zentala@gmail.com" method="post" enctype="text/plain">
  <ThemedInput type="text" id="fName" placeholder="First name" icon="person" required />
  <ThemedInput type="text" id="lName" placeholder="Last name" icon="person" />
  <ThemedInput type="email" id="email" placeholder="Email" icon="email" required />
  <ThemedInput type="tel" id="phone" placeholder="Phone" icon="phone" />
  <ThemedTextarea id="msg" placeholder="Your message" icon="message" />
  <FormFoot note={PRIVACY_NOTE} />
</form>

<style lang="scss">
  .contact-form {
    --cols-wide: 2;
    --cols-medium: 2;
    --cols-narrow: 1;
  }

  /* The message and the last row span both columns */
  .contact-form > :global(:nth-child(5)),
  .contact-form > :global(:nth-child(6)) {
    grid-column: 1 / -1;
  }
</style>
