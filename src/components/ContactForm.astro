---
/**
 * ContactForm - the contact fields as cells of one line grid.
 * Fields share lines, have no radius and no container border. Submit is a cell holding a primary-tier `Button`.
 */
import ThemedInput from './ThemedInput.astro'
import ThemedTextarea from './ThemedTextarea.astro'
import Button from './Button.astro'
---

<form class="line-grid contact-form" action="mailto:zentala@gmail.com" method="post" enctype="text/plain">
  <ThemedInput type="text" id="fName" placeholder="First name" icon="person" required />
  <ThemedInput type="text" id="lName" placeholder="Last name" icon="person" />
  <ThemedInput type="email" id="email" placeholder="Email" icon="email" required />
  <ThemedInput type="tel" id="phone" placeholder="Phone" icon="phone" />
  <ThemedTextarea id="msg" placeholder="Your message" icon="message" />
  <div class="contact-form__submit">
    <Button type="submit" tier="primary" text="Send message" />
  </div>
</form>

<style lang="scss">
  @use '../styles/variables' as *;

  .contact-form {
    --cols-wide: 2;
    --cols-medium: 2;
    --cols-narrow: 1;
  }

  /* The message and the submit cell span both columns */
  .contact-form > :global(:nth-child(5)),
  .contact-form > :global(:nth-child(6)) {
    grid-column: 1 / -1;
  }

  .contact-form__submit {
    display: flex;
    justify-content: flex-end;
    padding: 0.5rem 1.25rem;
  }
</style>
