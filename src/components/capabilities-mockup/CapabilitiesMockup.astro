---
/**
 * Dev-only sketch of a rebuilt /capabilities under one umbrella, product
 * engineering (/mockups/capabilities). The real page is untouched; this is a
 * backlog idea for the owner to react to. Order: owner note, header with the
 * name question N1, what you get, the T-shape question T1 (options A and B),
 * the six areas that replace the 18 cards, one call to action.
 */
import BoardQuestion from '@/components/design-board/blog-index/BoardQuestion.astro'
import OptionBar from '@/components/design-board/blog-index/OptionBar.astro'
import OwnerNote from './OwnerNote.astro'
import CapHero from './CapHero.astro'
import NameOptions from './NameOptions.astro'
import Outcomes from './Outcomes.astro'
import TShapeLiteral from './TShapeLiteral.astro'
import TShapeHalves from './TShapeHalves.astro'
import Areas from './Areas.astro'
import CapCta from './CapCta.astro'
import { NAME_OPTIONS, T1, T1_OPTIONS } from './notes'

const recommendedName =
  NAME_OPTIONS.find((option) => option.recommended)?.name ?? NAME_OPTIONS[0].name
const [optionA, optionB] = T1_OPTIONS
---

<OwnerNote />
<CapHero name={recommendedName} />
<NameOptions current={recommendedName} />
<Outcomes />

<BoardQuestion {...T1} />
<OptionBar questionId={T1.id} {...optionA} />
<TShapeLiteral />
<OptionBar questionId={T1.id} {...optionB} />
<TShapeHalves />

<Areas />
<CapCta />
