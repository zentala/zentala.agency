---
/**
 * One depth layer of the T-shape: the layer name, its technology logos
 * (TechIcon, monochrome) and the tool names in text, so the logos are never the
 * only label. The dev-only marker follows a detail the owner has not confirmed.
 */
import Tag from '@/components/primitives/Tag.astro'
import TechIcon from '@/components/primitives/TechIcon.astro'
import type { StackLayer } from './copy'
import { CONFIRM_LABEL } from './notes'

type Props = StackLayer

const { name, logos, detail, unconfirmed } = Astro.props
---

<div class="stack-item">
  <h3 class="stack-item__name">{name}</h3>
  <p class="stack-item__logos">
    {logos.map((logo) => <TechIcon name={logo} size="md" />)}
  </p>
  <p class="stack-item__detail">{detail}</p>
  {
    unconfirmed && (
      <p class="stack-item__confirm">
        <Tag theme="label" text={CONFIRM_LABEL} />
      </p>
    )
  }
</div>

<style>
  .stack-item__name {
    color: var(--color-text);
    font-size: var(--text-lead);
    font-weight: 400;
    line-height: 1.35;
  }

  .stack-item__logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
    color: var(--color-text-muted);
  }

  .stack-item__detail {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .stack-item__confirm {
    margin-top: 0.75rem;
  }
</style>
