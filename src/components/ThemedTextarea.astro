---
/** ThemedTextarea - ThemedInput as a multi-line field; `size="large"` for a tall one. */
import ThemedInput from './ThemedInput.astro'

interface Props {
  id?: string
  name?: string
  placeholder?: string // the label text
  icon?: string
  size?: 'default' | 'large'
  required?: boolean
  disabled?: boolean
  error?: string
}

const props = Astro.props
---

<ThemedInput {...props} multiline />
