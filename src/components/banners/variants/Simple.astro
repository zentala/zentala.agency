---
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import type { BannerProps } from '../types'

interface SimpleBannerProps {
  title: string
  description: string
  linkText: string
  linkHref: string
  class?: string
}

const {
  title,
  description,
  linkText,
  linkHref,
  class: className = '',
} = Astro.props
---

<!-- Full banner is clickable (like cards) -->
<a href={linkHref} class={`banner banner-simple ${className}`}>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="banner-link" aria-hidden="true">
    {linkText}
    <SiteIcon name="caret-right" size="sm" class="arrow-nudge" />
  </span>
</a>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .banner-simple {
    @include line-block;
    @include cell-interactive;
    @include padding-responsive('md'); // 64px → 48px → 32px → 24px → 16px
    width: 100%;
    display: block;
    cursor: pointer;
    text-decoration: none;

    h3 {
      @apply mb-4 font-light text-fg;
      font-size: 2rem; // text-3xl
      line-height: 1.2;

      @include tablet {
        font-size: 1.75rem; // text-2xl
      }

      @include mobile {
        font-size: 1.5rem; // text-xl
      }
    }

    p {
      @apply mb-6 text-fg-secondary;
      font-size: 1.25rem; // text-xl
      line-height: 1.6;

      @include tablet {
        font-size: 1.125rem; // text-lg
      }

      @include mobile {
        font-size: 1rem; // text-base
      }
    }

    .banner-link {
      @apply inline-flex items-center gap-1 text-fg transition-colors duration-fast ease-standard;
      font-size: 1.125rem; // text-lg

      @include tablet {
        font-size: 1rem; // text-base
      }

      @include mobile {
        font-size: 0.875rem; // text-sm
      }

      &:hover {
        @apply text-fg-secondary;
      }
    }
  }

  /**
   * Full-bleed behavior inside padded containers:
   * container-padded adds responsive padding around content; this removes it only for the banner
   * so borders align with the grid/container borders.
   */
  :global(.container-padded) .banner-simple {
    /* Full-bleed inside container-padded without relying on margins (more deterministic). */
    left: calc(var(--container-padded-padding) * -1);
    width: calc(100% + (var(--container-padded-padding) * 2));
  }

  /* Remove container padding above/below when the banner is flush to the edges (first/last). */
  :global(.container-padded > .banner-simple:first-child) {
    margin-top: calc(var(--container-padded-padding) * -1 - 1px);
  }

  :global(.container-padded > .banner-simple:last-child) {
    margin-bottom: calc(var(--container-padded-padding) * -1);
  }
</style>
