---
/**
 * One group of the decision board, dev only: a Section whose line-grid holds, per decision,
 * the decision cell and a note field cell (ThemedTextarea, a form cell of the same grid).
 */
import Section from '@/components/primitives/sections/Section.astro'
import SectionHeader from '@/components/primitives/sections/SectionHeader.astro'
import ThemedTextarea from '@/components/ThemedTextarea.astro'
import DecisionCard from '@/components/admin/DecisionCard.astro'
import type { SavedAnswer } from '@/lib/admin/answers'
import type { DecideItem } from '@/lib/admin/decide'

export interface Props {
  name: string
  items: DecideItem[]
  answers: Map<string, SavedAnswer>
  answered: number
}

const { name, items, answers, answered } = Astro.props
---

<Section>
  <SectionHeader
    headline={name}
    subhead={`${items.length} do podjęcia, z odpowiedzią: ${answered}`}
  />
  <div class="line-grid" style="--cols-wide: 1; --cols-medium: 1; --cols-narrow: 1">
    {
      items.map((item) => (
        <>
          <DecisionCard item={item} saved={answers.get(item.id)} />
          <ThemedTextarea
            id={`note-${item.id}`}
            placeholder={`Notatka do ${item.id} (opcjonalnie)`}
            icon="chat-text"
          />
        </>
      ))
    }
  </div>
</Section>
