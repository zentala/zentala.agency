---
/**
 * The cells of one decision, dev only: the decision card and its note field (ThemedTextarea),
 * two cells of the surrounding line-grid. Used by the groups and by the collapsed deferred list.
 */
import ThemedTextarea from '@/components/ThemedTextarea.astro'
import DecisionCard from '@/components/admin/DecisionCard.astro'
import type { SavedAnswer } from '@/lib/admin/answers'
import type { DecideItem } from '@/lib/admin/decide'

export interface Props {
  item: DecideItem
  saved?: SavedAnswer
}

const { item, saved } = Astro.props
---

<DecisionCard item={item} saved={saved} />
<ThemedTextarea
  id={`note-${item.id}`}
  placeholder={`Notatka do ${item.id} (opcjonalnie)`}
  icon="chat-text"
/>
