---
/**
 * Decision board, dev only (/admin/decisions): the owner's open questions from the private
 * plan's DECIDE.md as an infographic. Summary, one section per group, decision cards with
 * options as radio cells, a sticky bar to save (POST /__admin/answers, a dev middleware) or
 * copy the answers as text. Nothing is preselected and nothing is sent until the owner clicks.
 * Lines that cannot be parsed are listed at the bottom so nothing is hidden.
 */
import Layout from '@/layouts/Layout.astro'
import Hero from '@/components/Hero.astro'
import Button from '@/components/Button.astro'
import Section from '@/components/primitives/sections/Section.astro'
import SectionHeader from '@/components/primitives/sections/SectionHeader.astro'
import DecisionCard from '@/components/admin/DecisionCard.astro'
import DecisionGroup from '@/components/admin/DecisionGroup.astro'
import { readAnswers } from '@/lib/admin/answers'
import { buildBoard } from '@/lib/admin/board'
import { readDecideFile } from '@/lib/admin/decide-file'
import { resolvePlanDir } from '@/lib/admin/plan-dir'

const planDir = resolvePlanDir()
const decide = readDecideFile(planDir)
const answers = readAnswers(planDir)
const board = buildBoard(decide.items, answers)
const answerById = new Map(answers.map((answer) => [answer.id, answer]))
const fileDate = decide.modifiedAt
  ? new Date(decide.modifiedAt).toLocaleString('pl-PL', { dateStyle: 'medium', timeStyle: 'short' })
  : ''
---

<Layout title="Decyzje do podjęcia" description="Pytania do właściciela. Tylko dev." noindex>
  <Hero
    eyebrow="Tylko dev"
    title="Decyzje do podjęcia"
    subtitle={decide.missing
      ? 'Brak pliku DECIDE.md'
      : `${board.openCount} otwartych, ${board.answeredCount} z odpowiedzią`}
  />

  {
    decide.missing ? (
      <Section id="missing">
        <div class="line-grid" style="--cols-wide: 1; --cols-medium: 1; --cols-narrow: 1">
          <div class="content-grid__text">
            <p class="text-fg-secondary">
              Nie znaleziono pliku z decyzjami. Szukałem w <code>{decide.path}</code>. Ustaw{' '}
              <code>ADMIN_PLAN_DIR</code> na folder planu albo utwórz w nim DECIDE.md.
            </p>
          </div>
        </div>
      </Section>
    ) : (
      <div class="admin-board">
        <div class="admin-content">
        <Section id="summary">
          <div class="line-grid line-grid--fill-last">
            <div class="content-grid__text">
              <p class="figure">{board.openCount}</p>
              <p class="label">Otwarte pytania</p>
            </div>
            <div class="content-grid__text">
              <p class="figure">{board.answeredCount}</p>
              <p class="label">Z zapisaną odpowiedzią</p>
            </div>
            <div class="content-grid__text">
              <p class="label">DECIDE.md zmieniony</p>
              <p class="text-fg-secondary">{fileDate}</p>
            </div>
            {board.groups.map((group) => (
              <div class="content-grid__text">
                <p class="figure">{group.items.length}</p>
                <p class="label">{group.name}</p>
              </div>
            ))}
          </div>
        </Section>

        {board.groups.map((group) => (
          <DecisionGroup
            name={group.name}
            items={group.items}
            answers={answerById}
            answered={group.answered}
          />
        ))}

        {board.deferred.length > 0 && (
          <Section id="deferred">
            <details class="deferred">
              <summary class="deferred__summary">Na później ({board.deferred.length})</summary>
              <div class="line-grid" style="--cols-wide: 1; --cols-medium: 1; --cols-narrow: 1">
                {board.deferred.map((item) => (
                  <DecisionCard item={item} saved={answerById.get(item.id)} />
                ))}
              </div>
            </details>
          </Section>
        )}

        {decide.errors.length > 0 && (
          <Section id="unreadable">
            <SectionHeader
              headline="Nie udało się odczytać"
              subhead="Te linie z DECIDE.md mają błąd formatu. Są pokazane tak, jak stoją w pliku."
            />
            <div class="line-grid" style="--cols-wide: 1; --cols-medium: 1; --cols-narrow: 1">
              {decide.errors.map((error) => (
                <div class="content-grid__text">
                  <p class="label">linia {error.line}: {error.error}</p>
                  <p class="raw">{error.raw}</p>
                </div>
              ))}
            </div>
          </Section>
        )}

        </div>

        <div class="admin-bar-wrap">
          <div class="container-bordered">
            <div class="admin-bar">
              <p class="admin-bar__status" data-board-status role="status" aria-live="polite" />
              <div class="admin-bar__fallback" data-copy-fallback hidden>
                <p class="admin-bar__hint">Schowek jest zablokowany na tym adresie. Tekst jest zaznaczony: naciśnij Ctrl+C.</p>
                <textarea class="admin-bar__text" data-copy-text readonly rows="4" aria-label="Odpowiedzi jako tekst"></textarea>
              </div>
              <div class="admin-bar__buttons">
                <div data-action="save">
                  <Button type="button" text="Zapisz" variant="primary" icon="save" arrow={false} />
                </div>
                <div data-action="copy">
                  <Button type="button" text="Kopiuj" variant="secondary" icon="copy" arrow={false} />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    )
  }
</Layout>

<script>
  import { formatAnswerLine, NOTE_ONLY_LABEL } from '@/lib/admin/answer-text'

  const ENDPOINT = '/__admin/answers'

  interface Entry {
    card: HTMLElement
    id: string
    choice: string | null
    note: string
  }

  const status = document.querySelector<HTMLElement>('[data-board-status]')
  const say = (text: string) => {
    if (status) status.textContent = text
  }

  const entries = (): Entry[] =>
    [...document.querySelectorAll<HTMLElement>('[data-decision-id]')].flatMap((card) => {
      const id = card.dataset.decisionId ?? ''
      const choice = card.querySelector<HTMLInputElement>('input[type="radio"]:checked')?.value
      const note = document.querySelector<HTMLTextAreaElement>(`textarea[name="note-${id}"]`)?.value ?? ''
      const trimmed = note.trim()
      return choice || trimmed ? [{ card, id, choice: choice ?? null, note: trimmed }] : []
    })

  const isChanged = ({ card, choice, note }: Entry) =>
    (choice ?? '') !== (card.dataset.savedChoice ?? '') || note !== (card.dataset.savedNote ?? '')

  const clock = () => new Date().toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' })

  async function save() {
    const changed = entries().filter(isChanged)
    if (changed.length === 0) return say('Nic nowego do zapisania: wybierz opcję albo wpisz notatkę.')
    say('Zapisuję…')
    try {
      const response = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ answers: changed.map(({ id, choice, note }) => ({ id, choice, note })) }),
      })
      const result = (await response.json()) as { ok: boolean; saved?: number; error?: string }
      if (!response.ok || !result.ok) return say(`Nie zapisano: ${result.error ?? response.status}`)
      const time = clock()
      for (const { card, choice, note } of changed) {
        card.dataset.savedChoice = choice ?? ''
        card.dataset.savedNote = note
        const mark = card.querySelector('[data-status]')
        if (mark) mark.textContent = `wysłano: ${choice ?? NOTE_ONLY_LABEL}, ${time}`
      }
      say(`Zapisano ${result.saved}: ${changed.map(({ id, choice }) => `${id} ${choice ?? NOTE_ONLY_LABEL}`).join(', ')}`)
    } catch {
      say('Nie zapisano: serwer deweloperski nie odpowiada.')
    }
  }

  const fallback = document.querySelector<HTMLElement>('[data-copy-fallback]')
  const fallbackText = document.querySelector<HTMLTextAreaElement>('[data-copy-text]')

  /**
   * execCommand copy from an off-screen textarea: works on plain http, where navigator.clipboard
   * is undefined. True only when the command returned true and a copy event actually fired.
   */
  function copyWithSelection(text: string): boolean {
    const area = document.createElement('textarea')
    area.value = text
    area.setAttribute('readonly', '')
    area.style.cssText = 'position:fixed;top:0;left:-9999px;opacity:0'
    document.body.append(area)
    area.focus()
    area.setSelectionRange(0, text.length)
    let copyEventFired = false
    const onCopy = () => {
      copyEventFired = true
    }
    document.addEventListener('copy', onCopy, { once: true })
    try {
      return document.execCommand('copy') && copyEventFired
    } catch {
      return false
    } finally {
      document.removeEventListener('copy', onCopy)
      area.remove()
    }
  }

  /** Last resort: the text in a visible read-only field, pre-selected for Ctrl+C. */
  function showManually(text: string) {
    if (!fallback || !fallbackText) return say('Nie udało się skopiować. Odpowiedzi:\n' + text)
    fallbackText.value = text
    fallbackText.rows = Math.min(text.split('\n').length + 1, 10)
    fallback.hidden = false
    fallbackText.focus()
    fallbackText.select()
  }

  async function copy() {
    const all = entries()
    if (all.length === 0) return say('Nic do skopiowania: wybierz opcję albo wpisz notatkę.')
    const text = all.map(({ id, choice, note }) => formatAnswerLine(id, choice, note)).join('\n')
    if (fallback) fallback.hidden = true
    let copied = false
    if (window.isSecureContext && navigator.clipboard) {
      try {
        await navigator.clipboard.writeText(text)
        copied = true
      } catch {
        copied = false
      }
    }
    if (!copied) copied = copyWithSelection(text)
    if (copied) return say(`Skopiowano ${all.length} odpowiedzi.`)
    say('Schowek niedostępny: skopiuj tekst ręcznie.')
    showManually(text)
  }

  /** Marks cards whose choice or note differs from the saved state ("zmieniona"). */
  function markChanged() {
    const changed = new Set(entries().filter(isChanged).map(({ id }) => id))
    document.querySelectorAll<HTMLElement>('[data-decision-id]').forEach((card) => {
      card.toggleAttribute('data-changed', changed.has(card.dataset.decisionId ?? ''))
    })
  }

  const noteField = (card: HTMLElement) => card.querySelector<HTMLTextAreaElement>('textarea')

  function openNote(card: HTMLElement, focus: boolean) {
    const note = card.querySelector<HTMLElement>('[data-note]')
    const toggle = card.querySelector<HTMLElement>('[data-note-toggle]')
    if (note) note.hidden = false
    if (toggle) toggle.hidden = true
    if (focus) noteField(card)?.focus()
  }

  /** A note with content is always visible: a draft the browser restored after a reload counts. */
  function openFilledNotes() {
    document.querySelectorAll<HTMLElement>('[data-decision-id]').forEach((card) => {
      if (noteField(card)?.value.trim()) openNote(card, false)
    })
    markChanged()
  }

  document.querySelectorAll<HTMLElement>('[data-note-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const card = toggle.closest<HTMLElement>('[data-decision-id]')
      if (card) openNote(card, true)
    })
  })
  openFilledNotes()
  window.addEventListener('pageshow', openFilledNotes)

  document.addEventListener('input', markChanged)
  document.addEventListener('change', markChanged)
  document.querySelector('[data-action="save"]')?.addEventListener('click', () => void save().then(markChanged))
  document.querySelector('[data-action="copy"]')?.addEventListener('click', () => void copy())
</script>

<style lang="scss">
  @use '../../styles/variables' as *;

  .figure {
    @apply text-3xl font-light text-fg;
  }

  .label {
    @apply text-sm text-fg-muted;
  }

  .raw {
    @apply text-sm text-fg-secondary;
    overflow-wrap: anywhere;
    font-family: ui-monospace, monospace;
  }

  .deferred__summary {
    @include px-responsive('md');
    @include py-responsive('sm');
    @apply text-lg text-fg-secondary transition-colors duration-fast ease-standard hover:text-fg;
    cursor: pointer;
  }

  /* Room for the sticky bar, so the last note field can scroll clear of it. */
  .admin-content {
    padding-bottom: var(--admin-bar-height);

    @include mobile {
      padding-bottom: calc(var(--admin-bar-height) + var(--chat-bubble-reserve));
    }
  }

  .admin-board {
    --admin-bar-height: 5rem;
    --chat-bubble-reserve: 6.75rem;
  }

  /* The site chat bubble (hub widget.js) is a fixed 100x100 px frame in the bottom-right
     corner and the dev "Warianty" chip sits bottom-left. On narrow screens there is no room
     between them, so the bar rides above both instead of squeezing between them. */
  .admin-bar-wrap {
    position: sticky;
    bottom: 0;
    z-index: 10;

    @include mobile {
      bottom: var(--chat-bubble-reserve);
    }
  }

  /* Buttons sit at the right, clear of the chip on the left. */
  .admin-bar {
    @include px-responsive('md');
    @include py-responsive('sm');
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    background-color: var(--color-surface-raised);
  }

  /* From tablet width up the bar sits at the bottom edge, so keep the buttons out of the
     chat bubble. Doubled class so the responsive padding mixin's media rules do not win. */
  .admin-bar.admin-bar {
    @include mobile-up {
      padding-right: var(--chat-bubble-reserve);
    }
  }

  .admin-bar__buttons {
    display: flex;
    gap: 0.5rem;

    @include mobile {
      :global(.button) {
        padding-inline: 0.75rem;
      }
    }
  }

  .admin-bar__status {
    @apply text-sm text-fg-secondary;
    text-align: right;

    &:empty {
      display: none;
    }
  }

  .admin-bar__fallback {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    &[hidden] {
      display: none;
    }
  }

  .admin-bar__hint {
    @apply text-sm text-fg-secondary;
  }

  .admin-bar__text {
    @apply text-sm text-fg;
    width: 100%;
    padding: 0.5rem 0.75rem;
    background-color: var(--color-surface);
    font-family: ui-monospace, monospace;
    resize: vertical;
  }
</style>
