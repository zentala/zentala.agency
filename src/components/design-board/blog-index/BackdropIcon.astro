---
import BoardIcon from '../icons-controls/BoardIcon.astro'
import { backdropIcon } from './blog-icons'

/**
 * Large decorative icon behind the content of a cell, like the background icon of
 * the capabilities cards. It clips itself, so the cell needs no `overflow`; the
 * host must be `position: relative` and `isolation: isolate`. Brightens when the
 * interactive cell around it is hovered.
 */
interface Props {
  name: string
}

const { name } = Astro.props
---

<span class="backdrop-icon" aria-hidden="true">
  <BoardIcon spec={backdropIcon(name)} />
</span>

<style>
  .backdrop-icon {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: clip;
    color: var(--color-text);
    opacity: 0.06;
    pointer-events: none;
    transition: opacity var(--motion-base) var(--ease-standard);
  }

  .backdrop-icon :global(svg) {
    position: absolute;
    right: -1.5rem;
    bottom: -2rem;
  }

  :global(.cell-interactive:hover) .backdrop-icon,
  :global(.cell-interactive:focus-within) .backdrop-icon {
    opacity: var(--icon-bg-max-opacity);
  }
</style>
