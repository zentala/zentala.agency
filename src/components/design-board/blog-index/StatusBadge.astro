---
import BoardIcon from '../icons-controls/BoardIcon.astro'
import { STATUS_LABEL, statusIcon, type PartStatus } from './status'

/**
 * Marker of a series part, set inline after the title text: an icon and a
 * short text, no fill. It never breaks inside, so it wraps as one word.
 * A published part shows the calendar icon and its date in the table grey;
 * a draft or a review shows its icon and word in the status colour, which the
 * parent sets through `--status-draft` and `--status-review`.
 */
interface Props {
  status: PartStatus
  datetime: string
  dateLabel: string
}

const { status, datetime, dateLabel } = Astro.props
---

<span class={`status-badge status-badge--${status}`}>
  <BoardIcon spec={statusIcon(status)} />
  {
    status === 'published' ? (
      <time datetime={datetime}>{dateLabel}</time>
    ) : (
      <span>{STATUS_LABEL[status]}</span>
    )
  }
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 1.5rem;
    vertical-align: top;
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .status-badge--draft {
    color: var(--status-draft, var(--color-text-subtle));
  }

  .status-badge--review {
    color: var(--status-review, var(--color-text-secondary));
  }
</style>
