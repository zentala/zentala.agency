---
import SectionHeader from '@/components/primitives/sections/SectionHeader.astro'
import ArchiveCell from './ArchiveCell.astro'
import LatestCell from './LatestCell.astro'
import SeriesRow from './SeriesRow.astro'
import type { BoardData } from './data'

/**
 * The latest-posts layout the owner picked (B1, options F and G): no header above
 * the posts, the 7 newest posts with the first one two columns wide, then the
 * archive link cell, which fills three rows of three. The series follow under a
 * thin section header. `look` is `cover` (generated covers) or `icon` (own icons
 * of posts, categories and series instead of covers).
 */
interface Props {
  data: BoardData
  look: 'cover' | 'icon'
}

const { data, look } = Astro.props
const LATEST_COUNT = 7

const shown = data.latest.slice(0, LATEST_COUNT)
const seriesTitles = new Map(data.series.map((item) => [item.slug, item.title]))
const partCount = data.series.reduce(
  (sum, item) => sum + item.parts.length,
  0,
)
---

<section class="section-full">
  <div class="container-bordered">
    <div class="cards-grid">
      {
        shown.map((post, index) => (
          <LatestCell
            post={post}
            look={look}
            seriesTitle={seriesTitles.get(post.data.series ?? '')}
            featured={index === 0}
          />
        ))
      }
      <ArchiveCell
        postCount={data.posts.length}
        shownCount={shown.length}
        decorated
      />
    </div>
  </div>
</section>

<section class="section-full">
  <div class="container-bordered">
    <SectionHeader
      variant="c"
      tag="h3"
      headline="Series"
      labelIcon="stack"
      meta={`${data.series.length} series, ${partCount} parts`}
    />
    <SeriesRow series={data.series} variant="badges" icons={look === 'icon'} />
  </div>
</section>
