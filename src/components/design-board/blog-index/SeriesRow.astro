---
import SeriesCard from '@/components/cards/SeriesCard.astro'
import SeriesBlock from './SeriesBlock.astro'
import SeriesList from './SeriesList.astro'
import type { BoardSeries } from './data'

/**
 * The series of the blog side by side, three per row, in one presentation.
 * `badges` is the owner's pick with his changes; `palette` sets its badge colours.
 */
interface Props {
  series: BoardSeries[]
  variant: 'card' | 'date' | 'number' | 'combined' | 'badges'
  palette?: 'tint' | 'neutral'
}

const { series, variant, palette } = Astro.props
---

<div class="line-grid line-grid--fill-last">
  {
    series.map((item) =>
      variant === 'card' ? (
        <SeriesCard
          title={item.title}
          slug={item.slug}
          parts={item.parts}
          newestSlug={item.newestSlug}
          isFresh={item.isFresh}
          hiddenInProduction={item.hiddenInProduction}
        />
      ) : variant === 'badges' ? (
        <SeriesBlock series={item} palette={palette} />
      ) : (
        <SeriesList series={item} variant={variant} />
      ),
    )
  }
</div>
