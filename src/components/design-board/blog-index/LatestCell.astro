---
import DraftBadge from '@/components/primitives/DraftBadge.astro'
import { formatDate } from '@/lib/blog/format-date'
import { slugify } from '@/lib/blog/slug'
import BoardIcon from '../icons-controls/BoardIcon.astro'
import BackdropIcon from './BackdropIcon.astro'
import SlugCover from '@/components/blog/index/SlugCover.astro'
import { categoryIconName, postIconName, textIcon } from './blog-icons'
import type { BlogIndexPost } from '@/lib/blog/index-data'

/**
 * Post cell of the latest-posts layout (B1, options F and G). The meta takes two
 * lines: date and category, then "Part n of <series>" with the series as a link.
 * `look` picks the top of the cell: a generated cover, or the post's own icon
 * (small in the title row, large behind the text). `featured` spans two columns.
 */
interface Props {
  post: BlogIndexPost
  look: 'cover' | 'icon'
  seriesTitle?: string
  featured?: boolean
}

const META_TEXT_PX = 14
const TITLE_TEXT_PX = 24

const { post, look, seriesTitle, featured = false } = Astro.props
const { title, date, category, excerpt, part, series, published, review } =
  post.data
const { datetime, label } = formatDate(date)
const coverLabel =
  part === undefined ? undefined : String(part).padStart(2, '0')
const ownIcons = look === 'icon'
const categoryIcon = ownIcons ? categoryIconName(category) : 'tag'
---

<article class:list={['cell-interactive', { 'latest-cell--featured': featured }]}>
  <div class="latest-cell">
    <a href={`/blog/${post.slug}`} class="absolute inset-0 z-0" aria-label={title}
    ></a>
    {published === false && <DraftBadge review={review === true} />}
    {ownIcons && <BackdropIcon name={postIconName(post)} />}
    {
      !ownIcons && (
        <SlugCover
          seed={post.slug}
          label={coverLabel}
          size={featured ? 'wide' : 'regular'}
        />
      )
    }
    <div class="latest-cell__body padding-responsive-md">
      <div class="latest-cell__head">
        <h4 class="latest-cell__title">{title}</h4>
        {
          ownIcons && (
            <BoardIcon
              spec={textIcon(postIconName(post), TITLE_TEXT_PX)}
              class="latest-cell__icon"
            />
          )
        }
      </div>
      <div class="latest-cell__meta">
        <p>
          <span>
            <BoardIcon spec={textIcon('calendar-blank', META_TEXT_PX)} />
            <time datetime={datetime}>{label}</time>
          </span>
          <a href={`/category/${slugify(category)}`}>
            <BoardIcon spec={textIcon(categoryIcon, META_TEXT_PX)} />
            {category}
          </a>
        </p>
        {
          series && seriesTitle && part !== undefined && (
            <p>
              <span>
                <BoardIcon spec={textIcon('stack', META_TEXT_PX)} />
                <span>
                  Part {part} of <a href={`/series/${series}`}>{seriesTitle}</a>
                </span>
              </span>
            </p>
          )
        }
      </div>
      <p class="latest-cell__excerpt">{excerpt}</p>
    </div>
  </div>
</article>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .latest-cell {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .latest-cell__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    pointer-events: none;
  }

  .latest-cell__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .latest-cell__head :global(.latest-cell__icon) {
    margin-top: 0.125rem;
    color: var(--color-text-muted);
  }

  /* Keeps the icon clear of the dev-only draft marker in the corner. */
  @include mobile {
    .latest-cell__head :global(.latest-cell__icon) {
      margin-top: 1rem;
    }
  }

  .latest-cell__title {
    color: var(--color-text);
    font-size: var(--text-h3);
    font-weight: 300;
    line-height: 1.25;
  }

  .latest-cell__meta {
    display: grid;
    gap: 0.125rem;
    margin-top: 0.75rem;
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    line-height: 1.5rem;

    p {
      display: flex;
      flex-wrap: wrap;
      gap: 0 0.875rem;
    }

    p > span,
    p > a {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
    }

    a {
      position: relative;
      z-index: 1;
      pointer-events: auto;
      transition: color var(--motion-fast) var(--ease-standard);
    }

    span a {
      color: var(--color-text-muted);
    }

    a:hover,
    a:focus-visible {
      color: var(--color-text);
    }
  }

  .latest-cell__excerpt {
    display: -webkit-box;
    overflow: hidden;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.5rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .latest-cell--featured {
    grid-column: span 2;

    @include tablet {
      grid-column: auto;
    }

    .latest-cell__title {
      font-size: var(--text-h1-page);
      line-height: 1.15;

      @include tablet {
        font-size: var(--text-h3);
        line-height: 1.25;
      }
    }

    .latest-cell__excerpt {
      max-width: 65ch;
      font-size: var(--text-lead);
      line-height: 1.75rem;
      -webkit-line-clamp: 4;
    }
  }
</style>
