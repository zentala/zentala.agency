---
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import { formatDate } from '@/lib/blog/format-date'
import BoardIcon from '../icons-controls/BoardIcon.astro'
import BackdropIcon from './BackdropIcon.astro'
import SlugCover from '@/components/blog/index/SlugCover.astro'
import StatusBadge from './StatusBadge.astro'
import { formatShortDate, type BlogIndexSeries } from '@/lib/blog/index-data'
import { textIcon } from './blog-icons'
import { partStatus, smallIcon } from './status'

/**
 * One series as a static grid cell, the owner's pick with his changes (B1-E,
 * B2-E, B2-F): generated cover, name, short description, parts count with an
 * icon, then every part as a row. The status badge flows in the text, right
 * after the last word of the title, so the title keeps the whole row width.
 * `palette` picks the badge colours: `tint` (delicate cool hues) or `neutral`.
 * `icon` replaces the cover with the series' own icon: small beside the name and
 * large behind the block. The "Start" link carries a play icon.
 */
interface Props {
  series: BlogIndexSeries
  palette?: 'tint' | 'neutral'
  icon?: string
}

const { series, palette = 'tint', icon } = Astro.props
const NAME_TEXT_PX = 24
const COUNT_ICON = smallIcon('stack')
const START_ICON = smallIcon('play')

const rows = series.parts.map((part, index) => ({
  slug: part.slug,
  title: part.data.title,
  number: String(part.data.part ?? index + 1).padStart(2, '0'),
  status: partStatus(part),
  datetime: formatDate(part.data.date).datetime,
  dateLabel: formatShortDate(part.data.date),
}))
const firstPart = series.parts[0]
---

<div class={`series-block series-block--${palette}`}>
  {icon ? <BackdropIcon name={icon} /> : <SlugCover seed={series.slug} />}
  <div class="series-block__body padding-responsive-md">
    <div class="series-block__head">
      <h4 class="series-block__name">
        <a href={`/series/${series.slug}`}>{series.title}</a>
      </h4>
      {icon && <BoardIcon spec={textIcon(icon, NAME_TEXT_PX)} />}
    </div>
    {series.tagline && <p class="series-block__tagline">{series.tagline}</p>}
    <div class="series-block__meta">
      <p class="series-block__count">
        <BoardIcon spec={COUNT_ICON} />
        {series.parts.length} parts
      </p>
      {
        firstPart && (
          <a href={`/blog/${firstPart.slug}`} class="series-block__start group">
            <BoardIcon spec={START_ICON} />
            Start
            <SiteIcon name="next" size="sm" class="arrow-nudge" />
          </a>
        )
      }
    </div>

    <ol class="series-block__rows">
      {
        rows.map((row) => (
          <li>
            <a href={`/blog/${row.slug}`} class="part-row">
              <span class="part-row__number">
                <span class="sr-only">Part </span>
                {row.number}
              </span>
              <span class="part-row__title">
                {row.title}
                <span class="part-row__badge">
                  <StatusBadge
                    status={row.status}
                    datetime={row.datetime}
                    dateLabel={row.dateLabel}
                  />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  .series-block--tint {
    --status-review: color-mix(
      in srgb,
      var(--color-accent) 65%,
      var(--color-text-muted)
    );
    --status-draft: color-mix(
      in srgb,
      color-mix(in srgb, var(--color-success) 55%, var(--color-accent)) 40%,
      var(--color-text-muted)
    );
  }

  .series-block {
    position: relative;
    isolation: isolate;
  }

  .series-block__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-text-muted);
  }

  .series-block__name {
    color: var(--color-text);
    font-size: var(--text-h3);
    font-weight: 300;
    line-height: 1.25;
  }

  .series-block__name a,
  .series-block__start {
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .series-block__name a:hover {
    color: var(--color-text-secondary);
  }

  .series-block__tagline {
    margin-top: 0.5rem;
    color: var(--color-text-secondary);
    line-height: 1.5rem;
  }

  .series-block__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5rem;
  }

  .series-block__count,
  .series-block__start {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-variant-numeric: tabular-nums;
  }

  .series-block__start {
    gap: 0.25rem;
    color: var(--color-text);
  }

  .series-block__start:hover {
    color: var(--color-text-secondary);
  }

  .series-block__rows {
    margin-top: 0.75rem;
  }

  .part-row {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    align-items: start;
    column-gap: 0.5rem;
    margin: 0 -0.5rem;
    padding: 0.25rem 0.5rem;
    color: var(--color-text-secondary);
    line-height: 1.5rem;
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .part-row:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-text);
  }

  .part-row__number {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  /* Adds to the word space before the badge; small enough to go unseen when the badge wraps. */
  .part-row__badge {
    margin-left: 0.125rem;
  }
</style>
