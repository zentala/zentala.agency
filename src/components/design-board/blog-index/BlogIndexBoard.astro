---
import BoardQuestion from './BoardQuestion.astro'
import IndexCurrent from './IndexCurrent.astro'
import IndexGrid from './IndexGrid.astro'
import LatestGrid from './LatestGrid.astro'
import OptionBar from './OptionBar.astro'
import SeriesRow from './SeriesRow.astro'
import { loadBlogIndexData } from '@/lib/blog/index-data'

/**
 * Design board, group "blog index": questions B1 (layout of /blog) and B2
 * (how one series is presented). Dev-only demo; the real /blog is untouched.
 * Every option renders the real posts and series, drafts included.
 */
const data = await loadBlogIndexData()

const B1 = {
  id: 'B1',
  question: 'Jak ma być zbudowana strona /blog?',
  recommendation:
    'F: Twój wybór z ostatniej rundy złożony w całość. Do potwierdzenia zostaje jedno: okładki (F) czy własne ikony wpisów, kategorii i serii zamiast okładek (G).',
  note: 'Na 390 px każda opcja układa się w jedną kolumnę: posty jeden pod drugim, potem archiwum, potem serie; okładki maleją do 96 px. W B, C i D nagłówki sekcji mają 44 px wysokości. Komórki mają znów pełny odstęp od góry, taki jak z boków; proporcje i położenie nagłówków rozstrzyga pytanie S1. W E wiersze serii wyglądają jak w B2-E. F i G: przy dwóch kolumnach (771–1000 px) komórka archiwum zajmuje cały rząd, na telefonie duży wpis ma zwykły rozmiar. Ikony przy tekście są o 2 px większe od tekstu (tekst 14 px, ikona 16 px) w wadze Regular; cienka waga jest tylko na dużych ikonach w tle.',
}

const B2 = {
  id: 'B2',
  question: 'Jak ma wyglądać blok jednej serii?',
  recommendation:
    'E: wybrana opcja D bez osobnej kolumny statusu: znaczek (ikona i słowo albo ikona i data) stoi zaraz za tytułem. F to ten sam układ w samych szarościach, gdyby kolory z E były jeszcze za mocne.',
  note: 'Każda opcja pokazuje trzy prawdziwe serie obok siebie. W wąskiej komórce (poniżej ok. 340 px) data z prawej znika, a data z lewej przechodzi nad tytuł. W danych bloga są trzy stany części: opublikowana, szkic (Draft) i do recenzji (Review); części planowanych nie ma. Na produkcji widać tylko opublikowane, więc każdy wiersz kończy się tam datą. W E i F znaczek stoi w tekście, zaraz za ostatnim słowem tytułu, więc tytuł ma całą szerokość wiersza. Długie tytuły nadal łamią się na 2, czasem 3 linie; gdy znaczek nie mieści się w linii, przechodzi w całości do następnej, przy lewej krawędzi tytułu.',
}
---

<div data-design-board="blog-index">
  <BoardQuestion {...B1} />

  <OptionBar
    questionId="B1"
    letter="A"
    name="Obecny /blog"
    consequence="Bez zmian: posty bez serii i karty serii w jednej siatce, serie pokazują 6 części i zwijają resztę."
  />
  <IndexCurrent data={data} />

  <OptionBar
    questionId="B1"
    letter="B"
    name="Siatka postów bez obrazków, potem serie"
    consequence="Od razu 5 najnowszych postów i komórka archiwum, niżej 3 serie z pełnymi listami; nic nie przyciąga wzroku poza tytułami."
  />
  <IndexGrid data={data} />

  <OptionBar
    questionId="B1"
    letter="C"
    name="To samo z generowanymi okładkami"
    consequence="Każdy post dostaje okładkę wyliczoną z adresu (plan z linii siatki, numer części w największym polu); strona jest wyższa o 144 px na rząd."
    status="Wybrana, tu bez zmian"
  />
  <IndexGrid data={data} covers />

  <OptionBar
    questionId="B1"
    letter="D"
    name="Najnowszy post szeroko, reszta w siatce"
    consequence="Najnowszy post zajmuje dwie kolumny z dużą okładką; w siatce mieszczą się 4 posty zamiast 5 i komórka archiwum."
  />
  <IndexGrid data={data} covers featured />

  <OptionBar
    questionId="B1"
    letter="E"
    name="C ze zmianami: serie z okładką, opisem i ikoną przy liczbie części"
    consequence='Posty jak w C. Każda seria dostaje okładkę wyliczoną z adresu serii, krótki opis pod nazwą i ikonę przy liczbie części; "Start" przechodzi z pierwszego wiersza do tej samej linii co liczba części. Blok serii jest wyższy o okładkę (144 px) i opis.'
    status="Poprzednia runda"
  />
  <IndexGrid data={data} covers seriesBadges />

  <OptionBar
    questionId="B1"
    letter="F"
    name="Najnowszy wpis duży, 7 wpisów i archiwum w trzech rzędach"
    consequence='Bez napisu nad wpisami. Meta w dwóch liniach: data i kategoria, niżej "Part 13 of" z nazwą serii jako linkiem. Komórka archiwum ma małą ikonę w prawym górnym rogu i dużą ikonę w tle. Nad seriami cienki nagłówek sekcji z ikoną (T4-C), przy "Start" ikona. Strona jest dłuższa o jeden rząd wpisów.'
    recommended
  />
  <LatestGrid data={data} look="cover" />

  <OptionBar
    questionId="B1"
    letter="G"
    name="To samo z własnymi ikonami zamiast okładek"
    consequence="Każdy wpis, kategoria i seria ma swoją ikonę (fabryka przy wycieczce po fabryce oprogramowania, uścisk dłoni przy dzierżawie pliku): mała obok tytułu, duża w tle. Rząd jest niższy o okładkę (144 px), ale każdy nowy wpis wymaga dobrania ikony; bez niej dostaje ikonę kategorii."
  />
  <LatestGrid data={data} look="icon" />

  <BoardQuestion {...B2} />

  <OptionBar
    questionId="B2"
    letter="A"
    name="Obecna karta serii"
    consequence='Etykieta "Series" nad nazwą, numery części, środek długiej serii zwinięty pod przyciskiem; liczby części nie widać.'
  />
  <section class="section-full">
    <div class="container-bordered">
      <SeriesRow series={data.series} variant="card" />
    </div>
  </section>

  <OptionBar
    questionId="B2"
    letter="B"
    name="Tabela: data po lewej, tytuł po prawej"
    consequence="Widać rytm publikacji, ale nie widać kolejności części; w wersji roboczej szkice oznacza kreska po lewej."
  />
  <section class="section-full">
    <div class="container-bordered">
      <SeriesRow series={data.series} variant="date" />
    </div>
  </section>

  <OptionBar
    questionId="B2"
    letter="C"
    name="Numer części po lewej i status po prawej"
    consequence="Widać kolejność i stan (Start, New, Draft), ale nie ma dat; na produkcji prawa kolumna jest prawie pusta."
  />
  <section class="section-full">
    <div class="container-bordered">
      <SeriesRow series={data.series} variant="number" />
    </div>
  </section>

  <OptionBar
    questionId="B2"
    letter="D"
    name="Numer, tytuł i data w jednej tabeli"
    consequence="Kolejność po lewej, data po prawej; status zastępuje datę tylko tam, gdzie coś znaczy (Start, Draft)."
    status="Wybrana, tu bez zmian"
  />
  <section class="section-full">
    <div class="container-bordered">
      <SeriesRow series={data.series} variant="combined" />
    </div>
  </section>

  <OptionBar
    questionId="B2"
    letter="E"
    name="D ze znaczkiem zaraz za tytułem, delikatne kolory"
    consequence="Opublikowana część: ikona kalendarza i data w szarości tabeli. Szkic: ołówek i Draft w zgaszonym morskim. Do recenzji: oko i Review w zgaszonym niebieskim. Bez wypełnienia i ramki, tym samym krojem co tytuł; osobnej kolumny nie ma. Link Start ma teraz ikonę."
    recommended
  />
  <section class="section-full">
    <div class="container-bordered">
      <SeriesRow series={data.series} variant="badges" palette="tint" />
    </div>
  </section>

  <OptionBar
    questionId="B2"
    letter="F"
    name="To samo w samych szarościach"
    consequence="Układ jak w E, bez kolorów: stan odróżnia ikona i słowo. Szkic jest w szarości tabeli, Review o stopień jaśniejszy. Najspokojniejsza wersja, ale stan trudniej wyłapać jednym spojrzeniem."
  />
  <section class="section-full">
    <div class="container-bordered">
      <SeriesRow series={data.series} variant="badges" palette="neutral" />
    </div>
  </section>
</div>
