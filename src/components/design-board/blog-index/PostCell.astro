---
import PostMeta from '@/components/blog/PostMeta.astro'
import DraftBadge from '@/components/primitives/DraftBadge.astro'
import SlugCover from '@/components/blog/index/SlugCover.astro'
import type { BlogIndexPost } from '@/lib/blog/index-data'

/**
 * Compact post cell for the proposed /blog grid: optional generated cover,
 * title, meta line, short excerpt. `featured` makes it two columns wide.
 */
interface Props {
  post: BlogIndexPost
  partLabel?: string
  cover?: boolean
  featured?: boolean
}

const { post, partLabel, cover = false, featured = false } = Astro.props
const { title, date, category, excerpt, part, published, review } = post.data
const coverLabel =
  part === undefined ? undefined : String(part).padStart(2, '0')
---

<article class:list={['cell-interactive', { 'post-cell--featured': featured }]}>
  <div class="post-cell relative flex h-full flex-col">
    <a href={`/blog/${post.slug}`} class="absolute inset-0 z-0" aria-label={title}
    ></a>
    {published === false && <DraftBadge review={review === true} />}
    {
      cover && (
        <SlugCover
          seed={post.slug}
          label={coverLabel}
          size={featured ? 'wide' : 'regular'}
        />
      )
    }
    <div
      class="post-cell__body padding-responsive-md pointer-events-none flex flex-1 flex-col"
    >
      <h4 class="post-cell__title">{title}</h4>
      <div class="mt-2">
        <PostMeta date={date} category={category} partLabel={partLabel} />
      </div>
      <p class="post-cell__excerpt mt-4 text-fg-secondary">{excerpt}</p>
    </div>
  </div>
</article>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .post-cell--featured {
    grid-column: span 2;

    @include tablet {
      grid-column: auto;
    }
  }

  .post-cell__title {
    color: var(--color-text);
    font-size: var(--text-h3);
    font-weight: 300;
    line-height: 1.25;
  }

  .post-cell__excerpt {
    display: -webkit-box;
    overflow: hidden;
    line-height: 1.5rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .post-cell--featured {
    .post-cell__title {
      font-size: var(--text-h1-page);
      line-height: 1.15;

      @include tablet {
        font-size: var(--text-h3);
        line-height: 1.25;
      }
    }

    .post-cell__excerpt {
      max-width: 65ch;
      font-size: var(--text-lead);
      line-height: 1.75rem;
      -webkit-line-clamp: 4;
    }
  }
</style>
