---
/**
 * Label above one rendered option of a design-board question: the option
 * letter, its name and its one-line consequence.
 */
interface Props {
  questionId: string
  letter: string
  name: string
  consequence: string
  recommended?: boolean
  /** Short neutral note on the right, for example the owner's earlier pick. */
  status?: string
  /** Compact side padding: the bar hangs left of the content column (S1, option B). */
  hang?: boolean
}

const {
  questionId,
  letter,
  name,
  consequence,
  recommended = false,
  status,
  hang = false,
} = Astro.props
---

<section class="section-full" data-board-option={`${questionId}-${letter}`}>
  <div class="container-bordered">
    <div class:list={['option-bar', hang ? 'option-bar--hang' : 'px-responsive']}>
      <p class="option-bar__id">
        {questionId}
        <span class="option-bar__letter">{letter}</span>
      </p>
      <p class="option-bar__text">
        <span class="text-fg">{name}</span>
        <span class="text-fg-muted">{consequence}</span>
      </p>
      {
        recommended && (
          <p class="option-bar__pick text-label uppercase">Rekomendowana</p>
        )
      }
      {status && <p class="option-bar__status text-label uppercase">{status}</p>}
    </div>
  </div>
</section>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .option-bar--hang {
    @include px-responsive('sm');
  }

  .option-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    background-color: var(--color-surface-raised);
  }

  .option-bar.option-bar--hang {
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .option-bar__id {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .option-bar__letter {
    margin-left: 0.25rem;
    color: var(--color-text);
    font-size: var(--text-h3);
    font-weight: 300;
    line-height: 1;
  }

  .option-bar__text {
    display: flex;
    flex: 1 1 20rem;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    font-size: var(--text-sm);
  }

  .option-bar__pick {
    color: var(--color-accent);
  }

  .option-bar__status {
    color: var(--color-text-muted);
  }
</style>
