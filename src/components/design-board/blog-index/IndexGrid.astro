---
import ArchiveCell from './ArchiveCell.astro'
import CompactHeader from './CompactHeader.astro'
import PostCell from './PostCell.astro'
import SeriesRow from './SeriesRow.astro'
import type { BoardData } from './data'

/**
 * Options B, C and D of B1: no page header, posts first (three per row, the
 * last cell is the archive link), then the series, three per row, each with
 * all its parts. `covers` adds generated covers; `featured` makes the newest
 * post two columns wide.
 */
interface Props {
  data: BoardData
  covers?: boolean
  featured?: boolean
}

const { data, covers = false, featured = false } = Astro.props
const GRID_CELLS = 6
const FEATURED_SPAN = 2

const postSlots = GRID_CELLS - 1 - (featured ? FEATURED_SPAN - 1 : 0)
const shown = data.latest.slice(0, postSlots)
const partCount = data.series.reduce(
  (sum, item) => sum + item.parts.length,
  0,
)
---

<section class="section-full">
  <div class="container-bordered">
    <CompactHeader title="Latest posts" note={`${data.posts.length} posts`} />
    <div class="cards-grid">
      {
        shown.map((post, index) => (
          <PostCell
            post={post}
            partLabel={data.partLabelFor(post)}
            cover={covers}
            featured={featured && index === 0}
          />
        ))
      }
      <ArchiveCell postCount={data.posts.length} shownCount={shown.length} />
    </div>
  </div>
</section>

<section class="section-full">
  <div class="container-bordered">
    <CompactHeader
      title="Series"
      note={`${data.series.length} series, ${partCount} parts`}
    />
    <SeriesRow series={data.series} variant="combined" />
  </div>
</section>
