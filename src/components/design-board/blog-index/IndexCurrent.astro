---
import PostCard from '@/components/cards/PostCard.astro'
import SeriesCard from '@/components/cards/SeriesCard.astro'
import type { BlogIndexData } from '@/lib/blog/index-data'

/** Option A of B1: the /blog index as it is today (same markup as src/pages/blog/index.astro). */
interface Props {
  data: BlogIndexData
}

const { feed, series } = Astro.props.data
const seriesBySlug = new Map(series.map((item) => [item.slug, item]))
---

<section class="section-full">
  <div class="container-bordered">
    <div class="cards-grid line-grid--fill-last">
      {
        feed.map((entry) =>
          entry.kind === 'post' ? (
            <PostCard
              title={entry.post.data.title}
              date={entry.post.data.date}
              category={entry.post.data.category}
              excerpt={entry.post.data.excerpt}
              authorVersion={entry.post.data.author}
              link={`/blog/${entry.post.slug}`}
              isDraft={entry.post.data.published === false}
              isReview={entry.post.data.review === true}
            />
          ) : (
            <SeriesCard
              title={seriesBySlug.get(entry.slug)?.title ?? entry.slug}
              slug={entry.slug}
              parts={entry.parts}
              newestSlug={entry.newestSlug}
              isFresh={entry.isFresh}
              hiddenInProduction={
                seriesBySlug.get(entry.slug)?.hiddenInProduction
              }
            />
          ),
        )
      }
    </div>
  </div>
</section>
