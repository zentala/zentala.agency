---
/**
 * Board demo, F3 options E to H: a 3x3 mosaic between B and C. Nine portfolio areas drawn
 * in Phosphor Light (I1-G: Light from 32 px keeps the stroke near 1.5 px). Tiles are shaded
 * by a 45-degree wave: the tone peaks on the middle diagonal, and each tile is a little
 * different. Every tile has its own hover; the hovered tile's name shows under the mosaic.
 * Tiles stay unpositioned, so the names are placed against the grid.
 */
import BoardIcon from '../icons-controls/BoardIcon.astro'

export interface MosaicTile {
  /** Phosphor base name. */
  icon: string
  /** Portfolio area, English site copy. */
  label: string
}

interface Props {
  tiles: MosaicTile[]
  /** `line`: light 1px frames; `open`: no frames; `hatch`: 45-degree hatching; `moving`: the wave drifts. */
  look: 'line' | 'open' | 'hatch' | 'moving'
  icon?: 32 | 40
}

const { tiles, look, icon = 32 } = Astro.props
const COLUMNS = 3

/** Tone in % of white: low in the corners, highest on the middle diagonal, plus a small step per tile. */
function tone(index: number): string {
  const diagonal = Math.floor(index / COLUMNS) + (index % COLUMNS)
  const wave = 0.5 + 0.5 * Math.sin((diagonal / 4) * 2 * Math.PI - Math.PI / 2)
  return `${(2.3 + 3.8 * wave + (index % COLUMNS) * 0.35).toFixed(2)}%`
}
---

<div class:list={['mt3', `mt3--${look}`]} aria-hidden="true">
  <div class="mt3__grid">
    {
      tiles.map((tile, index) => (
        <span
          class="mt3__tile"
          style={`--tone: ${tone(index)}; --r: ${Math.floor(index / COLUMNS)}; --c: ${index % COLUMNS}`}
        >
          <BoardIcon spec={{ set: 'ph', name: tile.icon, weight: 'light', size: icon }} />
          <span class="mt3__label">{tile.label}</span>
        </span>
      ))
    }
  </div>
</div>

<style>
  .mt3 {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 58%, transparent 92%);
    mask-image: linear-gradient(to bottom, black 0%, black 58%, transparent 92%);
  }

  .mt3__grid {
    --tile: 5rem;
    --gap: 0.5rem;
    --step: calc(var(--tile) + var(--gap));
    --span: calc(3 * var(--tile) + 2 * var(--gap));
    position: absolute;
    left: 50%;
    top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(3, var(--tile));
    gap: var(--gap);
    transform: translateX(-50%);
  }

  .mt3__tile {
    display: grid;
    place-items: center;
    height: var(--tile);
    color: var(--color-text-muted);
    background-color: color-mix(in srgb, var(--color-text) var(--tone), transparent);
    background-image: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-text) 3%, transparent),
      transparent 70%
    );
    pointer-events: auto;
    transition:
      background-color var(--motion-base) var(--ease-standard),
      color var(--motion-base) var(--ease-standard),
      border-color var(--motion-base) var(--ease-standard);
  }

  .mt3--line .mt3__tile {
    border: 1px solid color-mix(in srgb, var(--color-text) 4.5%, transparent);
  }

  .mt3--hatch .mt3__tile {
    background-color: transparent;
    background-image: repeating-linear-gradient(
      45deg,
      color-mix(in srgb, var(--color-text) calc(var(--tone) * 1.8), transparent) 0 1px,
      transparent 1px 6px
    );
  }

  /* One band of light shared by all tiles: each tile shows its own slice of it. */
  .mt3--moving .mt3__tile {
    background-image: repeating-linear-gradient(
      135deg,
      transparent 0,
      color-mix(in srgb, var(--color-text) 5%, transparent) calc(var(--span) * 0.3536),
      transparent calc(var(--span) * 0.7071)
    );
    background-size: var(--span) var(--span);
    background-position: calc(var(--c) * var(--step) * -1) calc(var(--r) * var(--step) * -1);
    animation: mt3-drift 24s linear infinite;
  }

  @keyframes mt3-drift {
    to {
      background-position:
        calc(var(--c) * var(--step) * -1 - var(--span))
        calc(var(--r) * var(--step) * -1 - var(--span));
    }
  }

  .mt3--moving.is-paused .mt3__tile {
    animation-play-state: paused;
  }

  .mt3__label {
    position: absolute;
    top: calc(100% + 0.875rem);
    left: -2rem;
    right: -2rem;
    color: var(--color-text-secondary);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-align: center;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity var(--motion-base) var(--ease-standard);
  }

  :global(.group):hover .mt3__tile {
    color: var(--color-text-secondary);
  }

  .mt3 .mt3__tile:hover {
    color: var(--color-text);
    background-color: color-mix(in srgb, var(--color-text) calc(var(--tone) + 5%), transparent);
  }

  .mt3--line .mt3__tile:hover {
    border-color: color-mix(in srgb, var(--color-text) 14%, transparent);
  }

  .mt3__tile:hover .mt3__label {
    opacity: 1;
  }

  @media (max-width: 770px) {
    .mt3__grid {
      --tile: 4.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mt3--moving .mt3__tile {
      animation: none;
    }

    .mt3__tile,
    .mt3__label {
      transition: none;
    }
  }
</style>

<script>
  // The drifting wave runs only while the mosaic is on screen (the CSS drops it under reduced motion).
  const moving = document.querySelectorAll<HTMLElement>('.mt3--moving')
  if (moving.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) entry.target.classList.toggle('is-paused', !entry.isIntersecting)
    })
    moving.forEach((mosaic) => observer.observe(mosaic))
  }
</script>
