---
/**
 * Board demo: a form field for the F1 options. The field itself is `ThemedInput`, the
 * one implementation the site uses (floating label, neutral focus, autofill colours);
 * this wrapper only adds what the board compares.
 * `variant`: `grid` (a line-grid cell, shared cell overlay), `line` (horizontal lines
 * only: the wrapper owns its top line and focus brightens the line below it) or
 * `accent` (rejected option D: the grid with a thin accent line, label and icon on focus).
 */
import ThemedInput from '@/components/ThemedInput.astro'

interface Props {
  id: string
  label: string
  icon: string
  variant: 'grid' | 'line' | 'accent'
  type?: 'text' | 'email' | 'tel'
  multiline?: boolean
  required?: boolean
  class?: string
}

const { id, label, icon, variant, type, multiline, required, class: className = '' } = Astro.props
---

<div class:list={['ff', `ff--${variant}`, className]}>
  <ThemedInput
    id={id}
    placeholder={label}
    icon={icon}
    type={type}
    multiline={multiline}
    required={required}
  />
</div>

<style lang="scss">
  .ff {
    position: relative;
    display: grid;
  }

  /* C: the wrapper owns its top line; the cell overlay of the field is switched off. */
  .ff--line {
    border-top: 1px solid var(--color-line);
  }

  .ff--line :global(.field)::after {
    display: none;
  }

  .ff--line::after,
  .ff.ff--accent::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--line-focus);
    opacity: 0;
    pointer-events: none;
    z-index: var(--z-cell-hover);
    transition: opacity var(--motion-fast) var(--ease-standard);
  }

  .ff--line:has(:focus)::after,
  .ff--accent:has(:focus)::after {
    opacity: 1;
  }

  /* D (rejected): the focus overlay becomes a 1px accent line on the bottom line. */
  .ff.ff--accent :global(.field)::after {
    display: none;
  }

  .ff.ff--accent::after {
    left: -1px;
    right: -1px;
    background: var(--color-accent);
  }

  .ff.ff--accent :global(.field__control:focus ~ .field__label),
  .ff.ff--accent :global(.field__control:focus ~ .field__icon) {
    color: var(--color-accent);
  }
</style>
