---
/**
 * Board demo: the contact form built from FloatField, for options B and C of F1.
 * `grid` is a line grid (fields share lines); `line` keeps only the horizontal lines.
 * `accent` is the rejected option D: the grid with an accent focus line.
 * The form has no frame and no outer padding: its lines are the lines of the cell it
 * sits in. The last row holds a padded block for a privacy note on the left and the
 * submit button on the right, flush with the row's lines.
 */
import Button from '@/components/Button.astro'
import FloatField from './FloatField.astro'

interface Props {
  variant: 'grid' | 'line' | 'accent'
  /** Prefix that keeps field ids unique on the board. */
  prefix: string
  hidden?: boolean
}

const { variant, prefix, hidden = false } = Astro.props
---

<form
  class:list={['float-form', variant === 'line' ? 'float-form--line' : 'line-grid']}
  novalidate
  hidden={hidden}
  data-board-form
  data-form-variant={variant}
>
  <FloatField id={`${prefix}-fname`} label="First name" icon="person" variant={variant} required />
  <FloatField id={`${prefix}-lname`} label="Last name" icon="person" variant={variant} />
  <FloatField id={`${prefix}-email`} label="Email" icon="email" type="email" variant={variant} required />
  <FloatField id={`${prefix}-phone`} label="Phone" icon="phone" type="tel" variant={variant} />
  <FloatField id={`${prefix}-msg`} label="Your message" icon="message" variant={variant} multiline class="float-form__span" />
  <div class:list={['float-form__foot', 'float-form__span', `float-form__foot--${variant}`]}>
    <div class="float-form__aside">
      <label class="float-form__check">
        <input type="checkbox" name={`${prefix}-copy`} />
        <span>Send me a copy of this message</span>
      </label>
      <p class="float-form__note">
        I use your details only to answer you. No newsletter, no sharing.
      </p>
    </div>
    <Button tier="primary" type="submit" text="Send message" icon="send" iconPosition="right" />
  </div>
</form>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .float-form {
    --cols-wide: 2;
    --cols-medium: 2;
    --cols-narrow: 1;
  }

  .float-form[hidden] {
    display: none;
  }

  .float-form--line {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* The first row's line lands on the line above the form, as in a line grid. */
    margin-top: -1px;

    @include tablet {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .float-form > :global(.float-form__span) {
    grid-column: 1 / -1;
  }

  .float-form__foot {
    display: flex;
    align-items: stretch;

    @include tablet {
      flex-direction: column;
    }
  }

  .float-form__foot--line {
    border-top: 1px solid var(--color-line);
  }

  .float-form__aside {
    flex: 1;
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem;
  }

  .float-form__check {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-text-secondary);
    cursor: pointer;

    input {
      width: 1rem;
      height: 1rem;
      accent-color: var(--color-text);
    }
  }

  .float-form__note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* The button fills the right end of the row, so its edges are the row's lines. */
  .float-form__foot :global(.button) {
    min-width: 14rem;
    padding-inline: 2rem;
  }
</style>
