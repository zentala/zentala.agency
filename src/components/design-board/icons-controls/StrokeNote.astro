---
/**
 * I1 facts: why small icons look grey, and how sharp each compared set draws at 16 to
 * 24 px. One table: the icons at those sizes, the stroke width and the measured share
 * of fully white pixels.
 */
import BoardCell from './BoardCell.astro'
import BoardIcon from './BoardIcon.astro'
import { mapIcon } from './icon-map'
import { formatPx, isSubPixel, strokePx } from './stroke-math'
import { COVERAGE_ROWS, COVERAGE_SIZES } from '../icon-sets/coverage'

const SAMPLES = ['date', 'nav-contact', 'arrow-next'] as const

const FACTS = [
  'Ikona to rysunek na siatce, więc kreska kurczy się razem z ikoną. Phosphor Light ma 6 px w ikonie 128 px i 0,75 px w ikonie 16 px.',
  'Zwykły ekran nie zapali części piksela. Kreskę cieńszą niż 1 px rysuje szarym pikselem, a kreskę leżącą między pikselami rozmywa na dwa.',
  'Kreska 1,5 px nigdy nie trafi równo w piksele zwykłego ekranu: jeden piksel jest biały, sąsiedni szary. Dlatego przy 18 i 20 px żaden zestaw nie ma więcej niż 42% w pełni białych pikseli.',
  'Przy 18 px na zwykłym ekranie: Phosphor Bold 40%, Lucide 2,25 i Material 35%, Lucide 2 i Tabler 32%, Iconoir 23%, Phosphor Regular 11%. Przy skalowaniu 125%: Bold 47%, Lucide 2,25 44%, Lucide 2 i Tabler 40%, Material 39%, Regular 27%.',
  'Najostrzej wypada rozmiar, w którym ikonę narysowano: Material Symbols przy 24 px ma 71%. Phosphor Regular trafia w piksele tylko przy 16 px (kreska równo 1 px).',
  'Stała kreska 1,5 px w Lucide daje przy 18 px to samo co Lucide 2, bo to ta sama grubość. Stała kreska 2 px jest najostrzejsza przy 16 i 18 px (48% i 42%), ale najcięższa.',
]

const rows = COVERAGE_ROWS.map((row) => {
  const { set, ...options } = row.style
  return {
    ...row,
    cells: COVERAGE_SIZES.map((size, index) => ({
      px: strokePx({ ...row.style, size }) as number,
      crisp: [row.crisp.dpr1[index], row.crisp.dpr125[index]],
      icons: SAMPLES.map((name) => mapIcon(name, set, { ...options, size })),
    })),
  }
})
---

<BoardCell wide heading="Dlaczego małe ikony są szare i który zestaw rysuje najostrzej">
  <div class="stroke-note">
    <ul class="stroke-note__facts">
      {FACTS.map((fact) => <li>{fact}</li>)}
    </ul>
    <table class="stroke-table">
      <caption>
        Pod ikonami: grubość kreski, potem udział w pełni białych pikseli na zwykłym
        ekranie i przy skalowaniu 125%. Średnia z sześciu ikon każdego zestawu. Szara
        grubość: kreska cieńsza niż 1 px.
      </caption>
      <thead>
        <tr>
          <th scope="col">Zestaw</th>
          {COVERAGE_SIZES.map((size) => <th scope="col">{size} px</th>)}
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <th scope="row">
                {row.label}
                {row.note && <span class="stroke-table__note">{row.note}</span>}
              </th>
              {row.cells.map((cell) => (
                <td>
                  <span class="stroke-table__icons">
                    {cell.icons.map((spec) => (
                      <BoardIcon spec={spec} />
                    ))}
                  </span>
                  <span class:list={['stroke-table__px', isSubPixel(cell.px) && 'is-thin']}>
                    {formatPx(cell.px)}
                  </span>
                  <span class="stroke-table__crisp">
                    <span>{cell.crisp[0]}%</span>
                    <span>{cell.crisp[1]}%</span>
                  </span>
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</BoardCell>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .stroke-note {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2rem 3rem;
    align-items: start;

    @include medium {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .stroke-note__facts {
    display: grid;
    gap: 0.75rem;
    max-width: 62ch;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .stroke-table {
    width: 100%;
    font-size: var(--text-sm);
    color: var(--color-text);

    caption {
      caption-side: bottom;
      padding-top: 0.75rem;
      text-align: left;
      color: var(--color-text-subtle);
    }

    th {
      font-weight: 400;
      text-align: left;
      color: var(--color-text-muted);
    }

    thead th {
      padding-bottom: 0.5rem;
      font-size: var(--text-label);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--color-text-subtle);
    }

    th,
    td {
      padding-block: 0.5rem;
      padding-right: 1rem;
      vertical-align: middle;
    }
  }

  .stroke-table__note {
    display: block;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .stroke-table__icons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.5rem;
  }

  .stroke-table__px {
    display: block;
    margin-top: 0.25rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  .stroke-table__px.is-thin {
    color: var(--color-text-subtle);
  }

  .stroke-table__crisp {
    display: flex;
    gap: 0.5rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  @include mobile {
    .stroke-table th,
    .stroke-table td {
      padding-right: 0.5rem;
    }

    .stroke-table__icons :global(.board-icon + .board-icon) {
      display: none;
    }

    .stroke-table__crisp {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
