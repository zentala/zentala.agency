---
/**
 * I4: the semantic icon map. Both tables are drawn from the data the other questions
 * use: the rule per place (set, size, weight) and the names with their glyphs.
 */
import BoardQuestion, { type BoardOption } from './BoardQuestion.astro'
import BoardCell from './BoardCell.astro'
import BoardIcon from './BoardIcon.astro'
import { describeBoardIcon, type BoardIconSpec } from './board-icons'
import { ICON_MAP, ICON_PLACES, WEIGHT_BY_SIZE, mapIcon } from './icon-map'
import type { IconContext, IconGroup, SemanticIconName } from './icon-map'

const OPTIONS: readonly BoardOption[] = [
  {
    key: 'A',
    label: 'Jedna mapa z nazwami znaczeń (przyjęte)',
    consequence:
      'Komponent prosi o „date” albo „email”, a jeden plik mówi, który znak to rysuje i w jakim rozmiarze i wadze. Zmiana zestawu lub wagi to edycja jednego pliku; test pilnuje, że nikt nie ładuje ikon inaczej.',
  },
  {
    key: 'B',
    label: 'Nazwy z zestawu, jak dziś',
    consequence:
      'W kodzie zostają nazwy typu „calendar-blank” i „hard-drives” plus lista aliasów. Każda zmiana zestawu oznacza przepisywanie nazw w wielu plikach.',
  },
]

const GROUPS = [...new Set(ICON_MAP.map((entry) => entry.group))] as IconGroup[]
/** Large background icons are drawn smaller in the table. */
const TABLE_MAX_SIZE = 32
const PLACE_SAMPLE: Record<IconContext, SemanticIconName> = {
  footer: 'linkedin',
  contactCard: 'book-call',
  cardBackground: 'strategy',
  meta: 'date',
  nav: 'nav-blog',
  button: 'send',
  buttonArrow: 'arrow-next',
}

const places = ICON_PLACES.map((place) => {
  const { set, ...options } = place.style
  return {
    ...place,
    spec: describeBoardIcon({ ...place.style, name: '' }),
    sample: mapIcon(PLACE_SAMPLE[place.context], set, {
      ...options,
      size: Math.min(place.style.size, TABLE_MAX_SIZE),
    }),
  }
})

/** Glyph columns of the names table: the chosen set at its two small rules, then the second choice. */
const COLUMNS: readonly { label: string; style: Omit<BoardIconSpec, 'name'> }[] = [
  { label: 'Phosphor Bold 18 px', style: { set: 'ph', weight: 'bold', size: 18 } },
  { label: 'Phosphor Regular 16 px', style: { set: 'ph', weight: 'regular', size: 16 } },
  { label: 'Lucide 2, 18 px', style: { set: 'lucide', stroke: 2, size: 18 } },
]
const glyphs = (name: SemanticIconName) =>
  COLUMNS.map(({ style: { set, ...options } }) => mapIcon(name, set, options))

const RULES = [
  'Jeden plik mapy (propozycja: src/lib/icons/icon-map.ts): nasza nazwa, znaczenie, znak w zestawie oraz reguła rozmiaru i wagi dla każdego miejsca.',
  'Wybrany zestaw interfejsu to Phosphor. Znaki marek w stopce pochodzą z Font Awesome, loga technologii z Simple Icons (TechIcon).',
  'Jedna ikona ma jedno znaczenie: strona się nie zbuduje, gdy ten sam znak rysuje dwie nazwy. Dlatego „umów rozmowę” ma kalendarz z plusem, a czat dwa dymki.',
  'SiteIcon przyjmuje wyłącznie nazwy z mapy; literówka nie przechodzi kompilacji TypeScript.',
  'Rozmiar i wagę wybiera reguła miejsca, nie autor komponentu: ikona jest o 2 px większa niż tekst obok.',
  'Test blokuje: import astro-icon i wstawiony ręcznie znacznik svg poza SiteIcon i TechIcon, nazwę spoza mapy oraz wpis mapy, którego nikt nie używa.',
]
---

<BoardQuestion
  id="I4"
  question="Czy ikony mają mieć jedną mapę, w której nasze nazwy opisują znaczenie?"
  options={OPTIONS}
  recommendation="A, przyjęte. Mapa trzyma teraz także regułę z I1: zestaw, rozmiar i wagę dla każdego miejsca. Wiersze „propozycja” czekają na potwierdzenie w I1."
  columns={1}
>
  <BoardCell wide heading="Reguła w mapie: zestaw, rozmiar i waga w każdym miejscu">
    <ul class="icon-places">
      {
        places.map((place) => (
          <li class="icon-places__row">
            <span class="icon-places__sample">
              <BoardIcon spec={place.sample} />
            </span>
            <span class="icon-places__place">
              {place.label}
              <span class="icon-places__status">{place.status}</span>
            </span>
            <span class="icon-places__spec">
              {place.spec}
              {place.textPx && ` · tekst ${place.textPx} px`}
            </span>
            <span class="icon-places__rule">{place.rule}</span>
          </li>
        ))
      }
    </ul>
    <p class="icon-places__weights">
      Waga według rozmiaru w Phosphor: {WEIGHT_BY_SIZE.map((row) => `${row.sizes} ${row.weight} (${row.stroke})`).join('; ')}.
      Wyjątek: meta wpisu zostaje przy Regular 16 px.
    </p>
  </BoardCell>
  <BoardCell wide heading={`Nazwy i znaki (kolumny od lewej: ${COLUMNS.map((column) => column.label).join(', ')})`}>
    <div class="icon-map">
      {
        GROUPS.map((group) => (
          <section class="icon-map__group">
            <h3 class="icon-map__group-title">{group}</h3>
            <ul class="icon-map__rows">
              {ICON_MAP.filter((entry) => entry.group === group).map((entry) => (
                <li class="icon-map__row">
                  <span class="icon-map__glyphs">
                    {glyphs(entry.name).map((spec) => (
                      <BoardIcon spec={spec} />
                    ))}
                  </span>
                  <code class="icon-map__name">{entry.name}</code>
                  <span class="icon-map__meaning">{entry.meaning}</span>
                  <span class="icon-map__source">
                    {entry.ph} / {entry.lucide}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </BoardCell>
  <BoardCell wide heading="Zasady, które pilnują jednego źródła">
    <ol class="icon-map__rules">
      {RULES.map((rule) => <li>{rule}</li>)}
    </ol>
  </BoardCell>
</BoardQuestion>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .icon-map {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 3rem;

    @include medium {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .icon-places__row {
    display: grid;
    grid-template-columns: 2.5rem 12rem 16rem minmax(0, 1fr);
    align-items: center;
    gap: 0.25rem 1rem;
    min-height: 3rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .icon-places__sample,
  .icon-places__place {
    color: var(--color-text);
  }

  .icon-places__status {
    display: block;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .icon-places__weights {
    max-width: 90ch;
    color: var(--color-text-secondary);
  }

  .icon-map__group-title {
    margin-bottom: 0.5rem;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .icon-map__row {
    display: grid;
    grid-template-columns: 5.5rem 9.5rem minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    min-height: 2.25rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .icon-map__glyphs {
    display: inline-flex;
    gap: 0.75rem;
    color: var(--color-text);
  }

  .icon-map__name {
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .icon-map__source {
    color: var(--color-text-subtle);
    overflow-wrap: anywhere;
  }

  .icon-map__rules {
    display: grid;
    gap: 0.5rem;
    max-width: 90ch;
    padding-left: 1.25rem;
    list-style: decimal;
    color: var(--color-text-secondary);
  }

  @include medium {
    .icon-places__row {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      padding-block: 0.5rem;
    }

    .icon-places__spec,
    .icon-places__rule {
      grid-column: 2;
    }
  }

  @include mobile {
    .icon-map__row {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      row-gap: 0;
      padding-block: 0.375rem;
    }

    .icon-map__meaning,
    .icon-map__source {
      grid-column: 2;
    }
  }
</style>
