---
/**
 * I4: the proposed semantic icon map. The table is drawn from the same data the other
 * questions use, so every name shown here is one a component on this board asked for.
 */
import BoardQuestion, { type BoardOption } from './BoardQuestion.astro'
import BoardCell from './BoardCell.astro'
import BoardIcon from './BoardIcon.astro'
import { ICON_MAP, mapIcon, type IconGroup } from './icon-map'

const OPTIONS: readonly BoardOption[] = [
  {
    key: 'A',
    label: 'Jedna mapa z nazwami znaczeń',
    consequence:
      'Komponent prosi o „date” albo „email”, a jeden plik mówi, który znak to rysuje. Zmiana zestawu lub wagi to edycja jednego pliku; test pilnuje, że nikt nie ładuje ikon inaczej.',
  },
  {
    key: 'B',
    label: 'Nazwy z zestawu, jak dziś',
    consequence:
      'W kodzie zostają nazwy typu „calendar-blank” i „hard-drives” plus lista aliasów. Działa, ale każda zmiana zestawu oznacza przepisywanie nazw w wielu plikach.',
  },
]

const GROUPS = [...new Set(ICON_MAP.map((entry) => entry.group))] as IconGroup[]
const SAMPLE_SIZE = 20

const RULES = [
  'Jeden plik mapy (propozycja: src/lib/icons/icon-map.ts): nasza nazwa, znaczenie, znak w zestawie.',
  'SiteIcon przyjmuje wyłącznie nazwy z mapy; literówka nie przechodzi kompilacji TypeScript.',
  'Wagę i rozmiar wybiera miejsce użycia (stopka, tło karty, meta, przycisk, menu), nie autor komponentu.',
  'Test blokuje: import astro-icon i wstawiony ręcznie znacznik svg poza SiteIcon i TechIcon, nazwę spoza mapy oraz wpis mapy, którego nikt nie używa.',
  'Loga technologii zostają osobno w TechIcon (Simple Icons).',
]
---

<BoardQuestion
  id="I4"
  question="Czy ikony mają mieć jedną mapę, w której nasze nazwy opisują znaczenie?"
  options={OPTIONS}
  recommendation="A. To spełnia zasadę jednego źródła prawdy: nazwy mówią, co ikona znaczy, a wybór z I1 wpisuje się w jednym miejscu."
  columns={1}
>
  <BoardCell wide heading="Proponowane nazwy (kolumny: Phosphor Regular i Lucide, oba po 20 px)">
    <div class="icon-map">
      {
        GROUPS.map((group) => (
          <section class="icon-map__group">
            <h3 class="icon-map__group-title">{group}</h3>
            <ul class="icon-map__rows">
              {ICON_MAP.filter((entry) => entry.group === group).map((entry) => (
                <li class="icon-map__row">
                  <span class="icon-map__glyphs">
                    <BoardIcon
                      spec={mapIcon(entry.name, 'ph', { weight: 'regular', size: SAMPLE_SIZE })}
                    />
                    <BoardIcon
                      spec={mapIcon(entry.name, 'lucide', { stroke: 1.25, size: SAMPLE_SIZE })}
                    />
                  </span>
                  <code class="icon-map__name">{entry.name}</code>
                  <span class="icon-map__meaning">{entry.meaning}</span>
                  <span class="icon-map__source">
                    {entry.ph} / {entry.lucide}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </BoardCell>
  <BoardCell wide heading="Zasady, które pilnują jednego źródła">
    <ol class="icon-map__rules">
      {RULES.map((rule) => <li>{rule}</li>)}
    </ol>
  </BoardCell>
</BoardQuestion>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .icon-map {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 3rem;

    @include medium {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .icon-map__group-title {
    margin-bottom: 0.5rem;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .icon-map__row {
    display: grid;
    grid-template-columns: 3.5rem 9.5rem minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    min-height: 2.25rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .icon-map__glyphs {
    display: inline-flex;
    gap: 0.75rem;
    color: var(--color-text);
  }

  .icon-map__name {
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .icon-map__source {
    color: var(--color-text-subtle);
    overflow-wrap: anywhere;
  }

  .icon-map__rules {
    display: grid;
    gap: 0.5rem;
    max-width: 90ch;
    padding-left: 1.25rem;
    list-style: decimal;
    color: var(--color-text-secondary);
  }

  @include mobile {
    .icon-map__row {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      row-gap: 0;
      padding-block: 0.375rem;
    }

    .icon-map__meaning,
    .icon-map__source {
      grid-column: 2;
    }
  }
</style>
