---
/**
 * I4: the proposed semantic icon map. The table is drawn from the same data the other
 * questions use, so every name shown here is one a component on this board asked for.
 */
import BoardQuestion, { type BoardOption } from './BoardQuestion.astro'
import BoardCell from './BoardCell.astro'
import BoardIcon from './BoardIcon.astro'
import type { BoardIconSpec } from './board-icons'
import { ICON_MAP, mapIcon, type IconGroup } from './icon-map'
import { formatPx, strokePx } from './stroke-math'

const OPTIONS: readonly BoardOption[] = [
  {
    key: 'A',
    label: 'Jedna mapa z nazwami znaczeń',
    consequence:
      'Komponent prosi o „date” albo „email”, a jeden plik mówi, który znak to rysuje. Zmiana zestawu lub wagi to edycja jednego pliku; test pilnuje, że nikt nie ładuje ikon inaczej.',
  },
  {
    key: 'B',
    label: 'Nazwy z zestawu, jak dziś',
    consequence:
      'W kodzie zostają nazwy typu „calendar-blank” i „hard-drives” plus lista aliasów. Działa, ale każda zmiana zestawu oznacza przepisywanie nazw w wielu plikach.',
  },
]

const GROUPS = [...new Set(ICON_MAP.map((entry) => entry.group))] as IconGroup[]
const SAMPLE_SIZE = 20

/** The glyph columns of the table, left to right. */
const COLUMNS = [
  { label: 'Phosphor Regular', note: 'lewa kolumna', set: 'ph', options: { weight: 'regular' } },
  { label: 'Phosphor Light', note: 'strona dziś', set: 'ph', options: { weight: 'light' } },
  { label: 'Lucide 1,25', note: 'odrzucone', set: 'lucide', options: { stroke: 1.25 } },
] as const

const columns = COLUMNS.map((column) => {
  const style: Omit<BoardIconSpec, 'name'> = {
    set: column.set,
    size: SAMPLE_SIZE,
    ...column.options,
  }
  return { ...column, stroke: formatPx(strokePx(style) as number) }
})

const FACTS = [
  'Lewa kolumna to Phosphor Regular, prawa to Lucide z ustawieniem kreski 1,25. Przy 20 px kreska Regular ma 1,25 px, a Lucide 1,04 px, czyli o jedną szóstą mniej.',
  'Lucide jest rysowane pod 24 px i kreskę 2. Zmniejszone i pocienione wypada między pikselami, więc szarzeje; Phosphor ma osobny rysunek dla każdej wagi.',
  'Lucide jest odrzucone decyzją właściciela i zostaje tu tylko dla porównania.',
  'Środkowa kolumna to Phosphor Light, którego strona używa dziś: 0,94 px przy 20 px, czyli jeszcze cieniej niż Lucide.',
]

const RULES = [
  'Jeden plik mapy (propozycja: src/lib/icons/icon-map.ts): nasza nazwa, znaczenie, znak w zestawie.',
  'SiteIcon przyjmuje wyłącznie nazwy z mapy; literówka nie przechodzi kompilacji TypeScript.',
  'Wagę i rozmiar wybiera jedna reguła z I1 (zapisana w mapie), nie autor komponentu.',
  'Test blokuje: import astro-icon i wstawiony ręcznie znacznik svg poza SiteIcon i TechIcon, nazwę spoza mapy oraz wpis mapy, którego nikt nie używa.',
  'Loga technologii zostają osobno w TechIcon (Simple Icons).',
]
---

<BoardQuestion
  id="I4"
  question="Czy ikony mają mieć jedną mapę, w której nasze nazwy opisują znaczenie?"
  options={OPTIONS}
  recommendation="A. To spełnia zasadę jednego źródła prawdy: nazwy mówią, co ikona znaczy, a wybór z I1 wpisuje się w jednym miejscu."
  columns={1}
>
  <BoardCell wide heading="Czym różnią się kolumny ikon">
    <div class="icon-map-facts">
      <ul class="icon-map-facts__text">
        {FACTS.map((fact) => <li>{fact}</li>)}
      </ul>
      <ol class="icon-map-facts__columns">
        {
          columns.map((column) => (
            <li>
              <BoardIcon spec={mapIcon('date', column.set, { ...column.options, size: SAMPLE_SIZE })} />
              <span>
                <span class="icon-map-facts__label">{column.label}</span>
                <span class="icon-map-facts__note">
                  {column.note} · {SAMPLE_SIZE} px · kreska {column.stroke}
                </span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </BoardCell>
  <BoardCell
    wide
    heading="Proponowane nazwy (kolumny od lewej: Phosphor Regular, Phosphor Light, Lucide; wszystkie po 20 px)"
  >
    <div class="icon-map">
      {
        GROUPS.map((group) => (
          <section class="icon-map__group">
            <h3 class="icon-map__group-title">{group}</h3>
            <ul class="icon-map__rows">
              {ICON_MAP.filter((entry) => entry.group === group).map((entry) => (
                <li class="icon-map__row">
                  <span class="icon-map__glyphs">
                    {columns.map((column) => (
                      <BoardIcon
                        spec={mapIcon(entry.name, column.set, {
                          ...column.options,
                          size: SAMPLE_SIZE,
                        })}
                      />
                    ))}
                  </span>
                  <code class="icon-map__name">{entry.name}</code>
                  <span class="icon-map__meaning">{entry.meaning}</span>
                  <span class="icon-map__source">
                    {entry.ph} / {entry.lucide}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </BoardCell>
  <BoardCell wide heading="Zasady, które pilnują jednego źródła">
    <ol class="icon-map__rules">
      {RULES.map((rule) => <li>{rule}</li>)}
    </ol>
  </BoardCell>
</BoardQuestion>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .icon-map {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 3rem;

    @include medium {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .icon-map-facts {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1.5rem 3rem;
    align-items: start;

    @include medium {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .icon-map-facts__text {
    display: grid;
    gap: 0.75rem;
    max-width: 62ch;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .icon-map-facts__columns {
    display: grid;
    gap: 0.75rem;
    color: var(--color-text);

    li {
      display: grid;
      grid-template-columns: 1.25rem minmax(0, 1fr);
      gap: 0.75rem;
      align-items: center;
    }
  }

  .icon-map-facts__label,
  .icon-map-facts__note {
    display: block;
    font-size: var(--text-sm);
  }

  .icon-map-facts__note {
    color: var(--color-text-subtle);
  }

  .icon-map__group-title {
    margin-bottom: 0.5rem;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .icon-map__row {
    display: grid;
    grid-template-columns: 5.5rem 9.5rem minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    min-height: 2.25rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .icon-map__glyphs {
    display: inline-flex;
    gap: 0.75rem;
    color: var(--color-text);
  }

  .icon-map__name {
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .icon-map__source {
    color: var(--color-text-subtle);
    overflow-wrap: anywhere;
  }

  .icon-map__rules {
    display: grid;
    gap: 0.5rem;
    max-width: 90ch;
    padding-left: 1.25rem;
    list-style: decimal;
    color: var(--color-text-secondary);
  }

  @include mobile {
    .icon-map__row {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      row-gap: 0;
      padding-block: 0.375rem;
    }

    .icon-map__meaning,
    .icon-map__source {
      grid-column: 2;
    }
  }
</style>
