---
/**
 * I1, context "footer": the real Logo with the three social marks of the real footer,
 * laid out like the footer band. Two rows: the footer today and the owner's pick, the
 * Font Awesome brand marks read from the local iconify packages.
 */
import Logo from '@/components/Logo.astro'
import BoardCell from './BoardCell.astro'
import BoardIcon from './BoardIcon.astro'
import { describeBoardIcon } from './board-icons'
import { getSystem, systemIcon } from './icon-systems'
import { CANDIDATE_SYSTEMS } from '../icon-sets/candidate-systems'

const FOOTER_LOGO_HEIGHT = 44
const SOCIAL = [
  { name: 'linkedin', label: 'LinkedIn', href: 'https://www.linkedin.com/in/zentala/' },
  { name: 'github', label: 'GitHub', href: 'https://github.com/zentala' },
  { name: 'email', label: 'Email', href: 'mailto:zentala@gmail.com' },
] as const

const ROWS = [
  { system: getSystem('B'), option: 'B · Obecnie', note: 'stała wysokość 24 px' },
  {
    system: CANDIDATE_SYSTEMS[0],
    option: 'G · Wybrane: Font Awesome',
    note: 'wysokość 0,75 logo, jak w starej stopce; znaki z lokalnej paczki, bez zestawu z CDN',
  },
]

const logoProps = {
  link: '/',
  color: '#FFFFFF',
  type: 'full',
  width: '240px',
  height: `${FOOTER_LOGO_HEIGHT}px`,
} as const
---

<BoardCell wide heading="Stopka: znaki obok logo (wybrane: powrót do Font Awesome)" />
{
  ROWS.map(({ system, option, note }) => {
    const style = system.contexts.footer
    const icons = SOCIAL.map((item) => ({
      ...item,
      spec: systemIcon(system, 'footer', item.name),
    }))
    /* The Font Awesome marks scale with the logo; the current ones are a fixed 24px. */
    const scales = style?.set === 'fa'
    return (
      <BoardCell
        wide
        option={option}
        caption={style ? `${describeBoardIcon({ ...style, name: '' })} · ${note}` : undefined}
      >
        <div class="footer-logo-social board-footer">
          <div>
            <Logo {...logoProps} />
          </div>
          <div
            class:list={['board-footer__icons', scales && 'board-footer__icons--scaled']}
            style={style ? `--icon-ratio: ${style.size / FOOTER_LOGO_HEIGHT}` : undefined}
          >
            {icons.map(
              (icon) =>
                icon.spec && (
                  <a href={icon.href} target="_blank" rel="noopener noreferrer">
                    <BoardIcon spec={icon.spec} />
                    <span class="sr-only">{icon.label}</span>
                  </a>
                ),
            )}
          </div>
        </div>
      </BoardCell>
    )
  })
}

<style lang="scss">
  .board-footer {
    padding-block: 0.5rem;
  }

  .board-footer__icons {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-text-muted);

    a {
      display: inline-flex;
      color: inherit;
      transition: color var(--motion-fast) var(--ease-standard);

      &:hover {
        color: var(--color-text);
      }
    }
  }

  .board-footer__icons--scaled {
    color: var(--color-text-secondary);

    :global(.board-icon) {
      height: calc(var(--logo-size) * var(--icon-ratio));
      width: auto;
    }
  }
</style>
