---
/**
 * I2: buttons and CTAs. Six looks, each shown as a main and a second action at rest,
 * with hover pinned, and with the real labels of /contact and of the home hero. The
 * inventory below the looks names every icon the buttons draw.
 */
import BoardQuestion from './BoardQuestion.astro'
import BoardCell from './BoardCell.astro'
import BoardButton from './BoardButton.astro'
import I2Inventory from './I2Inventory.astro'
import { BUTTON_GROUPS, LOOKS, kindFor } from './button-looks'
import { getSystem, systemIcon } from './icon-systems'
---

<BoardQuestion
  id="I2"
  question="Jak mają wyglądać przyciski i CTA?"
  options={LOOKS}
  recommendation="E. Zostaje dzisiejsza szara ramka i biały napis, bez ikony z lewej: kalendarz czy teczka nic nie dodają do napisu, a przy 20 px są nieostre. Strzałka jest biała, w wadze Regular, i rusza się na hover. Jeśli ikona ma zostać, to F: biała, 16 px, gdzie kreska ma równo 1 px. Bez niebieskiej ramki i niebieskich ikon."
  columns={2}
>
  {
    LOOKS.map((look) => {
      const system = getSystem(look.icons)
      return (
        <BoardCell option={`${look.key} · ${look.label}`}>
          {BUTTON_GROUPS.map((group) => (
            <div class="button-group">
              <p class="button-group__label">{group.label}</p>
              <div class="button-group__row">
                {group.buttons.map((sample) => (
                  <BoardButton
                    look={look.style}
                    kind={kindFor(look, group, sample)}
                    text={sample.text}
                    href={sample.href}
                    hover={group.hover}
                    icon={look.leadingIcon ? systemIcon(system, 'button', sample.icon) : null}
                    arrow={systemIcon(system, 'buttonArrow', 'arrow-next')}
                  />
                ))}
              </div>
            </div>
          ))}
        </BoardCell>
      )
    })
  }
  <I2Inventory />
</BoardQuestion>

<style>
  .button-group {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .button-group__label {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .button-group__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
</style>
