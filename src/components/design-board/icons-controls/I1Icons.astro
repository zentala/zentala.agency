---
/**
 * I1: icon style per context. Six icon systems, each shown in the six places icons
 * appear (or could appear) on the site, at their real sizes, after a note on why
 * small icons render grey.
 */
import BoardQuestion, { type BoardOption } from './BoardQuestion.astro'
import StrokeNote from './StrokeNote.astro'
import I1Footer from './I1Footer.astro'
import I1Cards from './I1Cards.astro'
import I1Inline from './I1Inline.astro'
import I1Nav from './I1Nav.astro'

const OPTIONS: readonly BoardOption[] = [
  {
    key: 'A',
    label: 'Przed zmianami',
    consequence:
      'Trzy zestawy naraz: pełne ikony Font Awesome w stopce, Lucide w przyciskach i meta, Phosphor Thin 128 px w tle kart. Mocna stopka, ale brak jednego źródła.',
  },
  {
    key: 'B',
    label: 'Obecnie',
    consequence:
      'Jeden zestaw i jedna waga (Phosphor Light) wszędzie. Spójnie, ale stopka jest słabsza od logo, a ikona na /contact skurczyła się do 40 px.',
  },
  {
    key: 'C',
    label: 'Phosphor, waga wg miejsca',
    consequence:
      'Jeden zestaw, trzy wagi: Fill 32 px w stopce, Regular w przyciskach, meta i menu, Thin 176 px w tle kart. Kreska w tle rośnie razem z ikoną.',
  },
  {
    key: 'D',
    label: 'Lucide (odrzucone)',
    consequence:
      'Właściciel odrzucił ten zestaw po przeglądzie, zwłaszcza w małych rozmiarach. Zostaje tu tylko dla porównania.',
  },
  {
    key: 'E',
    label: 'Regular w ostrych rozmiarach',
    consequence:
      'Wagę wybiera rozmiar, nie miejsce: do 32 px zawsze Regular, w tle Thin 128 px jak przed zmianami. Ikona w przycisku maleje z 20 do 16 px, bo tam kreska ma równo 1 px.',
  },
  {
    key: 'F',
    label: 'Stała kreska 1,5 px',
    consequence:
      'Waga rośnie, gdy ikona maleje: Bold przy 16 px, Regular przy 24 px, Light przy 32 px. Kreska jest wszędzie ta sama, ale małe ikony robią się ciężkie.',
  },
]
---

<BoardQuestion
  id="I1"
  question="Który zestaw ikon i jaka waga w każdym miejscu strony?"
  options={OPTIONS}
  recommendation="E. Małe ikony są szare, bo kreska Light ma przy 16 px tylko 0,75 px; Regular ma tam równo 1 px i trafia w piksele, a duże ikony w tle zostają cienkie jak przed zmianami. C różni się od E pełnymi ikonami w stopce i ikoną 20 px w przycisku, która wypada między pikselami. F ma najrówniejszą kreskę, ale Bold przy 16 px jest za ciężki dla tej strony."
  columns={3}
>
  <StrokeNote />
  <I1Footer />
  <I1Cards />
  <I1Inline />
  <I1Nav />
</BoardQuestion>
