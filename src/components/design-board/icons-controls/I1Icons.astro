---
/**
 * I1: icon set and weight per place. The picks of the first round are recorded as
 * chosen; the open part is which set and weight draw sharp small icons. Order: the
 * recorded picks, the stroke and sharpness facts, then each place and the compared sets.
 */
import BoardQuestion, { type BoardOption } from './BoardQuestion.astro'
import BoardCell from './BoardCell.astro'
import StrokeNote from './StrokeNote.astro'
import I1Footer from './I1Footer.astro'
import I1SizeRule from './I1SizeRule.astro'
import I1Meta from './I1Meta.astro'
import I1Cards from './I1Cards.astro'
import I1Sets from './I1Sets.astro'
import { ICON_PLACES } from './icon-map'
import { CANDIDATE_SYSTEMS } from '../icon-sets/candidate-systems'

const OPTIONS: readonly BoardOption[] = CANDIDATE_SYSTEMS.map((system) => ({
  key: system.key,
  label: system.label,
  consequence: system.finding,
}))

const picked = ICON_PLACES.filter((place) => place.status === 'wybrane')
---

<BoardQuestion
  id="I1"
  question="Który zestaw ikon i jaka waga w każdym miejscu strony?"
  options={OPTIONS}
  recommendation="G. Phosphor zostaje jedynym zestawem interfejsu, a wagę wybiera rozmiar: Bold przy 16–20 px, Regular przy 24 px, Light przy 32 px, Thin od 64 px. Kreska ma wtedy 1,5–1,9 px, a Bold przy 18 px wypada w pomiarze najostrzej ze skalowanych opcji (40% wobec 32% dla Lucide 2). Wyjątek: meta wpisu zostaje przy wybranym Regular 16 px. Jeśli Bold okaże się za ciężki w przyciskach, drugim wyborem jest H (Lucide 2): kreska równo 1,5 px, ale okrągły rysunek i drugi zestaw na stronie."
  columns={3}
>
  <BoardCell wide heading="Zapisane wybory z poprzedniej rundy">
    <ul class="picked">
      {
        picked.map((place) => (
          <li>
            <span class="picked__place">{place.label}</span>
            <span>{place.rule}</span>
          </li>
        ))
      }
    </ul>
  </BoardCell>
  <StrokeNote />
  <I1Footer />
  <I1SizeRule />
  <I1Meta />
  <I1Cards />
  <I1Sets />
</BoardQuestion>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .picked {
    display: grid;
    gap: 0.5rem;
    max-width: 90ch;
    color: var(--color-text-secondary);

    li {
      display: grid;
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: 1rem;
    }

    @include mobile {
      li {
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
      }
    }
  }

  .picked__place {
    color: var(--color-text);
  }
</style>
