---
/**
 * I1, context "navigation": the header links in their real type style, with an icon
 * before each label, one full-width row per icon system. A keeps today's text-only nav.
 */
import BoardCell from './BoardCell.astro'
import BoardIcon from './BoardIcon.astro'
import { describeBoardIcon } from './board-icons'
import { ICON_SYSTEMS, systemIcon } from './icon-systems'

const LINKS = [
  { href: '/', text: 'Home', icon: 'nav-home' },
  { href: '/about/capabilities', text: 'Capabilities', icon: 'nav-capabilities' },
  { href: '/portfolio', text: 'Portfolio', icon: 'nav-portfolio' },
  { href: '/blog', text: 'Blog', icon: 'nav-blog' },
  { href: '/contact', text: 'Contact', icon: 'nav-contact' },
] as const
const CURRENT = '/blog'
---

<BoardCell wide heading="Nawigacja: ikona przed nazwą (pomysł do oceny; dziś menu jest bez ikon)" />
{
  ICON_SYSTEMS.map((system) => {
    const style = system.contexts.nav
    return (
      <BoardCell
        wide
        option={`${system.key} · ${system.label}`}
        caption={style ? describeBoardIcon({ ...style, name: '' }) : 'bez ikon, jak dziś'}
      >
        <nav class="board-nav" aria-label={`Przykład nawigacji ${system.key}`}>
          {LINKS.map((link) => {
            const spec = systemIcon(system, 'nav', link.icon)
            return (
              <a href={link.href} aria-current={link.href === CURRENT ? 'page' : undefined}>
                {spec && <BoardIcon spec={spec} />}
                <span>{link.text}</span>
              </a>
            )
          })}
        </nav>
      </BoardCell>
    )
  })
}

<style lang="scss">
  .board-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    padding-block: 0.25rem;

    a {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.26rem;
      color: var(--color-text-muted);
      transition: color var(--motion-fast) var(--ease-standard);

      &:hover,
      &[aria-current='page'] {
        color: var(--color-text);
      }
    }
  }
</style>
