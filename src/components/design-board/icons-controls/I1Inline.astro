---
/**
 * I1, contexts "post meta row" and "icons inside buttons": small inline icons next to
 * text, with a real post and the real button labels, one cell per icon system.
 */
import BoardCell from './BoardCell.astro'
import BoardIcon from './BoardIcon.astro'
import BoardButton from './BoardButton.astro'
import { describeBoardIcon } from './board-icons'
import { ICON_SYSTEMS, systemIcon } from './icon-systems'
import { getVisiblePosts } from '@/lib/blog/visibility'
import { formatDate } from '@/lib/blog/format-date'

const posts = await getVisiblePosts()
const post = posts.find((candidate) => candidate.data.series && candidate.data.part) ?? posts[0]
const { datetime, label: dateLabel } = formatDate(post.data.date)
---

<BoardCell wide heading="Meta wpisu: część serii, data, kategoria (16 px, obok tekstu 14 px)" />
{
  ICON_SYSTEMS.map((system) => {
    const sample = systemIcon(system, 'meta', 'date')
    return (
      <BoardCell
        option={`${system.key} · ${system.label}`}
        caption={sample ? describeBoardIcon(sample) : undefined}
      >
        <p class="board-meta__title">{post.data.title}</p>
        <div class="board-meta">
          {post.data.part && (
            <span class="board-meta__item">
              <BoardIcon spec={systemIcon(system, 'meta', 'series')!} />
              Part {post.data.part}
            </span>
          )}
          <span class="board-meta__item">
            <BoardIcon spec={sample!} />
            <time datetime={datetime}>{dateLabel}</time>
          </span>
          <span class="board-meta__item">
            <BoardIcon spec={systemIcon(system, 'meta', 'tag')!} />
            {post.data.category}
          </span>
        </div>
      </BoardCell>
    )
  })
}

<BoardCell wide heading="Ikony w przyciskach (20 px z lewej, strzałka 16 px z prawej)" />
{
  ICON_SYSTEMS.map((system) => {
    const sample = systemIcon(system, 'button', 'book-call')
    const arrow = systemIcon(system, 'buttonArrow', 'arrow-next')
    return (
      <BoardCell
        option={`${system.key} · ${system.label}`}
        caption={sample ? describeBoardIcon(sample) : undefined}
      >
        <div class="board-buttons">
          <BoardButton look="C" kind="primary" text="Book a Call" icon={sample} arrow={arrow} />
          <BoardButton
            look="C"
            kind="secondary"
            text="Add on LinkedIn"
            href="https://linkedin.com/in/zentala"
            icon={systemIcon(system, 'button', 'linkedin')}
            arrow={arrow}
          />
          <BoardButton
            look="C"
            kind="secondary"
            text="Send message"
            href="/contact#write"
            icon={systemIcon(system, 'button', 'send')}
            arrow={arrow}
          />
        </div>
      </BoardCell>
    )
  })
}

<style>
  .board-meta__title {
    font-size: var(--text-h4);
    line-height: 1.3;
    color: var(--color-text);
  }

  .board-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .board-meta__item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .board-buttons {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
</style>
