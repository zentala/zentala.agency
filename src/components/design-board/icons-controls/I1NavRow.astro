---
/**
 * I1 sample: the header links in their real type style with an icon before each label,
 * in one icon style.
 */
import BoardIcon from './BoardIcon.astro'
import type { BoardIconSpec } from './board-icons'
import { mapIcon } from './icon-map'

interface Props {
  style: Omit<BoardIconSpec, 'name'>
  label: string
}

const { style, label } = Astro.props
const { set, ...options } = style

const LINKS = [
  { href: '/', text: 'Home', icon: 'nav-home' },
  { href: '/about/capabilities', text: 'Capabilities', icon: 'nav-capabilities' },
  { href: '/portfolio', text: 'Portfolio', icon: 'nav-portfolio' },
  { href: '/blog', text: 'Blog', icon: 'nav-blog' },
  { href: '/contact', text: 'Contact', icon: 'nav-contact' },
] as const
const CURRENT = '/blog'
---

<nav class="nav-row" aria-label={label}>
  {
    LINKS.map((link) => (
      <a href={link.href} aria-current={link.href === CURRENT ? 'page' : undefined}>
        <BoardIcon spec={mapIcon(link.icon, set, options)} />
        <span>{link.text}</span>
      </a>
    ))
  }
</nav>

<style lang="scss">
  .nav-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    padding-block: 0.25rem;

    a {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.26rem;
      color: var(--color-text-muted);
      transition: color var(--motion-fast) var(--ease-standard);

      &:hover,
      &[aria-current='page'] {
        color: var(--color-text);
      }
    }
  }
</style>
