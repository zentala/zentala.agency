---
/**
 * Webfonts for the typography board only. The families carry board-only names, so the
 * rest of the page keeps the real font stack of the site. The files load through
 * dynamic imports under DEV, so no font reaches a production build through this file. Noto
 * Sans and Source Sans 3 are the Latin and Latin Extended subsets of the `@fontsource-variable`
 * packages (licences beside them). "Board Open Sans" is the same static Latin files the
 * site ships as 'Open Sans Matched' (src/styles/fonts.scss), without size-adjust.
 * Selawik has no npm package, and the microsoft/Selawik repository holds no binaries (so
 * jsDelivr's GitHub CDN cannot serve it): its three static files are unmodified copies from
 * the 1.01 release zip (SIL OFL 1.1, licence beside them), loaded from this repository.
 */
const fontUrl = async (load: () => Promise<{ default: string }>) =>
  import.meta.env.DEV ? (await load()).default : ''

const LATIN_RANGE =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD'
const LATIN_EXT_RANGE =
  'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF'

const SELAWIK_FAMILY = 'Board Selawik'

const faces = [
  {
    family: 'Board Noto Sans',
    weights: '100 900',
    latin: await fontUrl(() => import('./fonts/noto-sans-latin-wght-normal.woff2?url')),
    latinExt: await fontUrl(
      () => import('./fonts/noto-sans-latin-ext-wght-normal.woff2?url'),
    ),
  },
  {
    family: 'Board Source Sans',
    weights: '200 900',
    latin: await fontUrl(
      () => import('./fonts/source-sans-3-latin-wght-normal.woff2?url'),
    ),
    latinExt: await fontUrl(
      () => import('./fonts/source-sans-3-latin-ext-wght-normal.woff2?url'),
    ),
  },
]

const staticFaces = [
  {
    family: 'Board Open Sans',
    weight: 300,
    url: await fontUrl(() => import('@fontsource/open-sans/files/open-sans-latin-300-normal.woff2?url')),
  },
  {
    family: 'Board Open Sans',
    weight: 400,
    url: await fontUrl(() => import('@fontsource/open-sans/files/open-sans-latin-400-normal.woff2?url')),
  },
  {
    family: 'Board Open Sans',
    weight: 600,
    url: await fontUrl(() => import('@fontsource/open-sans/files/open-sans-latin-600-normal.woff2?url')),
  },
  {
    family: SELAWIK_FAMILY,
    weight: 300,
    url: await fontUrl(() => import('./fonts/selawik-light.woff2?url')),
  },
  {
    family: SELAWIK_FAMILY,
    weight: 350,
    url: await fontUrl(() => import('./fonts/selawik-semilight.woff2?url')),
  },
  {
    family: SELAWIK_FAMILY,
    weight: 400,
    url: await fontUrl(() => import('./fonts/selawik-regular.woff2?url')),
  },
]

const staticFontFace = (family: string, weight: number, url: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};src:url('${url}') format('woff2');}`

const fontFace = (family: string, weights: string, url: string, range: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weights};src:url('${url}') format('woff2-variations');unicode-range:${range};}`

const css = faces
  .filter((face) => face.latin)
  .flatMap((face) => [
    fontFace(face.family, face.weights, face.latin, LATIN_RANGE),
    fontFace(face.family, face.weights, face.latinExt, LATIN_EXT_RANGE),
  ])
  .concat(
    staticFaces
      .filter((face) => face.url)
      .map((face) => staticFontFace(face.family, face.weight, face.url)),
  )
  .join('\n')
---

<style is:inline set:html={css}></style>
