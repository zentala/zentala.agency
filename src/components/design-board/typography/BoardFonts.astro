---
/**
 * Webfonts for the typography board only. The families carry board-only names, so the
 * rest of the page keeps the site's real font stack. The files load through dynamic
 * imports under DEV, so no font reaches a production build.
 */
const fontUrl = async (load: () => Promise<{ default: string }>) =>
  import.meta.env.DEV ? (await load()).default : ''

const LATIN_RANGE =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD'
const LATIN_EXT_RANGE =
  'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF'

const faces = [
  {
    family: 'Board Inter',
    range: LATIN_RANGE,
    /* The opsz file carries both axes: weight 100-900 and optical size 14-32. */
    url: await fontUrl(
      () =>
        import(
          '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url'
        ),
    ),
  },
  {
    family: 'Board Inter',
    range: LATIN_EXT_RANGE,
    url: await fontUrl(
      () =>
        import(
          '@fontsource-variable/inter/files/inter-latin-ext-opsz-normal.woff2?url'
        ),
    ),
  },
  {
    family: 'Board Geist',
    range: LATIN_RANGE,
    url: await fontUrl(
      () => import('./fonts/geist-latin-wght-normal.woff2?url'),
    ),
  },
  {
    family: 'Board Geist',
    range: LATIN_EXT_RANGE,
    url: await fontUrl(
      () => import('./fonts/geist-latin-ext-wght-normal.woff2?url'),
    ),
  },
]

const css = faces
  .filter((face) => face.url)
  .map(
    (face) =>
      `@font-face{font-family:'${face.family}';font-style:normal;font-display:swap;font-weight:100 900;src:url('${face.url}') format('woff2-variations');unicode-range:${face.range};}`,
  )
  .join('\n')
---

<style is:inline set:html={css}></style>
