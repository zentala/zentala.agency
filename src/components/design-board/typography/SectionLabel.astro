---
/**
 * Compact section header candidates: a section name on the left and a grey note on
 * the right, on one line. `caps` is a small tracked label, `thin` a larger light
 * muted one, `on-line` sits on the section line itself and takes no height, and
 * `thin-roomy` is `thin` with top padding at three quarters of the side padding.
 */
export type SectionLabelVariant = 'caps' | 'thin' | 'on-line' | 'thin-roomy'

interface Props {
  variant: SectionLabelVariant
  label: string
  note?: string
}

const { variant, label, note } = Astro.props
---

<div class="section-label" data-variant={variant} data-tb-cost>
  <h3 class="section-label__name">{label}</h3>
  {note && <p class="section-label__note">{note}</p>}
</div>

<style lang="scss">
  @use '../../../styles/variables' as *;

  $roomy-ratio: 0.75;

  .section-label {
    @include px-responsive('md');
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.125rem 1.5rem;
    border-bottom: 1px solid $border-color;
  }

  .section-label__note {
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--color-text-subtle);
  }

  .section-label[data-variant='caps'] {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;

    .section-label__name {
      font-size: 0.875rem;
      font-weight: 400;
      line-height: 1.25rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-text-secondary);
    }
  }

  .section-label[data-variant='thin'] {
    padding-top: 1.125rem;
    padding-bottom: 1.125rem;
  }

  /* Top and bottom are 0.75 of the side padding (64, 48, 32, 24, 16 px). */
  .section-label[data-variant='thin-roomy'] {
    padding-top: $spacing-desktop * $roomy-ratio;
    padding-bottom: $spacing-desktop * $roomy-ratio;

    @include large {
      padding-top: $spacing-large * $roomy-ratio;
      padding-bottom: $spacing-large * $roomy-ratio;
    }

    @include medium {
      padding-top: $spacing-medium * $roomy-ratio;
      padding-bottom: $spacing-medium * $roomy-ratio;
    }

    @include tablet {
      padding-top: $spacing-tablet * $roomy-ratio;
      padding-bottom: $spacing-tablet * $roomy-ratio;
    }

    @include mobile {
      padding-top: $spacing-mobile * $roomy-ratio;
      padding-bottom: $spacing-mobile * $roomy-ratio;
    }
  }

  .section-label[data-variant='thin'],
  .section-label[data-variant='thin-roomy'] {
    .section-label__name {
      font-size: 1.625rem;
      font-weight: 300;
      line-height: 2rem;
      letter-spacing: -0.01em;
      color: var(--color-text-muted);
    }
  }

  /* Zero height: both texts are centred on the line above and interrupt it. */
  .section-label[data-variant='on-line'] {
    position: relative;
    z-index: 3;
    flex-wrap: nowrap;
    align-items: center;
    height: 0;
    border-bottom: 0;

    .section-label__name,
    .section-label__note {
      margin-inline: -0.75rem;
      padding-inline: 0.75rem;
      background-color: var(--color-surface);
      line-height: 1.25rem;
    }

    .section-label__name {
      font-size: 0.875rem;
      font-weight: 400;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-text-secondary);
    }
  }

  @include mobile {
    .section-label[data-variant='on-line'] .section-label__note {
      display: none;
    }
  }
</style>
