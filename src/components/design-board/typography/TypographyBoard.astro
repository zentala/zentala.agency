---
/**
 * Design board, group "typography and compact headers" (dev only): T1 (typeface and
 * scale as combinations), T3 (site header) and T4 (section header variants), each
 * rendered on real site content. Nothing here changes the site by default.
 */
import BoardFonts from './BoardFonts.astro'
import T1Typeface from './T1Typeface.astro'
import T3Header from './T3Header.astro'
import T4SectionHeaders from './T4SectionHeaders.astro'
import { loadTypographySamples } from './data'

const samples = await loadTypographySamples()
---

<BoardFonts />
<T1Typeface samples={samples} />
<T3Header samples={samples} />
<T4SectionHeaders samples={samples} />
