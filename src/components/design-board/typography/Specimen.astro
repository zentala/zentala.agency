---
/**
 * Real content in one type system: page title, section header, article paragraph, post
 * card with meta. `current` repeats today's Hero, SectionHeader, prose-blog and PostCard
 * values; `proposal` and `light` are candidates. Font: `--tb-font` of an ancestor.
 */
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import { formatDate } from '@/lib/blog/format-date'
import type { TypographySamples } from './data'

export type SpecimenScale = 'current' | 'proposal' | 'light'

interface Props {
  scale?: SpecimenScale
  samples: TypographySamples
}

const { scale = 'current', samples } = Astro.props
const { post, partLabel } = samples.posts[0]
const date = formatDate(post.data.date)
---

<div class="specimen" data-scale={scale}>
  <div class="specimen__hero">
    <p class="specimen__display">{samples.hero.title}</p>
    <p class="specimen__sub">{samples.hero.subtitle}</p>
  </div>
  <div class="line-grid">
    <div class="specimen__cell">
      <p class="specimen__label">Series</p>
      <h3 class="specimen__h2">{samples.series.title}</h3>
      <p class="specimen__lead">{samples.series.tagline}</p>
    </div>
    <div class="specimen__cell">
      <p class="specimen__prose">{samples.paragraph}</p>
    </div>
    <div class="specimen__cell">
      <h3 class="specimen__h3">{post.data.title}</h3>
      <p class="specimen__meta">
        <span><SiteIcon name="layers" size="sm" />{partLabel}</span>
        <span>
          <SiteIcon name="calendar" size="sm" />
          <time datetime={date.datetime}>{date.label}</time>
        </span>
        <span><SiteIcon name="tag" size="sm" />{post.data.category}</span>
      </p>
      <p class="specimen__body">{post.data.excerpt}</p>
    </div>
  </div>
</div>

<style lang="scss">
  @use '../../../styles/variables' as *;

  /* Today: Hero 36 to 96px at 300, SectionHeader 30/36px, prose 18/20px, card 24px and 18/24px. */
  .specimen {
    --display-size: 2.25rem;
    --display-weight: 300;
    --display-leading: 1.25;
    --sub-size: 1.25rem;
    --sub-weight: 300;
    --h2-size: 1.875rem;
    --h2-weight: 300;
    --h2-leading: 1.2;
    --lead-size: 1.125rem;
    --lead-leading: 1.75rem;
    --h3-size: 1.5rem;
    --h3-weight: 300;
    --h3-leading: 1.5;
    --body-size: 1.125rem;
    --body-leading: 1.5rem;
    --body-weight: 400;
    --prose-size: 1.125rem;
    --prose-leading: 1.625;
    --meta-size: 0.875rem;
    --label-size: var(--text-label);
    --label-track: var(--tracking-label);
    --label-weight: 500;

    font-family: var(--tb-font, inherit);
    color: var(--color-text);

    @media (min-width: 640px) {
      --display-size: 3rem;
      --display-leading: 1;
      --sub-size: 1.5rem;
    }
    @media (min-width: 771px) {
      --display-size: 3.75rem;
      --sub-size: 1.875rem;
      --h2-size: 2.25rem;
      --h2-leading: 1.11;
      --prose-size: 1.25rem;
      --prose-leading: 1.7;
    }
    @media (min-width: 1280px) {
      --display-size: 4.5rem;
      --sub-size: 2.25rem;
    }
    @media (min-width: 1536px) {
      --display-size: 6rem;
    }
  }

  /* Proposal: one scale near 1.25, light only from 32px up, small text never below 400. */
  .specimen[data-scale='proposal'] {
    --display-size: clamp(2.5rem, 4.4vw, 4.5rem);
    --display-leading: 1.05;
    --display-track: -0.025em;
    --sub-size: clamp(1.125rem, 1.5vw, 1.5rem);
    --sub-weight: 400;
    --h2-size: clamp(1.75rem, 2.2vw, 2rem);
    --h2-leading: 1.2;
    --h2-track: -0.015em;
    --lead-size: 1rem;
    --lead-leading: 1.6;
    --h3-size: 1.375rem;
    --h3-weight: 400;
    --h3-leading: 1.3;
    --h3-track: -0.01em;
    --body-size: 1rem;
    --body-leading: 1.6;
    --prose-size: 1.125rem;
    --prose-leading: 1.7;
    --meta-size: 0.8125rem;
    --label-size: 0.75rem;
    --label-track: 0.08em;
  }

  /* Lighter: one weight step down everywhere, one size step up to keep it readable. */
  .specimen[data-scale='light'] {
    --display-size: clamp(2.75rem, 4.8vw, 5rem);
    --display-weight: 200;
    --display-leading: 1.05;
    --display-track: -0.02em;
    --sub-size: clamp(1.25rem, 1.6vw, 1.625rem);
    --sub-weight: 300;
    --h2-size: clamp(1.875rem, 2.4vw, 2.25rem);
    --h2-weight: 200;
    --h2-leading: 1.2;
    --h2-track: -0.01em;
    --lead-size: 1.0625rem;
    --lead-leading: 1.65;
    --h3-size: 1.5rem;
    --h3-weight: 300;
    --h3-leading: 1.3;
    --body-size: 1.0625rem;
    --body-leading: 1.65;
    --body-weight: 300;
    --prose-size: 1.1875rem;
    --prose-leading: 1.7;
    --meta-size: 0.8125rem;
    --label-size: 0.75rem;
    --label-track: 0.08em;
    --label-weight: 400;
  }

  .specimen__hero,
  .specimen__cell {
    @include px-responsive('md');
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .specimen__hero {
    text-align: center;
  }

  .specimen__display {
    font-size: var(--display-size);
    font-weight: var(--display-weight);
    line-height: var(--display-leading);
    letter-spacing: var(--display-track, 0);
  }

  .specimen__sub {
    margin-top: 1.5rem;
    font-size: var(--sub-size);
    font-weight: var(--sub-weight);
    line-height: 1.3;
    color: var(--color-text-secondary);
  }

  .specimen__cell {
    min-width: 0;
  }

  .specimen__label {
    margin-bottom: 0.75rem;
    font-size: var(--label-size);
    font-weight: var(--label-weight);
    letter-spacing: var(--label-track);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .specimen__h2 {
    font-size: var(--h2-size);
    font-weight: var(--h2-weight);
    line-height: var(--h2-leading);
    letter-spacing: var(--h2-track, 0);
  }

  .specimen__lead {
    margin-top: 1rem;
    font-size: var(--lead-size);
    font-weight: var(--body-weight);
    line-height: var(--lead-leading);
    color: var(--color-text-secondary);
  }

  .specimen__prose {
    font-size: var(--prose-size);
    font-weight: var(--body-weight);
    line-height: var(--prose-leading);
    color: var(--color-text-secondary);
  }

  .specimen__h3 {
    font-size: var(--h3-size);
    font-weight: var(--h3-weight);
    line-height: var(--h3-leading);
    letter-spacing: var(--h3-track, 0);
  }

  .specimen__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: 0.5rem;
    font-size: var(--meta-size);
    font-weight: var(--body-weight);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-subtle);
  }

  .specimen__meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .specimen__body {
    margin-top: 1.25rem;
    font-size: var(--body-size);
    font-weight: var(--body-weight);
    line-height: var(--body-leading);
    color: var(--color-text-secondary);
  }
</style>
