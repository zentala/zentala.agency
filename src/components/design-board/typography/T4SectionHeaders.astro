---
/**
 * T4: the four section header variants of the one SectionHeader component, each with
 * an icon and a note on the right, above the same three real post cards (cropped).
 * The measured height shows what each costs before content starts.
 */
import PostCard from '@/components/cards/PostCard.astro'
import SectionHeader from '@/components/primitives/sections/SectionHeader.astro'
import OptionStrip from './OptionStrip.astro'
import TypeQuestion from './TypeQuestion.astro'
import type { TypographySamples } from './data'

interface Props {
  samples: TypographySamples
}

const { samples } = Astro.props
const { series, posts } = samples
const SECTION_ICON = 'stack'

const options: {
  key: string
  label: string
  consequence: string
  facts: string
  variant: 'a' | 'b' | 'c' | 'd'
}[] = [
  {
    key: 'A',
    label: 'Obecny, z ikoną i notką po prawej',
    consequence:
      'Duży tytuł z podtytułem i pełnym odstępem: najwyraźniejszy, ale zabiera najwięcej wysokości, zanim zacznie się treść. Nowe: mała ikona przed tytułem i notka po prawej.',
    facts: 'tytuł 36 px · 300 · ikona 24 px · podtytuł 18 px',
    variant: 'a',
  },
  {
    key: 'B',
    label: 'Mała etykieta wersalikami',
    consequence:
      'Najniższa zwykła belka. Spokojna, ale nazwę sekcji słabiej widać przy szybkim przewijaniu. Podtytuł schodzi do małej szarej linii.',
    facts: 'etykieta 14 px · 400 · 0,14 em · ikona 16 px',
    variant: 'b',
  },
  {
    key: 'C',
    label: 'Cienka większa etykieta',
    consequence:
      'Nazwa sekcji dalej wygląda jak tytuł, tylko cienki i przygaszony. Dużo niższa od obecnej; podtytuł schodzi do małej szarej linii.',
    facts: 'etykieta 26 px · 300 · przygaszona · ikona 24 px',
    variant: 'c',
  },
  {
    key: 'D',
    label: 'Etykieta na linii sekcji',
    consequence:
      'Nazwa i notka siedzą na samej linii siatki i nie zabierają wysokości. Przerywają linię, podtytuł znika, a tuż pod nagłówkiem strony górna połowa napisu chowa się pod belką.',
    facts: 'etykieta 14 px · 400 · 0,14 em · ikona 16 px · na linii',
    variant: 'd',
  },
]
---

<TypeQuestion
  id="T4"
  question="Nagłówek sekcji: cztery warianty jednego komponentu"
  options={options}
  recommendation="C jako domyślny dla zwykłych sekcji, A dla sekcji otwierających stronę sprzedażową (tam mało treści ma dostać dużo miejsca), B dla drugiego poziomu. D zostawiłbym na listy, gdzie liczy się każdy piksel wysokości."
  note="Wszystkie cztery to teraz jeden komponent SectionHeader z ustawieniem wariantu. Na prawdziwych stronach przełączysz je przyciskiem Warianty w lewym dolnym rogu (wiersz Nagłówek sekcji): najwięcej widać na /about/capabilities/backstage (8 nagłówków), stronach serii i kategorii oraz /contact. Strony /blog, /portfolio i /about/capabilities nie mają dziś żadnego nagłówka sekcji, a strona główna tylko jeden, w bloku z przyciskami na dole. Liczba po prawej to zmierzona wysokość nagłówka; karty pod spodem są przycięte."
>
  {
    options.map((option) => (
      <OptionStrip
        optionKey={option.key}
        label={option.label}
        facts={option.facts}
        measure="wysokość nagłówka sekcji"
      >
        {option.variant === 'd' && <div class="t4-previous" />}
        <div data-tb-cost>
          <SectionHeader
            variant={option.variant}
            tag="h3"
            headline={series.title}
            subhead={series.tagline}
            labelIcon={SECTION_ICON}
            meta={series.note}
          />
        </div>
        <div class="t4-crop">
          <div class="line-grid">
            {posts.map(({ post, partLabel }) => (
              <PostCard
                title={post.data.title}
                date={post.data.date}
                category={post.data.category}
                excerpt={post.data.excerpt}
                link={`/blog/${post.slug}`}
                partLabel={partLabel}
              />
            ))}
          </div>
        </div>
      </OptionStrip>
    ))
  }
</TypeQuestion>

<style lang="scss">
  @use '../../../styles/variables' as *;

  /* The end of the section above, so the label has a line to sit on. */
  .t4-previous {
    height: 2rem;
    border-bottom: 1px solid $border-color;
  }

  /* The 1px top padding keeps the grid's own top line inside the clip. */
  .t4-crop {
    position: relative;
    max-height: 17rem;
    margin-top: -1px;
    padding-top: 1px;
    overflow-y: clip;
  }

  /* Fades the cut edge so the crop reads as a crop, not as broken text. */
  .t4-crop::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: 11;
    height: 4rem;
    background: linear-gradient(to bottom, transparent, var(--color-surface));
    pointer-events: none;
  }

  @include tablet {
    .t4-crop {
      max-height: 26rem;
    }
  }
</style>
