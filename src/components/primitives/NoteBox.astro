---
import SiteIcon from '@/components/primitives/SiteIcon.astro'

/**
 * A quiet aside. Neutral for every variant: the variant changes only the thin
 * glyph and the label word, never the colour.
 */
interface Props {
  icon?: string // short SiteIcon name; overrides the variant's glyph
  title?: string
  variant?: 'default' | 'info' | 'success' | 'warning'
}

const VARIANT_ICON = {
  default: 'lightbulb',
  info: 'info',
  success: 'check-circle',
  warning: 'warning',
} as const

const { icon, title, variant = 'default' } = Astro.props
const glyph = icon ?? VARIANT_ICON[variant]
---

<div class={`note-box note-box--${variant}`}>
  <SiteIcon name={glyph} size="md" class="note-box__icon" />
  <div class="note-box__content">
    {title && <p class="note-box__title">{title}</p>}
    <slot />
  </div>
</div>

<style lang="scss">
  @use '../../styles/variables' as *;

  .note-box {
    max-width: 900px;
    margin: 3rem auto 2rem;
    padding: 1.5rem 2rem;
    border-left: 1px solid var(--color-line-strong);
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;

    @include mobile {
      margin: 2rem auto 1.5rem;
      padding: 1.25rem 1.5rem;
      gap: 1rem;
    }

    &__icon {
      flex-shrink: 0;
      margin-top: 0.2rem;
      color: var(--color-text-subtle);
    }

    &__content {
      flex: 1;
      color: var(--color-text-secondary);

      p {
        font-size: 1rem;
        line-height: 1.6;
        color: var(--color-text-secondary);
        margin: 0;
        text-align: left;
      }

      strong {
        font-weight: 500;
        color: var(--color-text);
      }
    }

    &__title {
      display: block;
      color: var(--color-text-muted);
      font-size: var(--text-label);
      font-weight: 400;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      margin: 0 0 0.5rem;
    }
  }
</style>
