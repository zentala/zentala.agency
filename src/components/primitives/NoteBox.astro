---
import { Icon } from 'astro-icon/components'

interface Props {
  icon?: string // Lucide icon name (without 'lucide:' prefix)
  title?: string
  variant?: 'default' | 'info' | 'success' | 'warning'
}

const { icon = 'lightbulb', title, variant = 'default' } = Astro.props
---

<div class={`note-box note-box--${variant}`}>
  <Icon name={`lucide:${icon}`} class="note-box__icon" />
  <div class="note-box__content">
    {title && <strong class="note-box__title">{title}</strong>}
    <slot />
  </div>
</div>

<style lang="scss">
  @use '../../styles/variables' as *;

  .note-box {
    --note-accent: var(--color-accent);
    max-width: 900px;
    margin: 3rem auto 2rem;
    padding: 2rem;
    background: color-mix(in srgb, var(--color-line) 30%, transparent);
    border-left: 3px solid var(--note-accent);
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;

    @include mobile {
      flex-direction: column;
      margin: 2rem auto 1.5rem;
      padding: 1.5rem;
      gap: 1rem;
      align-items: center;
    }

    &__icon {
      flex-shrink: 0;
      color: var(--note-accent);
      width: 24px;
      height: 24px;
      stroke-width: 1;

      @include mobile {
        width: 20px;
        height: 20px;
      }
    }

    &__content {
      flex: 1;
      color: var(--color-text-secondary);

      p {
        font-size: 1.125rem;
        line-height: 1.6;
        color: var(--color-text-secondary);
        margin: 0;
        text-align: left;

        strong {
          color: var(--color-text);
        }

        @include mobile {
          font-size: 1rem;
          text-align: center;
        }
      }
    }

    &__title {
      display: block;
      color: var(--note-accent);
      font-size: 1.125rem;
      margin-bottom: 0.5rem;
    }

    &--success {
      --note-accent: var(--color-success);
    }

    &--warning {
      --note-accent: var(--color-warn);
    }
  }
</style>
