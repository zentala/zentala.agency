---
/**
 * Generated card artwork (DESIGN.md F3-E, DB-8): a 3x3 mosaic of portfolio areas for tiles
 * that have no photograph worth showing. Each tile is a Phosphor Light icon (32 px) in a 1 px
 * frame at about 4.5% white. A 45-degree wave shades the tiles: the tone peaks on the middle
 * diagonal and each tile differs a little. A tile lightens on its own hover and its label shows
 * under the mosaic. The mosaic fades out downward so the caption below sits on clean black.
 *
 * The mosaic lets no pointer through except on the tiles: a caption laid over it must set
 * `pointer-events: none` for the tile hover to reach them.
 */
import SiteIcon from '@/components/primitives/SiteIcon.astro'

export interface MosaicTile {
  /** Icon meaning from the icon map, e.g. `ai-agent`. */
  icon: string
  /** Portfolio area, shown under the mosaic while the tile is hovered. */
  label: string
}

export interface Props {
  /** Nine tiles, row by row. */
  tiles: MosaicTile[]
  class?: string
}

const { tiles, class: className = '' } = Astro.props
const COLUMNS = 3
const TILE_ICON_PX = 32

/** Tone in % of white: low in the corners, highest on the middle diagonal, plus a small step per tile. */
function tone(index: number): string {
  const diagonal = Math.floor(index / COLUMNS) + (index % COLUMNS)
  const wave = 0.5 + 0.5 * Math.sin((diagonal / 4) * 2 * Math.PI - Math.PI / 2)
  return `${(2.3 + 3.8 * wave + (index % COLUMNS) * 0.35).toFixed(2)}%`
}
---

<div class={`mosaic ${className}`} aria-hidden="true">
  <div class="mosaic__grid">
    {
      tiles.map((tile, index) => (
        <span class="mosaic__tile" style={`--tone: ${tone(index)}`}>
          <SiteIcon name={tile.icon} size={TILE_ICON_PX} />
          <span class="mosaic__label">{tile.label}</span>
        </span>
      ))
    }
  </div>
</div>

<style>
  .mosaic {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 58%, transparent 92%);
    mask-image: linear-gradient(to bottom, black 0%, black 58%, transparent 92%);
  }

  /* The grid is the positioning parent of the labels, so a label sits under the whole mosaic. */
  .mosaic__grid {
    --tile: 5rem;
    --gap: 0.5rem;
    position: absolute;
    left: 50%;
    top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(3, var(--tile));
    gap: var(--gap);
    transform: translateX(-50%);
  }

  .mosaic__tile {
    display: grid;
    place-items: center;
    height: var(--tile);
    border: 1px solid color-mix(in srgb, var(--color-text) 4.5%, transparent);
    color: var(--color-text-muted);
    background-color: color-mix(in srgb, var(--color-text) var(--tone), transparent);
    background-image: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-text) 3%, transparent),
      transparent 70%
    );
    pointer-events: auto;
    transition:
      background-color var(--motion-base) var(--ease-standard),
      border-color var(--motion-base) var(--ease-standard),
      color var(--motion-base) var(--ease-standard);
  }

  .mosaic__label {
    position: absolute;
    top: calc(100% + 0.875rem);
    left: -2rem;
    right: -2rem;
    color: var(--color-text-secondary);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-align: center;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity var(--motion-base) var(--ease-standard);
  }

  :global(.group):hover .mosaic__tile {
    color: var(--color-text-secondary);
  }

  .mosaic .mosaic__tile:hover {
    border-color: color-mix(in srgb, var(--color-text) 14%, transparent);
    color: var(--color-text);
    background-color: color-mix(in srgb, var(--color-text) calc(var(--tone) + 5%), transparent);
  }

  .mosaic__tile:hover .mosaic__label {
    opacity: 1;
  }

  @media (max-width: 770px) {
    .mosaic__grid {
      --tile: 4.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mosaic__tile,
    .mosaic__label {
      transition: none;
    }
  }
</style>
