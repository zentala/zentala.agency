---
/**
 * Generated card artwork: a dot grid, a soft glow, and a mosaic of icons that
 * drift slowly. Built for tiles that have no photograph worth showing — it
 * fills the upper part of a card and leaves the lower part to the caption.
 *
 * Monochrome on purpose: the grid it sits in is black with gray-800 borders,
 * and a coloured plate would fight it.
 */
import { Icon } from 'astro-icon/components'

export interface Props {
  /** Iconify names, e.g. `lucide:bot`. Four reads best; more still tiles. */
  icons: string[]
  class?: string
}

const { icons, class: className = '' } = Astro.props
---

<div class={`mosaic ${className}`} aria-hidden="true">
  <div class="mosaic__glow"></div>
  <div class="mosaic__grid">
    {
      icons.map((name, i) => (
        <span class="mosaic__cell" style={`--i: ${i}`}>
          <Icon name={name} class="mosaic__icon" />
        </span>
      ))
    }
  </div>
</div>

<style>
  .mosaic {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Dot grid. Fades out downward so the caption below sits on clean black. */
    background-image: radial-gradient(
      circle at center,
      rgba(255, 255, 255, 0.14) 1px,
      transparent 1px
    );
    background-size: 22px 22px;
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 45%,
      transparent 88%
    );
    mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 88%);
  }

  .mosaic__glow {
    position: absolute;
    left: 50%;
    top: 18%;
    width: 130%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle,
      rgba(148, 163, 184, 0.3) 0%,
      rgba(148, 163, 184, 0.09) 42%,
      transparent 68%
    );
    transition: opacity 700ms ease;
    opacity: 0.7;
  }

  .mosaic__grid {
    position: absolute;
    left: 50%;
    top: 30%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
    /* The whole group floats as one. Per-cell vertical drift was tried and
       rejected: it breaks the 2x2 alignment in every frame, so a still of the
       page reads as a misaligned grid rather than as motion. */
    animation: mosaic-float 11s ease-in-out infinite;
  }

  @keyframes mosaic-float {
    0%,
    100% {
      transform: translate(-50%, -50%);
    }
    50% {
      transform: translate(-50%, calc(-50% - 7px));
    }
  }

  .mosaic__cell {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(2px);
    color: rgba(255, 255, 255, 0.72);
    /* Only the glow breathes per cell — never the position. Staggered so the
       four never pulse in unison. */
    animation: mosaic-breathe 9s ease-in-out infinite;
    animation-delay: calc(var(--i) * -2.2s);
    transition:
      border-color 500ms ease,
      color 500ms ease;
  }

  .mosaic__cell :global(.mosaic__icon) {
    width: 1.6rem;
    height: 1.6rem;
  }

  @keyframes mosaic-breathe {
    0%,
    100% {
      opacity: 0.62;
    }
    50% {
      opacity: 1;
    }
  }

  /* Hover state is driven by the card wrapping this. */
  :global(.group):hover .mosaic__glow {
    opacity: 1;
  }
  :global(.group):hover .mosaic__cell {
    border-color: rgba(255, 255, 255, 0.28);
    color: #fff;
  }

  @media (max-width: 770px) {
    .mosaic__cell {
      width: 3rem;
      height: 3rem;
    }
    .mosaic__cell :global(.mosaic__icon) {
      width: 1.3rem;
      height: 1.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mosaic__grid {
      animation: none;
      transform: translate(-50%, -50%);
    }
    .mosaic__cell {
      animation: none;
      opacity: 0.9;
    }
  }
</style>
