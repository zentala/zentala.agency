---
/**
 * Generated card artwork: a faint glow and a mosaic of thin icons that drift
 * very slowly. Built for tiles that have no photograph worth showing — it
 * fills the upper part of a card and leaves the lower part to the caption.
 *
 * Monochrome on purpose: the grid it sits in is black with gray-800 borders,
 * and a coloured plate would fight it.
 */
import SiteIcon from '@/components/primitives/SiteIcon.astro'

export interface Props {
  /** Short SiteIcon names, e.g. `robot`. Four reads best; more still tiles. */
  icons: string[]
  class?: string
}

const { icons, class: className = '' } = Astro.props
---

<div class={`mosaic ${className}`} aria-hidden="true">
  <div class="mosaic__glow"></div>
  <div class="mosaic__grid">
    {
      icons.map((name, i) => (
        <span class="mosaic__cell" style={`--i: ${i}`}>
          <SiteIcon name={name} size="lg" class="mosaic__icon" />
        </span>
      ))
    }
  </div>
</div>

<style>
  .mosaic {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Fades out downward so the caption below sits on clean black. */
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 88%);
    mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 88%);
  }

  .mosaic__glow {
    position: absolute;
    left: 50%;
    top: 18%;
    width: 130%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.07) 0%,
      rgba(255, 255, 255, 0.02) 42%,
      transparent 68%
    );
    transition: opacity 700ms ease;
    opacity: 0.8;
  }

  .mosaic__grid {
    position: absolute;
    left: 50%;
    top: 30%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
    /* The whole group floats as one. Per-cell vertical drift was tried and
       rejected: it breaks the 2x2 alignment in every frame, so a still of the
       page reads as a misaligned grid rather than as motion. */
    animation: mosaic-float 28s ease-in-out infinite;
  }

  @keyframes mosaic-float {
    0%,
    100% {
      transform: translate(-50%, -50%);
    }
    50% {
      transform: translate(-50%, calc(-50% - 4px));
    }
  }

  .mosaic__cell {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    background: none;
    color: rgba(255, 255, 255, 0.6);
    /* Only the glow breathes per cell — never the position. Staggered so the
       four never pulse in unison. */
    animation: mosaic-breathe 20s ease-in-out infinite;
    animation-delay: calc(var(--i) * -5s);
    transition:
      border-color 500ms ease,
      color 500ms ease;
  }

  .mosaic__cell :global(.mosaic__icon) {
    width: 24px;
    height: 24px;
  }

  @keyframes mosaic-breathe {
    0%,
    100% {
      opacity: 0.8;
    }
    50% {
      opacity: 1;
    }
  }

  /* Hover state is driven by the card wrapping this. */
  :global(.group):hover .mosaic__glow {
    opacity: 1;
  }
  :global(.group):hover .mosaic__cell {
    border-color: rgba(255, 255, 255, 0.16);
    color: var(--color-text-secondary);
  }

  /* Toggled by the script below when the mosaic leaves or enters the viewport. */
  .mosaic.is-paused .mosaic__grid,
  .mosaic.is-paused .mosaic__cell {
    animation-play-state: paused;
  }

  @media (max-width: 770px) {
    .mosaic__cell {
      width: 3rem;
      height: 3rem;
    }
    .mosaic__cell :global(.mosaic__icon) {
      width: 20px;
      height: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mosaic__grid {
      animation: none;
      transform: translate(-50%, -50%);
    }
    .mosaic__cell {
      animation: none;
      opacity: 0.9;
    }
  }
</style>

<script>
  // Ambient loops run only while the mosaic is on screen, and never under reduced motion
  // (the CSS above already drops the animations in that case).
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const mosaics = document.querySelectorAll<HTMLElement>('.mosaic')

  if (!reduced && mosaics.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        entry.target.classList.toggle('is-paused', !entry.isIntersecting)
      }
    })
    mosaics.forEach((mosaic) => observer.observe(mosaic))
  }
</script>
