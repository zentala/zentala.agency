---
import SiteIcon from '@/components/primitives/SiteIcon.astro'

export interface Props {
  icon: string
}
const { icon } = Astro.props

/** A short icon name renders as an icon; anything else (an emoji, a glyph) renders as text. */
/** Background glyphs are drawn at this size (Thin weight); CSS scales the box to the card. */
const BACKGROUND_ICON_PX = 176

const isIconName = /^[a-z][a-z0-9-]*$/.test(icon) && icon.length > 1
---

<span class="card-background-icon">
  {
    isIconName ? (
      <SiteIcon name={icon} size={BACKGROUND_ICON_PX} class="card-background-icon__svg" />
    ) : (
      icon
    )
  }
</span>

<style>
  .card-background-icon {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    font-size: 8rem;
    opacity: 0.06;
    transition: opacity 200ms ease-in-out;
    /* Paints above the host's background, below its content; hosts isolate. */
    z-index: -1;
    pointer-events: none;
    color: #fff;
    line-height: 1;
  }

  :global(.card-container):hover .card-background-icon {
    opacity: var(--icon-bg-max-opacity);
  }

  .card-background-icon :global(.card-background-icon__svg) {
    width: 8rem;
    height: 8rem;
  }

  @media (max-width: 770px) {
    .card-background-icon {
      font-size: 7rem;
    }
    .card-background-icon :global(.card-background-icon__svg) {
      width: 7rem;
      height: 7rem;
    }
  }

  @media (max-width: 480px) {
    .card-background-icon {
      font-size: 5rem;
    }
    .card-background-icon :global(.card-background-icon__svg) {
      width: 5rem;
      height: 5rem;
    }
  }
</style>
