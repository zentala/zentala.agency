---
import SiteIcon from '@/components/primitives/SiteIcon.astro'

export interface Props {
  icon: string
}
const { icon } = Astro.props

/** A short icon name renders as an icon; anything else (an emoji, a glyph) renders as text. */
/** Background glyphs render at this size (Thin weight) at every viewport; the card crops them. */
const BACKGROUND_ICON_PX = 176

const isIconName = /^[a-z][a-z0-9-]*$/.test(icon) && icon.length > 1
---

<span class="card-background-icon">
  {
    isIconName ? (
      <SiteIcon name={icon} size={BACKGROUND_ICON_PX} />
    ) : (
      icon
    )
  }
</span>

<style>
  .card-background-icon {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    font-size: 176px;
    opacity: var(--icon-bg-rest-opacity, 0.06);
    transition: opacity 200ms ease-in-out;
    /* Paints above the host's background, below its content; hosts isolate. */
    z-index: -1;
    pointer-events: none;
    color: #fff;
    line-height: 1;
  }

  :global(.card-container):hover .card-background-icon {
    opacity: var(--icon-bg-max-opacity);
  }
</style>
