---
/**
 * Badge - a Tag without the hash: `tech` is the muted technology label (with its logo when one exists),
 * `accent` the accent-coloured one. Kept for existing callers; the look lives in Tag.
 */
import Tag from '@/components/primitives/Tag.astro'

export interface Props {
  variant?: 'tech' | 'accent'
  /** Kept for existing callers; every tag has one height. */
  size?: 'sm' | 'md'
  /** Technology name; shows a logo when one exists. */
  tech?: string
  class?: string
}

const { variant = 'tech', tech, class: className = '' } = Astro.props
---

<Tag theme="label" accent={variant === 'accent'} tech={tech} class={className}><slot /></Tag>
