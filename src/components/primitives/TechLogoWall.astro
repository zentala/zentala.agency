---
/**
 * TechLogoWall - a wall of technology logos generated from a list of simple-icons slugs or names
 * (src/data/tech-icons.ts). Monochrome at rest. Each cell is a button that reacts alone: on hover or keyboard
 * focus the logo takes its real brand colour, a glow of that colour lights the cell's own edges and the name
 * shows at the cell's bottom (out of the flow, so the logo stays centred at rest).
 *
 * A logo with a note (`notes`, slug to text) also expands, on hover, focus or tap: LogoWallNote grows from the
 * cell over its neighbours without moving a grid rect. The dev axis "logo-expand" restyles it (dev-variants.scss).
 *
 * Layouts: `cells` gives every logo a line-grid cell (and the notes); `field` sets the logos on one open block.
 * Place it in a `Section` after a `SectionHeader`. Names stay in the accessibility tree.
 */
import LogoWallNote from '@/components/primitives/LogoWallNote.astro'
import TechIcon from '@/components/primitives/TechIcon.astro'
import { resolveTechIcon } from '@/data/tech-icons'

/** One column count for every width, or one per width band (above 1000px, 771-1000px, 770px and below). */
export type WallColumns = number | { wide: number; medium?: number; narrow?: number }

export interface Props {
  /** simple-icons slugs or technology names, in display order. An unknown one fails the build. */
  logos: string[]
  /** Default 8; 771-1000px uses at most 6 and 770px and below at most 4 unless set. */
  columns?: WallColumns
  /** Logo size in whole px. */
  size?: 24 | 32 | 40
  /** `hover`: the name shows on hover and focus, and always at 770px and below; `always`; `none`: tooltip only. */
  label?: 'hover' | 'always' | 'none'
  layout?: 'cells' | 'field'
  /** Accessible name of the list. */
  title?: string
  /** Note per logo slug; a logo with a note expands (layout `cells` only). */
  notes?: Record<string, string>
}

const {
  logos,
  columns = 8,
  size = 32,
  label = 'hover',
  layout = 'cells',
  title = 'Technologies',
  notes = {},
} = Astro.props

const entries = logos.map(resolveTechIcon)
const bands = typeof columns === 'number' ? { wide: columns } : columns
const colCount = {
  wide: bands.wide,
  medium: bands.medium ?? Math.min(bands.wide, 6),
  narrow: bands.narrow ?? Math.min(bands.wide, 4),
}
const style = `--cols-wide: ${colCount.wide}; --cols-medium: ${colCount.medium}; --cols-narrow: ${colCount.narrow}; --wall-logo: ${size}px`
const wallId = `logo-wall-${title.toLowerCase().replace(/\W+/g, '-')}`

/** Column index and last-row flag of cell `index` per width band: the panel placement reads them (see the style). */
const placement = (index: number) =>
  (Object.keys(colCount) as (keyof typeof colCount)[])
    .map((band) => {
      const cols = colCount[band]
      const lastRow = entries.length > cols && index >= entries.length - cols
      return `--col-${band}: ${index % cols}; --flipy-${band}: ${lastRow ? 1 : 0}`
    })
    .join('; ')
const hasNote = (slug: string) => layout === 'cells' && slug in notes
---

{
  entries.length > 0 && (
    <>
      {import.meta.env.DEV && <div class="logo-wall__strip" aria-live="polite" data-logo-strip />}
      <ul
        class:list={[
          'logo-wall',
          `logo-wall--${layout}`,
          `logo-wall--label-${label}`,
          layout === 'cells' && 'line-grid',
        ]}
        style={style}
        aria-label={title}
        role="list"
      >
        {entries.map((entry, index) => {
          const noteId = `${wallId}-note-${entry.slug}`
          const note = hasNote(entry.slug) ? notes[entry.slug] : undefined
          return (
            <li
              class="logo-wall__item"
              style={`--brand: ${entry.brand}; ${placement(index)}`}
              title={label === 'none' ? entry.name : undefined}
            >
              <button
                type="button"
                class="logo-wall__tile"
                aria-expanded={note ? 'false' : undefined}
                aria-describedby={note ? noteId : undefined}
              >
                <TechIcon name={entry.slug} size="lg" class="logo-wall__logo" />
                <span class:list={['logo-wall__name', label === 'none' && 'sr-only']}>{entry.name}</span>
              </button>
              {note && <LogoWallNote id={noteId} entry={entry} note={note} />}
            </li>
          )
        })}
      </ul>
    </>
  )
}

<script>
  import '@/lib/logoWall'
</script>

<style lang="scss">
  @use '../../styles/components/tech-logo-wall';
</style>
