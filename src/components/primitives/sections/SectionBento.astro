---
/**
 * SectionBento - Bento grid for asymmetric layouts on the shared line model.
 *
 * Provides:
 * - 4-column base grid (desktop), 2 columns up to 1000px, 1 column up to 770px
 * - Custom spans via BentoCard (reset to single cells on narrow screens)
 * - Configurable row height (aspect ratio)
 *
 * The cards fill the grid by manual placement, so the incomplete-row filler is off.
 *
 * Usage:
 * <SectionBento rowHeight="1fr">  <!-- square (default) -->
 * <SectionBento rowHeight="60%">  <!-- 60% of column width -->
 * <SectionBento rowHeight="200px"> <!-- fixed height -->
 *   <BentoCard colSpan={2} rowSpan={2}>...</BentoCard>
 *   <BentoCard colSpan={1} rowSpan={1}>...</BentoCard>
 * </SectionBento>
 */

interface Props {
  rowHeight?: string // e.g., "1fr" (square), "60%", "200px", "0.6fr"
}

const { rowHeight = '1fr' } = Astro.props
---

<div
  class="line-grid bento-grid"
  style={`--cols-wide: 4; grid-auto-rows: ${rowHeight};`}
>
  <slot />
</div>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .bento-grid {
    grid-auto-flow: dense; // Fill gaps with smaller items

    &::after {
      display: none;
    }

    @include tablet-up {
      @include medium-only {
        > :global(*) {
          grid-column: span 1 !important;
        }
      }
    }

    @include tablet {
      > :global(*) {
        grid-column: span 1 !important;
        grid-row: auto !important;
      }
    }
  }
</style>
