---
/**
 * BentoCard - Universal card for bento grid layouts
 *
 * Provides:
 * - Custom column/row spans
 * - Flexible padding options
 * - Border mechanics handled by parent (SectionBento)
 * - Hover states
 * - Dev mode: Shows grid dimensions (col:row)
 *
 * Usage:
 * <BentoCard colSpan={2} rowSpan={1} padding="md">
 *   <SectionContent context="grid">...</SectionContent>
 * </BentoCard>
 */

interface Props {
  colSpan?: 1 | 2 | 3 | 4
  rowSpan?: 1 | 2 | 3
  padding?: 'none' | 'sm' | 'md' | 'lg'
}

const { colSpan = 1, rowSpan = 1, padding = 'md' } = Astro.props
const isDev = import.meta.env.DEV
---

<div
  class={`bento-card ${padding !== 'none' ? `bento-card--padding-${padding}` : ''}`}
  style={`grid-column: span ${colSpan}; grid-row: span ${rowSpan};`}
>
  {isDev && (
    <div class="bento-card__dev-label" title={`Column span: ${colSpan}, Row span: ${rowSpan}`}>
      {colSpan}:{rowSpan}
    </div>
  )}
  <slot />
</div>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .bento-card {
    background: #000;
    transition: background 200ms;
    position: relative;

    &:hover {
      background: var(--color-surface-hover);
    }

    // Dev mode label (top-right corner)
    &__dev-label {
      position: absolute;
      top: 4px;
      right: 4px;
      background: rgba(255, 255, 255, 0.1);
      color: var(--color-text-subtle);
      font-size: 10px;
      font-weight: 400;
      padding: 2px 6px;
      border-radius: 3px;
      z-index: 100;
      pointer-events: none;
      font-family: monospace;
      line-height: 1;
    }

    // sm, md and lg all take the full cell padding (DESIGN.md "Left edge")
    &--padding-sm,
    &--padding-md,
    &--padding-lg {
      @include cell-padding;
    }
  }
</style>
