---
import BentoCard from './BentoCard.astro'
---

<BentoCard
  colSpan={2}
  rowSpan={2}
  padding="none"
  id="central-interactive-card"
  hoverState="logo"
  class="cursor-pointer bento-card--transparent"
>
  <div
    class="interactive-container group relative h-full w-full overflow-clip"
  >
    <slot />
  </div>
  <div class="overflow-clip">
    <span
      class="nav-font block translate-y-full transition-transform delay-100 duration-slow ease-standard"
    >
      <slot name="label-primary" />
    </span>
  </div>
  <div class="overflow-clip">
    <span
      class="nav-font block translate-y-full transition-transform delay-200 duration-slow ease-standard"
    >
      <slot name="label-secondary" />
    </span>
  </div>
</BentoCard>

<style>
  /* Dev span label: the card draws a 1px top line, so top 1px shows 2px of space, equal to the right offset */
  :global(#central-interactive-card > .bento-card__dev-label) {
    top: 1px;
    right: 2px;
  }
</style>
