---
/**
 * SectionHeader - Header block for sections
 *
 * Provides:
 * - Consistent headline + subhead styling
 * - Bottom border separator
 * - Responsive typography
 * - Optional text alignment
 * - Default slot: rich body content under the subhead (series intro, category text)
 * - `compact`: the plain header padding even with an eyebrow (listing pages);
 *   `eyebrowIcon`: a small SiteIcon before the eyebrow text
 * - `variant`: `a` (this look, the default), `b` (small caps label), `c` (thin larger
 *   label) or `d` (label on the section line, no height). In b, c and d the header is
 *   one row: icon and name on the left, `meta` (or the eyebrow) on the right; d hides
 *   the subhead and the body. Without the prop the dev-only variant switcher may
 *   restyle the header through `html[data-v-section-header]`.
 * - `labelIcon`: a small SiteIcon before the headline; `meta`: a short note on the right
 *
 * Usage:
 * <SectionHeader
 *   headline="Services"
 *   subhead="What I offer"
 *   tag="h2"
 *   align="left"
 * />
 */

import SiteIcon from '@/components/primitives/SiteIcon.astro'
import CardBackgroundIcon from '../CardBackgroundIcon.astro'

interface Props {
  headline: string
  subhead?: string
  eyebrow?: string
  eyebrowIcon?: string
  compact?: boolean
  icon?: string
  logoSrc?: string
  logoAlt?: string
  tag?: 'h1' | 'h2' | 'h3'
  align?: 'left' | 'center'
  variant?: 'a' | 'b' | 'c' | 'd'
  labelIcon?: string
  meta?: string
  interactive?: boolean // Deprecated, no effect: the scale hover was removed
}

const {
  headline,
  subhead,
  eyebrow,
  eyebrowIcon,
  compact = false,
  icon,
  logoSrc,
  logoAlt = '',
  tag = 'h2',
  align = 'left',
  variant,
  labelIcon,
  meta,
} = Astro.props
const HeadingTag = tag

/** The compact variants reuse an icon the header already names; emoji icons are skipped. */
const ICON_NAME = /^[a-z][a-z0-9-]+$/
const fallbackIcon = [eyebrowIcon, icon].find((name) => name && ICON_NAME.test(name))
const headlineIcon = labelIcon ?? fallbackIcon
---

<div
  class:list={[
    'section-header',
    !compact && (eyebrow || icon || logoSrc) && 'section-header--feature',
    compact && eyebrow && 'section-header--compact-eyebrow',
  ]}
  data-align={align}
  data-variant={variant}
>
  {icon && <CardBackgroundIcon icon={icon} />}
  {logoSrc && <img src={logoSrc} alt={logoAlt} class="section-header__logo" />}
  {
    eyebrow && (
      <p class="section-eyebrow">
        {eyebrowIcon && <SiteIcon name={eyebrowIcon} size="sm" class="section-eyebrow__icon" />}
        {eyebrow}
      </p>
    )
  }
  <HeadingTag
    class:list={['section-headline', labelIcon && 'section-headline--icon']}
  >
    {
      headlineIcon && (
        <span class="section-headline__icon">
          <SiteIcon name={headlineIcon} size="sm" class="section-headline__icon-sm" />
          <SiteIcon name={headlineIcon} size="lg" class="section-headline__icon-lg" />
        </span>
      )
    }
    {headline}
  </HeadingTag>
  {meta && <p class="section-header__meta">{meta}</p>}
  {subhead && <p class="section-subhead">{subhead}</p>}
  {
    Astro.slots.has('default') && (
      <div class="section-header__body">
        <slot />
      </div>
    )
  }
</div>

<style lang="scss">
  @use '../../../styles/variables' as *;
  @use './section-header-variants' as variants;

  .section-header {
    border-bottom: 1px solid $border-color;
    @include px-responsive('md');
    @include py-responsive('md');
    position: relative;
    overflow: hidden;
    isolation: isolate;

    &[data-align='center'] {
      text-align: center;
    }
  }

  /* Feature variant — banner-feel padding when eyebrow/icon present */
  .section-header--feature {
    padding-top: 7rem;
    padding-bottom: 5rem;

    @media (max-width: 1440px) {
      padding-top: 6rem;
      padding-bottom: 4rem;
    }

    @media (max-width: 1000px) {
      padding-top: 4.5rem;
      padding-bottom: 3rem;
    }

    @media (max-width: 770px) {
      padding-top: 3rem;
      padding-bottom: 2rem;
    }

    /* Bigger icon than content cards (cards use 8rem; here ~12rem) */
    :global(.card-background-icon) {
      font-size: 12rem;
    }

    :global(.card-background-icon__svg) {
      width: 12rem;
      height: 12rem;
    }

    @media (max-width: 770px) {
      :global(.card-background-icon) {
        font-size: 9rem;
      }
      :global(.card-background-icon__svg) {
        width: 9rem;
        height: 9rem;
      }
    }
  }

  .section-header__logo {
    display: block;
    width: 36px;
    height: auto;
    opacity: 0.85;
    margin-bottom: 1.25rem;
    position: relative;
    z-index: 1;
  }

  .section-eyebrow {
    color: var(--color-text-subtle);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: 500;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .section-eyebrow__icon {
    display: inline-block;
    margin-right: 0.25rem;
    vertical-align: -0.2rem;
  }

  .section-header--compact-eyebrow .section-eyebrow {
    margin-bottom: 0.5rem;
  }

  .section-header__body {
    position: relative;
    z-index: 1;
    margin-top: 1rem;
  }

  .section-headline {
    @apply text-3xl md:text-4xl font-light text-fg;
    position: relative;
    z-index: 1;
  }

  .section-subhead {
    @apply text-lg text-fg-secondary mt-4;
    position: relative;
    z-index: 1;
    max-width: 56rem;
  }

  .section-header[data-align='center'] .section-subhead {
    margin-inline: auto;
  }

  @include variants.variant-a-extras;

  .section-header {
    @include variants.compact-variants;
  }
</style>
