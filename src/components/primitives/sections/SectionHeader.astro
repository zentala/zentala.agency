---
/**
 * SectionHeader - Header block for sections
 *
 * Provides:
 * - Consistent headline + subhead styling
 * - Bottom border separator
 * - Responsive typography
 * - Optional text alignment
 *
 * Usage:
 * <SectionHeader
 *   headline="Services"
 *   subhead="What I offer"
 *   tag="h2"
 *   align="left"
 * />
 */

import CardBackgroundIcon from '../CardBackgroundIcon.astro'

interface Props {
  headline: string
  subhead?: string
  eyebrow?: string
  icon?: string
  logoSrc?: string
  logoAlt?: string
  tag?: 'h1' | 'h2' | 'h3'
  align?: 'left' | 'center'
  interactive?: boolean // Deprecated, no effect: the scale hover was removed
}

const {
  headline,
  subhead,
  eyebrow,
  icon,
  logoSrc,
  logoAlt = '',
  tag = 'h2',
  align = 'left',
} = Astro.props
const HeadingTag = tag
---

<div
  class:list={[
    'section-header',
    (eyebrow || icon || logoSrc) && 'section-header--feature',
  ]}
  data-align={align}
>
  {icon && <CardBackgroundIcon icon={icon} />}
  {logoSrc && <img src={logoSrc} alt={logoAlt} class="section-header__logo" />}
  {eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
  <HeadingTag class="section-headline">{headline}</HeadingTag>
  {subhead && <p class="section-subhead">{subhead}</p>}
</div>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .section-header {
    border-bottom: 1px solid $border-color;
    @include px-responsive('md');
    @include py-responsive('md');
    position: relative;
    overflow: hidden;

    &[data-align='center'] {
      text-align: center;
    }
  }

  /* Feature variant — banner-feel padding when eyebrow/icon present */
  .section-header--feature {
    padding-top: 7rem;
    padding-bottom: 5rem;

    @media (max-width: 1440px) {
      padding-top: 6rem;
      padding-bottom: 4rem;
    }

    @media (max-width: 1000px) {
      padding-top: 4.5rem;
      padding-bottom: 3rem;
    }

    @media (max-width: 770px) {
      padding-top: 3rem;
      padding-bottom: 2rem;
    }

    /* Bigger icon than content cards (cards use 8rem; here ~12rem) */
    :global(.card-background-icon) {
      font-size: 12rem;
    }

    :global(.card-background-icon__svg) {
      width: 12rem;
      height: 12rem;
    }

    @media (max-width: 770px) {
      :global(.card-background-icon) {
        font-size: 9rem;
      }
      :global(.card-background-icon__svg) {
        width: 9rem;
        height: 9rem;
      }
    }
  }

  .section-header__logo {
    display: block;
    width: 36px;
    height: auto;
    opacity: 0.85;
    margin-bottom: 1.25rem;
    position: relative;
    z-index: 1;
  }

  .section-eyebrow {
    color: var(--color-text-subtle);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .section-headline {
    @apply text-3xl md:text-4xl font-light text-fg;
    position: relative;
    z-index: 1;
  }

  .section-subhead {
    @apply text-lg text-fg-secondary mt-4;
    position: relative;
    z-index: 1;
    max-width: 56rem;
  }

  .section-header[data-align='center'] .section-subhead {
    margin-inline: auto;
  }
</style>
