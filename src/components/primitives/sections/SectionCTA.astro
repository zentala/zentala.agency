---
/**
 * SectionCTA - Call-to-action button/link for sections
 *
 * - Top line and hover overlay from the shared line model (DESIGN.md section 3)
 * - Full-width layout
 * - Optional icon + text + chevron, drawn as the shared button look (Button.astro variants)
 * - Optional background word: normal case, large, faint, cropped by the cell
 * - Hover states
 * - External link support
 *
 * Usage:
 * <SectionCTA
 *   href="/contact"
 *   text="Get Started"
 *   icon="rocket"
 *   variant="primary"
 * />
 */

import SiteIcon from '@/components/primitives/SiteIcon.astro'

interface Props {
  href: string
  text: string
  icon?: string // short SiteIcon name
  arrow?: boolean
  variant?: 'primary' | 'secondary' | 'accent' | 'ghost'
  external?: boolean
  bgText?: string // Large quiet background word in normal case (e.g. "Portfolio")
  class?: string
}

const {
  href,
  text,
  icon,
  arrow = true,
  variant = 'primary',
  external = false,
  bgText,
  class: className = '',
} = Astro.props

const target = external ? '_blank' : undefined
const rel = external ? 'noopener noreferrer' : undefined
---

<a
  href={href}
  class={`section-cta section-cta--${variant} ${className}`}
  target={target}
  rel={rel}
>
  {bgText && <span class="section-cta__bg-text" aria-hidden="true">{bgText}</span>}
  <span class="section-cta__content">
    {icon && <SiteIcon name={icon} size="md" class="section-cta__icon" />}
    <span class="section-cta__text">{text}</span>
    {arrow && <SiteIcon name="caret-right" size="sm" class="section-cta__arrow arrow-nudge" />}
  </span>
</a>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .section-cta {
    @include line-block;
    @include cell-interactive;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    min-height: 120px;
    overflow: clip; // crops the background word at the top and bottom of the cell
    @include px-responsive('md');
    @include py-responsive('md');

    @include mobile {
      min-height: 100px;
    }

    &:hover {
      text-decoration: none;
    }

    &:hover .section-cta__bg-text {
      opacity: 0.1;
    }
  }

  // Quiet background word: normal font and case, larger than the cell is tall so it is cropped.
  .section-cta__bg-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -46%);
    font-size: 8rem;
    font-weight: 400;
    line-height: 1;
    color: var(--color-text);
    opacity: 0.06;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    text-transform: lowercase; // callers may still pass an upper-case word
    z-index: 0;
    transition: opacity var(--motion-fast) var(--ease-standard);

    @include mobile {
      font-size: 5rem;
    }
  }

  .section-cta__bg-text::first-letter {
    text-transform: uppercase;
  }

  // The inner label is the button; the whole cell is the link.
  .section-cta__content {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    z-index: 1; // above the background word
    min-height: 3rem;
    border: 1px solid transparent;
    padding: 0.625rem 1.5rem;
    color: var(--color-text);
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .section-cta__text {
    @apply text-base font-normal;
  }

  // Variants: same look as Button.astro. The cell overlay provides the focus ring.
  .section-cta--primary .section-cta__content,
  .section-cta--accent .section-cta__content {
    border-color: var(--color-text-subtle);
    background-color: rgba(255, 255, 255, 0.04);
  }

  .section-cta--primary:hover .section-cta__content,
  .section-cta--accent:hover .section-cta__content {
    border-color: var(--color-text);
    background-color: rgba(255, 255, 255, 0.08);
  }

  .section-cta--accent .section-cta__icon,
  .section-cta--accent .section-cta__arrow {
    color: var(--color-accent);
  }

  .section-cta--secondary .section-cta__content {
    border-color: var(--color-line-strong);
    color: var(--color-text-secondary);
  }

  .section-cta--secondary:hover .section-cta__content {
    border-color: var(--color-text-subtle);
    color: var(--color-text);
  }

  .section-cta--ghost .section-cta__content {
    color: var(--color-text-secondary);
  }

  .section-cta--ghost:hover .section-cta__content {
    color: var(--color-text);
  }
</style>
