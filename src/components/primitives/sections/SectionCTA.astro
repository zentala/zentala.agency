---
/**
 * SectionCTA - Call-to-action button/link for sections
 *
 * - Top line and hover overlay from the shared line model (DESIGN.md section 3)
 * - Full-width layout
 * - Icon + text + arrow pattern, drawn as the shared button look (Button.astro variants)
 * - Hover states
 * - External link support
 *
 * Usage:
 * <SectionCTA
 *   href="/contact"
 *   text="Get Started"
 *   icon="rocket"
 *   variant="primary"
 * />
 */

import { Icon } from 'astro-icon/components'

interface Props {
  href: string
  text: string
  icon?: string // Lucide icon name
  arrow?: boolean
  variant?: 'primary' | 'secondary' | 'accent'
  external?: boolean
  bgText?: string // Large background text (e.g., "PORTFOLIO")
  class?: string
}

const {
  href,
  text,
  icon,
  arrow = true,
  variant = 'primary',
  external = false,
  bgText,
  class: className = '',
} = Astro.props

const target = external ? '_blank' : undefined
const rel = external ? 'noopener noreferrer' : undefined
---

<a
  href={href}
  class={`section-cta section-cta--${variant} ${className}`}
  target={target}
  rel={rel}
>
  {bgText && <span class="section-cta__bg-text" aria-hidden="true">{bgText}</span>}
  <span class="section-cta__content">
    {icon && <Icon name={`lucide:${icon}`} class="section-cta__icon" />}
    <span class="section-cta__text">{text}</span>
    {arrow && <Icon name="lucide:arrow-right" class="section-cta__arrow" />}
  </span>
</a>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .section-cta {
    @include line-block;
    @include cell-interactive;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    min-height: 120px;
    overflow: clip; // Clip background text
    @include px-responsive('md');
    @include py-responsive('md');

    @include mobile {
      min-height: 100px;
    }

    &:hover {
      .section-cta__arrow {
        transform: translateX(4px);
      }

      .section-cta__bg-text {
        opacity: 0.15; // Slightly more visible on hover
      }
    }
  }

  // Large background text
  .section-cta__bg-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 60px;
    font-weight: 100;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.1); // decorative watermark
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    z-index: 0;
    transition: opacity var(--motion-fast) var(--ease-standard);

    @include mobile {
      font-size: 40px;
    }
  }

  // The inner label is the button; the whole cell is the link.
  .section-cta__content {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
    z-index: 1; // Above background text
    border: 1px solid transparent;
    padding: 0.75rem 2rem;
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .section-cta__icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .section-cta__text {
    @apply text-lg font-normal;

    @include mobile {
      @apply text-base;
    }
  }

  .section-cta__arrow {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  // Variants: same look as Button.astro. A solid white or solid blue label also needs a
  // visible focus ring, which the cell overlay provides.
  .section-cta--primary .section-cta__content {
    background-color: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-surface);
  }

  .section-cta--primary:hover .section-cta__content {
    background-color: var(--color-text-secondary);
    border-color: var(--color-text-secondary);
  }

  .section-cta--secondary .section-cta__content {
    border-color: var(--color-line-strong);
    color: var(--color-text);
  }

  .section-cta--accent .section-cta__content {
    background-color: var(--color-accent-solid);
    border-color: var(--color-accent-solid);
    color: var(--color-text);
  }

  .section-cta--accent:hover .section-cta__content {
    border-color: var(--color-accent);
  }
</style>
