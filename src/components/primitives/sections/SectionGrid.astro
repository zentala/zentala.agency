---
/**
 * SectionGrid - Responsive grid (2-5 columns) on the shared line model.
 *
 * `columns` is the column count above 1000px; the shared `.line-grid` collapses
 * it to 2 columns up to 1000px and 1 column up to 770px. Lines, spans and the
 * hover overlay come from `.line-grid` (DESIGN.md section 3).
 *
 * Usage:
 * <SectionGrid columns={4}>
 *   <SectionContent context="grid">...</SectionContent>
 * </SectionGrid>
 */

interface Props {
  columns?: 2 | 3 | 4 | 5
}

const { columns = 3 } = Astro.props
---

<div class="line-grid" style={`--cols-wide: ${columns}`}>
  <slot />
</div>
