---
/**
 * SectionContent - Universal content block
 *
 * Provides:
 * - Auto-adjusting padding based on context (full vs grid)
 * - Prose typography for text content
 * The cell is transparent and never lifts on hover: the grid cell around it owns lines and hover.
 *
 * Context modes:
 * - 'full': Large padding, max-width, centered (standalone)
 * - 'grid': Compact padding, full space (inside grid)
 * - 'auto': Auto-detect based on parent (TODO: implement)
 *
 * Usage:
 * <SectionContent context="full">
 *   <h3>Headline</h3>
 *   <p>Text content...</p>
 * </SectionContent>
 */

interface Props {
  context?: 'full' | 'grid' | 'auto'
  prose?: boolean
}

const { context = 'auto', prose = true } = Astro.props

// Auto-detect: default to 'full' for now (can enhance later)
const actualContext = context === 'auto' ? 'full' : context
---

<div
  class={`section-content section-content--${actualContext} ${prose ? 'section-content--prose' : ''}`}
>
  <div
    class={`section-content__body ${prose ? 'section-content__body--prose' : ''}`}
  >
    <slot />
  </div>
</div>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .section-content {
    position: relative;
  }

  /* Full-width context: generous padding + max-width */
  .section-content--full {
    max-width: 60rem;
    margin: 0 auto;
    @include px-responsive('lg');
    @include py-responsive('lg');
  }

  /* Grid context: a content cell, full cell padding. Inside a bento card the card pads. */
  .section-content--grid {
    @include cell-padding;
  }

  :global(.bento-card[class*='bento-card--padding']) .section-content--grid {
    padding: 0;
  }

  .section-content__body {
    width: 100%;
    color: var(--color-text);
  }

  .section-content--prose .section-content__body {
    max-width: 100%;

    :global(h1) {
      margin-top: 0;
      margin-bottom: 1.5rem;
      font-size: var(--text-h1-page);
      font-weight: 300;
      line-height: 1.1;
      color: var(--color-text);
    }

    :global(h2) {
      margin-top: 0;
      margin-bottom: 1rem;
      font-size: var(--text-h2);
      font-weight: 300;
      line-height: 1.1;
      color: var(--color-text);
    }

    :global(h3) {
      margin-top: 0;
      margin-bottom: 1rem;
      font-size: var(--text-h3);
      font-weight: 300;
      line-height: 1.1;
      color: var(--color-text);
    }

    :global(h4) {
      @apply mb-3 text-xl font-light;
      color: var(--color-text);
    }

    :global(h5) {
      @apply mb-2 text-lg font-light;
      color: var(--color-text-secondary);
    }

    :global(p) {
      @apply mb-4 text-base md:text-lg;
      color: var(--color-text-secondary);

      &:last-child {
        margin-bottom: 0;
      }
    }

    :global(ul),
    :global(ol) {
      @apply mb-4 ml-6 text-base md:text-lg;
      color: var(--color-text-secondary);

      li {
        @apply mb-2;

        strong {
          color: var(--color-text);
        }
      }
    }

    :global(ul) {
      list-style: disc;
    }

    :global(ol) {
      list-style: decimal;
    }

    :global(strong) {
      @apply font-normal;
      color: var(--color-text);
    }

    .value-statement {
      @apply mt-4 italic;
      color: var(--color-text-secondary);
    }

    .mt-2 {
      margin-top: 0.5rem;
    }
  }
</style>
