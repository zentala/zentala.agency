---
/**
 * SectionBlockQuote - Quote block for sections
 *
 * Enhanced version of BlockQuote with:
 * - Top line and hover overlay from the shared line model (DESIGN.md section 3)
 * - Multiple variants
 * - Optional role/title for author
 *
 * Usage:
 * <SectionBlockQuote
 *   quote="Great product!"
 *   author="John Doe"
 *   role="CEO, Company"
 *   variant="default"
 * />
 */

interface Props {
  quote?: string
  author?: string
  role?: string
  variant?: 'default' | 'large' | 'minimal'
  class?: string
}

const { quote, author, role, variant = 'default', class: className = '' } = Astro.props
---

<div class={`section-blockquote section-blockquote--${variant} ${className}`}>
  <blockquote>
    {
      quote ? (
        <p class="quote-text">"{quote}"</p>
      ) : (
        <div class="quote-text">
          <slot />
        </div>
      )
    }
  </blockquote>

  {
    (author || role) && (
      <footer class="quote-footer">
        {author && <cite class="quote-author">— {author}</cite>}
        {role && <span class="quote-role">{role}</span>}
      </footer>
    )
  }
</div>

<style lang="scss">
  @use '../../../styles/variables' as *;

  .section-blockquote {
    @include line-block;
    @include cell-interactive;
    @include px-responsive('md');
    @include py-responsive('md');

    blockquote {
      margin: 0;
    }

    .quote-text {
      @apply text-xl md:text-2xl font-light text-fg-secondary italic;
      line-height: 1.6;
      margin: 0;
    }

    .quote-footer {
      margin-top: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .quote-author {
      @apply text-base text-fg font-normal not-italic;
    }

    .quote-role {
      @apply text-sm text-fg-muted;
    }

    // Variants
    &--large {
      .quote-text {
        @apply text-2xl md:text-3xl;
      }

      .quote-author {
        @apply text-lg;
      }
    }

    &--minimal {
      border-top: none;
      padding: 0;
      margin: 0;

      &::after {
        display: none;
      }

      &:hover {
        background-color: transparent;
      }

      .quote-text {
        @apply text-lg md:text-xl;
      }
    }
  }

</style>
