---
/**
 * Tag - the one small label of the site: square 4px chip, neutral fill, no border (a bordered chip inside a
 * grid cell draws a dangling line). Every tag, badge and tag list renders through it, so geometry is shared:
 * 24px tall, 11px type, the hash drawn as its own glyph so it never looks smaller than the text.
 * Optional leading `icon` (SiteIcon name) or `tech` (a technology name; the logo is shown when one exists).
 */
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import TechIcon from '@/components/primitives/TechIcon.astro'
import { findTechIcon } from '@/data/tech-icons'

export interface TagProps {
  text?: string
  href?: string
  prefix?: string
  theme?: 'chip' | 'simple' | 'label'
  /** SiteIcon short name shown before the text. */
  icon?: string
  /** Technology name; a logo is shown when src/data/tech-icons.ts has one. */
  tech?: string
  /** Accent text colour (small accent only). */
  accent?: boolean
  class?: string
}

const {
  text,
  href,
  prefix = '#',
  theme = 'chip',
  icon,
  tech,
  accent = false,
  class: className = '',
} = Astro.props as TagProps

const logo = tech ? findTechIcon(tech) : undefined
const effectivePrefix = theme === 'label' || logo || icon ? '' : prefix
const Element = href ? 'a' : 'span'
---

<Element
  href={href}
  style={logo ? `--brand: ${logo.brand}` : undefined}
  class:list={['tag', `tag--${theme}`, accent && 'tag--accent', href && 'tag--link', className]}
>
  {
    logo ? (
      <TechIcon name={logo.slug} size="sm" class="tag__icon" />
    ) : icon ? (
      <SiteIcon name={icon} size="sm" class="tag__icon" />
    ) : null
  }
  {effectivePrefix && <span class="tag__hash" aria-hidden="true">{effectivePrefix}</span>}
  <span class="tag__text">{text}<slot /></span>
</Element>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 1.5rem;
    padding: 0 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
    color: var(--color-text-muted);
    font-size: var(--text-label);
    font-weight: 400;
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .tag--chip,
  .tag--simple {
    color: var(--color-text-secondary);
  }

  .tag--accent {
    color: var(--color-accent);
  }

  .tag__hash {
    /* The hash is a thin glyph: set larger than the text so it reads at the same visual size. */
    margin-right: -0.125rem;
    font-size: 1.25em;
    opacity: 0.7;
  }

  .tag :global(.tag__icon) {
    opacity: 0.85;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  /* A technology logo takes its real brand colour while the tag is hovered or focused (P1 exception). */
  .tag:hover :global(.tag__icon),
  .tag:focus-visible :global(.tag__icon) {
    color: var(--brand, currentColor);
    opacity: 1;
  }

  .tag--link:hover,
  .tag--link:focus-visible,
  :global(.group):hover .tag {
    color: var(--color-text);
  }
</style>
