---
export interface TagProps {
  text: string
  href?: string
  prefix?: string
  theme?: 'pill' | 'simple' | 'label'
  class?: string
}

const {
  text,
  href,
  prefix = '#',
  theme = 'pill',
  class: className = '',
} = Astro.props as TagProps

const themeClassMap = {
  pill:
    'rounded-full border border-line-strong px-2 py-0.5 text-label font-semibold uppercase text-fg',
  simple:
    'text-label font-semibold uppercase text-fg-subtle transition-colors duration-fast ease-standard group-hover:text-fg-secondary',
  label:
    'inline-block rounded bg-white/10 px-1.5 py-0.5 text-label font-semibold uppercase text-fg-muted transition-colors duration-fast ease-standard group-hover:bg-white group-hover:text-surface',
} as const

const baseClass = themeClassMap[theme] ?? themeClassMap.pill

const effectivePrefix = theme === 'label' ? '' : prefix
---

{
  href ? (
    <a href={href} class={`${baseClass} ${className}`.trim()}>
      {effectivePrefix}
      {text}
    </a>
  ) : (
    <span class={`${baseClass} ${className}`.trim()}>
      {effectivePrefix}
      {text}
    </span>
  )
}
