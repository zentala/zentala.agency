---
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import { SHOW_DRAFTS } from '@/config/blog'

/**
 * The one DRAFT marker. Renders only where drafts are shown (never in production).
 * Only `corner` is out of flow; `rule` and `state` take inline space unless the
 * caller positions them (see below):
 * - `corner`: a tag pinned to the top-right corner of the nearest positioned
 *   ancestor (cards, post hero); it sits in that box's padding.
 * - `rule`: a 1px vertical line placed between the part number and the title of
 *   a list row (F2-E), never at the far left of the row. It carries 0.5rem side
 *   margins; where titles must align with published rows (column layouts), the
 *   caller wraps it in an absolutely positioned box in the column gap and zeroes
 *   the margin (SeriesCard, SeriesList).
 * - `state`: the state name in grey after the title (inline, may wrap a line);
 *   shown only where the row is wide (container of 20rem or more).
 * - `inline`: plain text, only for a line that cannot wrap (a short label).
 * States, all neutral: a plain draft is a dashed line or tag; `review` (a
 * draft the agent judges ready for the owner's publication review) is a solid
 * line or tag labelled "Review"; `label` replaces the
 * text for other dev-only notes, e.g. a series that production would hide.
 */
interface Props {
  placement?: 'corner' | 'rule' | 'state' | 'inline'
  review?: boolean
  label?: string
}

const { placement = 'corner', review = false, label } = Astro.props
const text = label ?? (review ? 'Review' : 'Draft')
const hint = label
  ? `${label}: dev only`
  : review
    ? 'Ready for review by the owner: hidden in production until approved'
    : 'Draft: hidden in production'
const icon = review ? 'review' : 'draft'
const state = review ? 'review' : 'draft'
---

{
  SHOW_DRAFTS &&
    (placement === 'rule' ? (
      <span class={`draft-rule draft-rule--${state}`} title={hint}>
        <span class="sr-only">{text}</span>
      </span>
    ) : placement === 'state' ? (
      <span class="draft-state">{text}</span>
    ) : (
      <span
        class={`draft-tag draft-tag--${placement} draft-tag--${state}`}
        title={hint}
      >
        <SiteIcon name={icon} size="sm" class="draft-tag__icon" />
        {text}
      </span>
    ))
}

<style>
  .draft-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-text-subtle);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* 17px tall and 2px from the corner, so it ends inside the smallest card and
     hero padding (16px + content margin, 24px) and never meets the first line. */
  .draft-tag--corner {
    position: absolute;
    top: 2px;
    right: 2px;
    z-index: 3;
    padding: 2px 5px;
    background: var(--color-surface);
    border: 1px dashed var(--color-line-strong);
    pointer-events: none;
  }

  /* Review: a solid border and slightly brighter text; no colour. */
  .draft-tag--review {
    color: var(--color-text-secondary);
  }

  .draft-tag--corner.draft-tag--review {
    border-style: solid;
    border-color: var(--color-line-strong);
  }

  .draft-tag--inline {
    margin-left: 0.5rem;
  }

  .draft-rule {
    display: inline-block;
    align-self: stretch;
    width: 0;
    min-height: 1em;
    margin-inline: 0.5rem;
    border-left: 1px dashed var(--color-line-strong);
    vertical-align: middle;
  }

  .draft-rule--review {
    border-left-style: solid;
  }

  .draft-state {
    display: none;
    margin-left: 0.5rem;
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  @container (min-width: 20rem) {
    .draft-state {
      display: inline;
    }
  }
</style>
