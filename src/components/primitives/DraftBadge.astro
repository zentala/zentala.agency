---
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import { SHOW_DRAFTS } from '@/config/blog'

/**
 * The one DRAFT marker. Renders only where drafts are shown (never in production)
 * and never takes layout space, so a page is as tall in dev as in production:
 * - `corner`: a tag pinned to the top-right corner of the nearest positioned
 *   ancestor (cards, post hero); it sits in that box's padding.
 * - `edge`: a 2px translucent bar just left of the nearest positioned ancestor (list rows).
 * - `inline`: plain text, only for a line that cannot wrap (a short label).
 * States, all neutral: a plain draft is a 2px dashed bar or tag; `review` (a
 * draft the agent judges ready for the owner's publication review) is a thin
 * solid bar (also 2px, translucent) or tag labelled "Review"; `label` replaces the
 * text for other dev-only notes, e.g. a series that production would hide.
 */
interface Props {
  placement?: 'corner' | 'edge' | 'inline'
  review?: boolean
  label?: string
}

const { placement = 'corner', review = false, label } = Astro.props
const text = label ?? (review ? 'Review' : 'Draft')
const hint = label
  ? `${label}: dev only`
  : review
    ? 'Ready for review by the owner: hidden in production until approved'
    : 'Draft: hidden in production'
const icon = review ? 'review' : 'draft'
const state = review ? 'review' : 'draft'
---

{
  SHOW_DRAFTS &&
    (placement === 'edge' ? (
      <span class={`draft-edge draft-edge--${state}`} title={hint}>
        <span class="sr-only">{text}</span>
      </span>
    ) : (
      <span
        class={`draft-tag draft-tag--${placement} draft-tag--${state}`}
        title={hint}
      >
        <SiteIcon name={icon} size="sm" class="draft-tag__icon" />
        {text}
      </span>
    ))
}

<style>
  .draft-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-text-subtle);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* 17px tall and 2px from the corner, so it ends inside the smallest card and
     hero padding (16px + content margin, 24px) and never meets the first line. */
  .draft-tag--corner {
    position: absolute;
    top: 2px;
    right: 2px;
    z-index: 3;
    padding: 2px 5px;
    background: var(--color-surface);
    border: 1px dashed var(--color-line-strong);
    pointer-events: none;
  }

  /* Review: a solid border and slightly brighter text; no colour. */
  .draft-tag--review {
    color: var(--color-text-secondary);
  }

  .draft-tag--corner.draft-tag--review {
    border-style: solid;
    border-color: var(--color-line-strong);
  }

  .draft-tag--inline {
    margin-left: 0.5rem;
  }

  .draft-edge {
    --draft-edge-color: rgb(255 255 255 / 0.22);
    position: absolute;
    top: 0.3em;
    bottom: 0.3em;
    left: -0.5rem;
    width: 2px;
    background: repeating-linear-gradient(
      to bottom,
      var(--draft-edge-color) 0 4px,
      transparent 4px 8px
    );
    pointer-events: none;
  }

  .draft-edge--review {
    background: var(--draft-edge-color);
  }
</style>
