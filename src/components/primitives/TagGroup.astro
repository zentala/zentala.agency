---
import Tag from './Tag.astro'

export interface TagGroupProps {
  tags: string[]
  class?: string
  tagClass?: string
  theme?: 'chip' | 'simple' | 'label'
  prefix?: string
  hrefPrefix?: string
  /** Show a technology logo on tags that have one. */
  tech?: boolean
}

const {
  tags,
  class: className = '',
  tagClass = '',
  theme = 'chip',
  prefix = '#',
  hrefPrefix,
  tech = false,
} = Astro.props as TagGroupProps
---

<div class:list={['flex flex-wrap gap-1.5', className]}>
  {
    tags.map((tag: string) => (
      <Tag
        text={tag}
        prefix={prefix}
        href={hrefPrefix ? `${hrefPrefix}${tag}` : undefined}
        theme={theme}
        tech={tech ? tag : undefined}
        class={tagClass}
      />
    ))
  }
</div>
