---
import GalleryEntry from './GalleryEntry.astro'
import GalleryCell from './GalleryCell.astro'
import Button from '@/components/Button.astro'
import CTA from '@/components/CTA.astro'
import PostCta from '@/components/PostCta.astro'
import Quote from '@/components/Quote.astro'
import Logo from '@/components/Logo.astro'
import TagList from '@/components/TagList.astro'
import TextBlockIcon from '@/components/TextBlockIcon.astro'
import ThemedInput from '@/components/ThemedInput.astro'
import ThemedTextarea from '@/components/ThemedTextarea.astro'
import ContactForm from '@/components/ContactForm.astro'
import TrustedMe from '@/components/TrustedMe.astro'

const ctaButtons = [
  { href: '/contact', text: 'Get started', variant: 'primary' },
  {
    href: 'https://cal.com/zentala',
    text: 'Book a call',
    variant: 'secondary',
    target: '_blank',
  },
] as const
const ctaFooter = [
  { icon: 'map-pin', text: 'Warsaw, Poland' },
  { text: 'Working worldwide' },
]
---

<GalleryEntry id="button" cols={3}>
  <GalleryCell label="primary (default)">
    <Button href="/contact" text="Get started" />
  </GalleryCell>
  <GalleryCell label="secondary: outlined">
    <Button href="/contact" text="Get started" variant="secondary" />
  </GalleryCell>
  <GalleryCell label="accent">
    <Button href="/contact" text="Get started" variant="accent" />
  </GalleryCell>
  <GalleryCell label="secondary, icon, no arrow">
    <Button
      href="https://cal.com/zentala"
      text="Book a call"
      icon="calendar"
      variant="secondary"
      arrow={false}
      target="_blank"
    />
  </GalleryCell>
  <GalleryCell label="primary, icon and arrow">
    <Button href="/contact" text="Get started" icon="rocket" />
  </GalleryCell>
  <GalleryCell label="accent, icon, no arrow">
    <Button href="/contact" text="Write to me" icon="envelope-simple" variant="accent" arrow={false} />
  </GalleryCell>
  <GalleryCell label="secondary, arrow">
    <Button href="/portfolio" text="See the portfolio" variant="secondary" />
  </GalleryCell>
  <GalleryCell label="ghost: text and chevron only">
    <Button href="/blog" text="All posts" variant="ghost" />
  </GalleryCell>
  <GalleryCell label="tier cta (under review): solid blue, the one key action">
    <Button tier="cta" href="https://cal.com/zentala" text="Book a call" icon="calendar-plus" />
  </GalleryCell>
  <GalleryCell label="tier primary: solid white">
    <Button tier="primary" href="/contact" text="Get started" />
  </GalleryCell>
  <GalleryCell label="tier secondary: grey">
    <Button tier="secondary" href="/portfolio" text="See the portfolio" />
  </GalleryCell>
  <GalleryCell label="tier tertiary: quieter grey">
    <Button tier="tertiary" href="/blog" text="All posts" />
  </GalleryCell>
  <GalleryCell label="tier, icon on the right (no chevron)">
    <Button tier="secondary" href="/contact" text="Write to me" icon="envelope-simple" iconPosition="right" />
  </GalleryCell>
  <GalleryCell label="tier primary as a submit button">
    <Button tier="primary" type="button" text="Send message" icon="paper-plane-tilt" iconPosition="right" />
  </GalleryCell>
</GalleryEntry>

<GalleryEntry id="cta" cols={1}>
  <GalleryCell label="headline, buttons, footer facts">
    <div style="width: 100%">
      <CTA
        headline="Ready to build this in your team?"
        subhead="Start with a free 30-minute call."
        buttons={ctaButtons}
        footerItems={ctaFooter}
      />
    </div>
  </GalleryCell>
</GalleryEntry>

<GalleryEntry id="post-cta" cols={2}>
  <GalleryCell label="harness variant"
    ><div style="width: 100%"><PostCta variant="harness" /></div></GalleryCell
  >
  <GalleryCell label="default"
    ><div style="width: 100%"><PostCta /></div></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="quote" cols={3}>
  <GalleryCell label="typographic, author and source">
    <Quote
      text="Implementing a developer portal is not only technical; it is also cultural."
      author="Paweł Żentała"
      source="Developer portal guide"
    />
  </GalleryCell>
  <GalleryCell label="heavy marks, author">
    <Quote
      text="Innovation has always fascinated me."
      author="Paweł Żentała"
      quoteMarkVariant="heavy"
    />
  </GalleryCell>
  <GalleryCell label="no author">
    <Quote text="The future belongs to those who prepare for it today." />
  </GalleryCell>
  <GalleryCell label="heavy marks, no author">
    <Quote
      text="Every line has exactly one owner."
      quoteMarkVariant="heavy"
    />
  </GalleryCell>
</GalleryEntry>

<GalleryEntry id="hero" cols={1}>
  <GalleryCell label="live example: the header of this page">
    <p>
      Hero renders its own <code class="font-mono">section-grid</code> and an h1,
      so it is not repeated inside a cell. The header of this page uses it with title,
      subtitle and eyebrow; <a href="/portfolio">/portfolio</a> uses it without an
      eyebrow.
    </p>
  </GalleryCell>
</GalleryEntry>
<GalleryEntry id="logo" cols={2}>
  <GalleryCell label="full"
    ><Logo
      type="full"
      width="200px"
      height="40px"
      color="var(--color-text)"
    /></GalleryCell
  >
  <GalleryCell label="sygnet"
    ><Logo
      type="sygnet"
      width="80px"
      height="80px"
      color="var(--color-text)"
    /></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="tag-list" cols={1}>
  <GalleryCell label="tag links"
    ><TagList tags={['backstage', 'agents', 'devex']} /></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="text-block-icon" cols={1}>
  <GalleryCell label="glyph, title, description">
    <div style="width: 100%">
      <TextBlockIcon
        icon="*"
        title="Light by default"
        description="A short sentence under the title."
      />
    </div>
  </GalleryCell>
</GalleryEntry>

<GalleryEntry id="themed-input" cols={3}>
  <GalleryCell label="text"
    ><ThemedInput
      type="text"
      id="gallery-name"
      placeholder="First name"
    /></GalleryCell
  >
  <GalleryCell label="email, with icon"
    ><ThemedInput
      type="email"
      id="gallery-email"
      icon="envelope-simple"
      placeholder="Email"
    /></GalleryCell
  >
  <GalleryCell label="phone, with icon"
    ><ThemedInput
      type="tel"
      id="gallery-phone"
      icon="phone"
      placeholder="Phone"
    /></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="themed-textarea" cols={1}>
  <GalleryCell label="default"
    ><ThemedTextarea
      id="gallery-message"
      placeholder="Your message"
    /></GalleryCell
  >
  <GalleryCell label="size large"
    ><ThemedTextarea
      id="gallery-message-large"
      placeholder="Describe the project"
      size="large"
    /></GalleryCell
  >
</GalleryEntry>

<!-- NOTE(intent): ContactForm is a cards-grid of its own, so the bare entry shows it as a standalone grid, the way a page places it. -->
<GalleryEntry id="contact-form" bare>
  <ContactForm />
</GalleryEntry>

<GalleryEntry id="trusted-me" cols={1}>
  <GalleryCell label="client strip">
    <p>Needs real client logos: with none configured the strip renders nothing.</p>
    <div style="width: 100%"><TrustedMe /></div>
  </GalleryCell>
</GalleryEntry>
