---
import GalleryEntry from './GalleryEntry.astro'
import GalleryCell from './GalleryCell.astro'
import Button from '@/components/Button.astro'
import CTA from '@/components/CTA.astro'
import PostCta from '@/components/PostCta.astro'
import Quote from '@/components/Quote.astro'
import Logo from '@/components/Logo.astro'
import TagList from '@/components/TagList.astro'
import TextBlockIcon from '@/components/TextBlockIcon.astro'
import ThemedInput from '@/components/ThemedInput.astro'
import ThemedTextarea from '@/components/ThemedTextarea.astro'
import ContactForm from '@/components/ContactForm.astro'
import FormFoot from '@/components/FormFoot.astro'
import TrustedMe from '@/components/TrustedMe.astro'

const ctaButtons = [
  { href: '/contact', text: 'Get started', tier: 'cta' },
  {
    href: 'https://cal.com/zentala',
    text: 'Book a call',
    tier: 'secondary',
    target: '_blank',
  },
] as const
const ctaFooter = [
  { icon: 'location', text: 'Warsaw, Poland' },
  { text: 'Working worldwide' },
]
---

<GalleryEntry id="button" cols={3}>
  <GalleryCell label="tier cta: solid blue, the one key action of a screen">
    <Button tier="cta" href="https://cal.com/zentala" text="Book a call" icon="book-call" />
  </GalleryCell>
  <GalleryCell label="tier primary (default): solid white">
    <Button href="/contact" text="Get started" />
  </GalleryCell>
  <GalleryCell label="tier secondary: grey">
    <Button tier="secondary" href="/portfolio" text="See the portfolio" />
  </GalleryCell>
  <GalleryCell label="tier tertiary: quieter grey">
    <Button tier="tertiary" href="/blog" text="All posts" />
  </GalleryCell>
  <GalleryCell label="icon on the left, no chevron">
    <Button tier="secondary" href="https://cal.com/zentala" text="Book a call" icon="book-call" arrow={false} target="_blank" />
  </GalleryCell>
  <GalleryCell label="icon on the right (replaces the chevron)">
    <Button tier="secondary" href="/contact" text="Write to me" icon="email" iconPosition="right" />
  </GalleryCell>
  <GalleryCell label="icon and chevron">
    <Button tier="primary" href="/contact" text="Get started" icon="launch" />
  </GalleryCell>
  <GalleryCell label="tier primary as a button element">
    <Button tier="primary" type="button" text="Send message" icon="send" iconPosition="right" />
  </GalleryCell>
</GalleryEntry>

<GalleryEntry id="cta" cols={1}>
  <GalleryCell label="headline, buttons, footer facts">
    <div style="width: 100%">
      <CTA
        headline="Ready to build this in your team?"
        subhead="Start with a free 30-minute call."
        buttons={ctaButtons}
        footerItems={ctaFooter}
      />
    </div>
  </GalleryCell>
</GalleryEntry>

<GalleryEntry id="post-cta" cols={2}>
  <GalleryCell label="harness variant"
    ><div style="width: 100%"><PostCta variant="harness" /></div></GalleryCell
  >
  <GalleryCell label="default"
    ><div style="width: 100%"><PostCta /></div></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="quote" cols={3}>
  <GalleryCell label="typographic, author and source">
    <Quote
      text="Implementing a developer portal is not only technical; it is also cultural."
      author="Paweł Żentała"
      source="Developer portal guide"
    />
  </GalleryCell>
  <GalleryCell label="heavy marks, author">
    <Quote
      text="Innovation has always fascinated me."
      author="Paweł Żentała"
      quoteMarkVariant="heavy"
    />
  </GalleryCell>
  <GalleryCell label="no author">
    <Quote text="The future belongs to those who prepare for it today." />
  </GalleryCell>
  <GalleryCell label="heavy marks, no author">
    <Quote
      text="Every line has exactly one owner."
      quoteMarkVariant="heavy"
    />
  </GalleryCell>
</GalleryEntry>

<GalleryEntry id="hero" cols={1}>
  <GalleryCell label="live example: the header of this page">
    <p>
      Hero renders its own <code class="font-mono">section-grid</code> and an h1,
      so it is not repeated inside a cell. The header of this page uses it with title,
      subtitle and eyebrow; <a href="/portfolio">/portfolio</a> uses it without an
      eyebrow.
    </p>
  </GalleryCell>
</GalleryEntry>
<GalleryEntry id="logo" cols={2}>
  <GalleryCell label="full"
    ><Logo
      type="full"
      width="200px"
      height="40px"
      color="var(--color-text)"
    /></GalleryCell
  >
  <GalleryCell label="sygnet"
    ><Logo
      type="sygnet"
      width="80px"
      height="80px"
      color="var(--color-text)"
    /></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="tag-list" cols={1}>
  <GalleryCell label="tag links"
    ><TagList tags={['backstage', 'agents', 'devex']} /></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="text-block-icon" cols={1}>
  <GalleryCell label="glyph, title, description">
    <div style="width: 100%">
      <TextBlockIcon
        icon="*"
        title="Light by default"
        description="A short sentence under the title."
      />
    </div>
  </GalleryCell>
</GalleryEntry>

<!-- NOTE(intent): borderless fields have no lines of their own, so each entry wraps them in a line grid, the way a form places them. -->
<GalleryEntry id="themed-input" bare>
  <div class="line-grid">
    <ThemedInput type="text" id="gallery-name" placeholder="First name" />
    <ThemedInput type="email" id="gallery-email" icon="email" placeholder="Email (with icon)" />
    <ThemedInput type="tel" id="gallery-phone" icon="phone" placeholder="Phone (with icon)" />
    <ThemedInput
      type="email"
      id="gallery-error"
      icon="email"
      placeholder="Email (error)"
      error="Enter a valid email address."
    />
    <ThemedInput type="text" id="gallery-disabled" placeholder="Disabled" disabled />
    <ThemedInput type="text" id="gallery-required" placeholder="Required" required />
  </div>
</GalleryEntry>

<GalleryEntry id="themed-textarea" bare>
  <div class="line-grid" style="--cols-wide: 2; --cols-medium: 2">
    <ThemedTextarea id="gallery-message" icon="message" placeholder="Your message" />
    <ThemedTextarea
      id="gallery-message-large"
      placeholder="Describe the project (size large)"
      size="large"
    />
    <ThemedTextarea
      id="gallery-message-error"
      placeholder="Your message (error)"
      error="Write at least a few words."
    />
    <ThemedTextarea id="gallery-message-disabled" placeholder="Disabled" disabled />
  </div>
</GalleryEntry>

<GalleryEntry id="form-foot" bare>
  <div class="line-grid" style="--cols-wide: 1; --cols-medium: 1">
    <FormFoot note="Privacy note only (as on /contact)." />
    <FormFoot
      note="With a consent checkbox."
      checkName="gallery-copy"
      checkLabel="Send me a copy of this message"
    />
  </div>
</GalleryEntry>

<!-- NOTE(intent): ContactForm is a cards-grid of its own, so the bare entry shows it as a standalone grid, the way a page places it. -->
<GalleryEntry id="contact-form" bare>
  <ContactForm />
</GalleryEntry>

<GalleryEntry id="trusted-me" cols={1}>
  <GalleryCell label="client strip">
    <p>Needs real client logos: with none configured the strip renders nothing.</p>
    <div style="width: 100%"><TrustedMe /></div>
  </GalleryCell>
</GalleryEntry>
