---
/**
 * Typography of the site, dev only: the font stack, the font the page renders now
 * (it follows the "Czcionka" axis of the Warianty switcher) and one heading and paragraph
 * at the site weights. The stack lives in `--font-sans` (src/styles/tokens.scss).
 */
import Section from '@/components/primitives/sections/Section.astro'
import SectionHeader from '@/components/primitives/sections/SectionHeader.astro'
import { VARIANT_AXES } from '@/components/dev/variant-switcher/axes'

const SAMPLE_HEADING = 'Agents need a harness, not a bigger prompt'
const SAMPLE_BODY =
  'The machinery around coding agents is what keeps parallel work from overwriting itself: a registry, a lease on the checkout and a knowledge base they can all read.'

const fontAxis = VARIANT_AXES.find((axis) => axis.id === 'font')
const FONT_NAMES = Object.fromEntries(
  (fontAxis?.options ?? []).map((option) => [option.value, option.label]),
)

const STACK = ['Segoe UI', 'Open Sans Matched', 'system-ui', 'sans-serif']
const WEIGHTS = [
  { weight: 300, label: 'Titles, 300' },
  { weight: 400, label: 'Body, 400' },
  { weight: 600, label: 'Labels, header and menu, 600' },
]
---

<Section id="typography">
  <SectionHeader
    headline="Typography"
    subhead="Segoe UI, then self-hosted Open Sans scaled to its width. Switch the font in the Warianty panel to compare candidates."
  />
  <div class="line-grid typography-grid" data-typography-gallery>
    <div class="typography-cell">
      <p class="typography-cell__label">Stack</p>
      <p class="typography-cell__body" data-typography-stack>{STACK.join(', ')}</p>
      <p class="typography-cell__label">Active font</p>
      <p class="typography-cell__heading" data-typography-active>Segoe UI</p>
      <p class="typography-cell__note" data-typography-note></p>
    </div>
    {
      WEIGHTS.map((item) => (
        <div class="typography-cell">
          <p class="typography-cell__label">{item.label}</p>
          <h2 class="typography-cell__heading" style={`font-weight: ${item.weight}`}>
            {SAMPLE_HEADING}
          </h2>
          <p class="typography-cell__body" style={`font-weight: ${item.weight}`}>
            {SAMPLE_BODY}
          </p>
        </div>
      ))
    }
  </div>
</Section>

<script is:inline define:vars={{ FONT_NAMES }}>
  const gallery = document.querySelector('[data-typography-gallery]')
  const sync = () => {
    const chosen = document.documentElement.getAttribute('data-v-font')
    gallery.querySelector('[data-typography-active]').textContent = FONT_NAMES[chosen ?? 'default']
    gallery.querySelector('[data-typography-note]').textContent = chosen
      ? 'Chosen in the Warianty switcher, for comparison only.'
      : 'The production font.'
  }
  new MutationObserver(sync).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-v-font'],
  })
  sync()
</script>

<style is:global>
  .typography-cell {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: clamp(1rem, 2.5vw, 2rem);
  }

  .typography-cell p {
    margin: 0;
  }

  .typography-cell__label {
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--text-label);
    color: var(--color-text-subtle);
  }

  .typography-cell__heading {
    margin: 0;
    font-size: var(--text-h3);
    font-weight: 300;
    line-height: 1.2;
    color: var(--color-text);
  }

  .typography-cell__body {
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .typography-cell__note {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }
</style>
