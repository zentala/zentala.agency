---
import GalleryEntry from './GalleryEntry.astro'
import GalleryCell from './GalleryCell.astro'
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import BrandIcon from '@/components/primitives/BrandIcon.astro'
import TechIcon from '@/components/primitives/TechIcon.astro'
import Badge from '@/components/primitives/Badge.astro'
import Tag from '@/components/primitives/Tag.astro'
import TagGroup from '@/components/primitives/TagGroup.astro'
import DraftBadge from '@/components/primitives/DraftBadge.astro'
import PhaseLabel from '@/components/primitives/PhaseLabel.astro'
import NoteBox from '@/components/primitives/NoteBox.astro'
import TruncateText from '@/components/primitives/TruncateText.astro'
import ImageCircle from '@/components/primitives/ImageCircle.astro'
import CardBackgroundIcon from '@/components/primitives/CardBackgroundIcon.astro'
import CardIconMosaic from '@/components/primitives/CardIconMosaic.astro'

const AVATAR = 'https://cdn.zentala.agency/images/avatar.jpg'
const LONG_TEXT =
  'A line grid separates content with 1px lines that join into one continuous grid, so every line has exactly one owner and nothing doubles when a card is added or removed.'
const TAGS = ['backstage', 'agents', 'devex']
---

<GalleryEntry id="site-icon" cols={3}>
  <GalleryCell label="sm 16, Bold"><SiteIcon name="database" size="sm" /></GalleryCell>
  <GalleryCell label="18, Bold (nav, button)"><SiteIcon name="database" size={18} /></GalleryCell>
  <GalleryCell label="md 20, Bold (default)"><SiteIcon name="ai-agent" /></GalleryCell>
  <GalleryCell label="lg 24, Regular"
    ><SiteIcon name="devops" size="lg" /></GalleryCell
  >
  <GalleryCell label="32, Light"><SiteIcon name="devops" size={32} /></GalleryCell>
  <GalleryCell label="64, Thin"><SiteIcon name="devops" size={64} /></GalleryCell>
</GalleryEntry>

<GalleryEntry id="tech-icon" cols={3}>
  <GalleryCell label="astro, md"><TechIcon name="astro" /></GalleryCell>
  <GalleryCell label="typescript, lg"
    ><TechIcon name="typescript" size="lg" /></GalleryCell
  >
  <GalleryCell label="brand colour"
    ><TechIcon name="react" size="lg" brand="#61DAFB" /></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="brand-icon" cols={3}>
  <GalleryCell label="linkedin, 33"><BrandIcon name="linkedin" /></GalleryCell>
  <GalleryCell label="github, 33"><BrandIcon name="github" /></GalleryCell>
  <GalleryCell label="email, 33"><BrandIcon name="email" /></GalleryCell>
</GalleryEntry>

<GalleryEntry id="badge" cols={3}>
  <GalleryCell label="tech, sm (default)"><Badge>Backstage</Badge></GalleryCell>
  <GalleryCell label="tech, md"><Badge size="md">TypeScript</Badge></GalleryCell
  >
  <GalleryCell label="accent, sm"
    ><Badge variant="accent">New</Badge></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="tag" cols={3}>
  <GalleryCell label="chip (default)"><Tag text="agents" /></GalleryCell>
  <GalleryCell label="chip, as link"
    ><Tag text="devex" theme="simple" href="/category/devex" /></GalleryCell
  >
  <GalleryCell label="chip, no hash"
    ><Tag text="Harness" theme="label" /></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="tag-group" cols={3}>
  <GalleryCell label="chip (default)"><TagGroup tags={TAGS} /></GalleryCell>
  <GalleryCell label="chip, theme simple"
    ><TagGroup tags={TAGS} theme="simple" /></GalleryCell
  >
  <GalleryCell label="chip, no hash, as links"
    ><TagGroup tags={TAGS} theme="label" hrefPrefix="/tag/" /></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="draft-badge" cols={3}>
  <GalleryCell label="corner, draft">
    <p>A card or hero with a pinned marker.</p>
    <DraftBadge />
  </GalleryCell>
  <GalleryCell label="corner, review: draft ready for the owner">
    <p>The agent judged this draft ready to publish.</p>
    <DraftBadge review />
  </GalleryCell>
  <GalleryCell label="corner, custom label">
    <p>A dev-only note, for example a series production would hide.</p>
    <DraftBadge label="Hidden: 1 part" />
  </GalleryCell>
  <GalleryCell label="inline, draft"
    ><p>Short label <DraftBadge placement="inline" /></p></GalleryCell
  >
  <GalleryCell label="inline, review"
    ><p>Short label <DraftBadge placement="inline" review /></p></GalleryCell
  >
  <GalleryCell label="rule: 1px line between number and title, draft">
    <div class="[container-type:inline-size]">
      <p>03<DraftBadge placement="rule" />Part title<DraftBadge placement="state" /></p>
    </div>
  </GalleryCell>
  <GalleryCell label="rule, review">
    <div class="[container-type:inline-size]">
      <p>
        03<DraftBadge placement="rule" review />Part title<DraftBadge
          placement="state"
          review
        />
      </p>
    </div>
  </GalleryCell>
</GalleryEntry>

<GalleryEntry id="phase-label" cols={3}>
  <GalleryCell label="phase 1"><PhaseLabel phase={1} /></GalleryCell>
  <GalleryCell label="phase 2"><PhaseLabel phase={2} /></GalleryCell>
  <GalleryCell label="phase 3"><PhaseLabel phase={3} /></GalleryCell>
</GalleryEntry>

<!-- NOTE(intent): NoteBox draws a left bar that lives in prose; inside a grid cell the line guard would read it as a floating line, so it sits in a data-prose-widget box, the documented exception. -->
<GalleryEntry id="note-box" cols={2}>
  <GalleryCell label="default"
    ><div data-prose-widget style="width: 100%"><NoteBox title="Rule of thumb">Every line has one owner.</NoteBox></div></GalleryCell
  >
  <GalleryCell label="info, own icon"
    ><div data-prose-widget style="width: 100%"><NoteBox variant="info" icon="note-info" title="Good to know"
      >Drafts show only in dev.</NoteBox></div></GalleryCell
  >
  <GalleryCell label="success"
    ><div data-prose-widget style="width: 100%"><NoteBox variant="success" icon="done" title="Done"
      >The guard is green.</NoteBox></div></GalleryCell
  >
  <GalleryCell label="warning, no title"
    ><div data-prose-widget style="width: 100%"><NoteBox variant="warning" icon="note-warning"
      >Not published until the owner reviews it.</NoteBox></div></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="truncate-text" cols={3}>
  <GalleryCell label="maxLength 60"
    ><TruncateText text={LONG_TEXT} maxLength={60} /></GalleryCell
  >
  <GalleryCell label="maxLength 120, span"
    ><TruncateText
      text={LONG_TEXT}
      maxLength={120}
      element="span"
    /></GalleryCell
  >
  <GalleryCell label="shorter than the limit"
    ><TruncateText text="Short text stays whole." /></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="image-circle" cols={3}>
  <GalleryCell label="default, hover zoom"
    ><div style="width: 6rem">
      <ImageCircle src={AVATAR} alt="Paweł Żentała" />
    </div></GalleryCell
  >
  <GalleryCell label="no hover zoom"
    ><div style="width: 6rem">
      <ImageCircle src={AVATAR} alt="Paweł Żentała" hoverZoom={false} />
    </div></GalleryCell
  >
  <GalleryCell label="lazy"
    ><div style="width: 4rem">
      <ImageCircle src={AVATAR} alt="Paweł Żentała" loading="lazy" />
    </div></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="card-background-icon" cols={3}>
  <GalleryCell label="robot"
    ><div style="position: relative; isolation: isolate; min-height: 8rem; width: 100%">
      <CardBackgroundIcon icon="ai-agent" />
    </div></GalleryCell
  >
  <GalleryCell label="handshake"
    ><div style="position: relative; isolation: isolate; min-height: 8rem; width: 100%">
      <CardBackgroundIcon icon="partnership" />
    </div></GalleryCell
  >
  <GalleryCell label="stack"
    ><div style="position: relative; isolation: isolate; min-height: 8rem; width: 100%">
      <CardBackgroundIcon icon="series" />
    </div></GalleryCell
  >
</GalleryEntry>

<GalleryEntry id="card-icon-mosaic" cols={1}>
  <GalleryCell label="3x3 portfolio mosaic (hover a tile)">
    <div style="position: relative; height: 24rem; width: 100%">
      <CardIconMosaic
        tiles={[
          { icon: 'web-design', label: 'Web design' },
          { icon: 'indoor-location', label: 'Indoor location' },
          { icon: 'nfc-table', label: 'NFC table' },
          { icon: 'capabilities', label: 'Developer portals' },
          { icon: 'ai-agent', label: 'Humanoid robot' },
          { icon: 'home', label: 'Smart home' },
          { icon: 'wifi-community', label: 'WiFi community' },
          { icon: 'smart-desk', label: 'Smart desk' },
          { icon: 'nick-finder', label: 'Nick finder' },
        ]}
      />
    </div>
  </GalleryCell>
</GalleryEntry>
