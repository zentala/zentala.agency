---
/**
 * One gallery section: the component name and one-line purpose, where it is used
 * (computed from the imports), its props in plain or TypeScript form (the page-wide
 * toggle), then its examples. Built from the line model.
 * - Default: the slot holds cells (GalleryCell, or cards directly) in a `.line-grid`.
 *   `cols` sets the columns; 3 closes an incomplete last row with `line-grid--fill-last`,
 *   so every child of a 3-column entry must be a `div`.
 * - `bare`: the slot holds standalone blocks or grids (line-block, SectionGrid,
 *   SectionBento), which draw their own top line. The meta block above draws none.
 * - Slot `after`: a component that is a section of its own (PostNav); it follows the Section.
 */
import Section from '@/components/primitives/sections/Section.astro'
import SectionHeader from '@/components/primitives/sections/SectionHeader.astro'
import { GALLERY_ITEMS } from './manifest'
import { propsInterface, toSrcPath, usedIn } from '@/lib/demo/component-info'
import { highlightPlainProps, highlightTypeScript } from '@/lib/demo/highlight'

interface Props {
  id: string
  cols?: 1 | 2 | 3 | 4
  bare?: boolean
}

const { id, cols = 3, bare = false } = Astro.props

const item = GALLERY_ITEMS.find((candidate) => candidate.id === id)
if (!item) throw new Error(`GalleryEntry: no manifest row with id "${id}"`)

const used = usedIn(item.path)
const typeScript = propsInterface(item.path)
const plainHtml = highlightPlainProps(item.props)
const typeScriptHtml = highlightTypeScript(
  typeScript ?? `// no Props interface: ${item.props}`,
)

const COLUMNS_STYLE = {
  1: '--cols-wide: 1; --cols-medium: 1; --cols-narrow: 1',
  2: '--cols-wide: 2; --cols-medium: 2; --cols-narrow: 1',
  3: undefined,
  4: '--cols-wide: 4; --cols-medium: 2; --cols-narrow: 1',
} as const
---

<Section id={id}>
  <SectionHeader headline={item.name} subhead={item.purpose} tag="h2" />
  <div class="gallery-meta">
    <p class="gallery-meta__row">
      <span class="gallery-meta__key">File</span>
      <code class="font-mono">{toSrcPath(item.path)}</code>
    </p>
    <p class="gallery-meta__row">
      <span class="gallery-meta__key">Used in</span>
      <span class="gallery-meta__links">
        {used.everywhere && <span>every page, through the layout</span>}
        {
          used.pages.map((page) =>
            page.href ? (
              <a href={page.href}>{page.route}</a>
            ) : (
              <span>{page.route}</span>
            ),
          )
        }
        {used.more > 0 && <span>and {used.more} more</span>}
        {
          !used.everywhere && used.pages.length === 0 && (
            <span>{item.usedNote ?? 'no page yet, only this gallery'}</span>
          )
        }
      </span>
    </p>
    {
      item.note && (
        <p class="gallery-meta__row">
          <span class="gallery-meta__key">Note</span>
          {item.noteHref ? <a href={item.noteHref}>{item.note}</a> : <span>{item.note}</span>}
        </p>
      )
    }
    <div class="gallery-meta__row">
      <span class="gallery-meta__key">Props</span>
      <div class="gallery-code">
        <code class="font-mono gallery-code__plain" set:html={plainHtml} />
        <pre class="font-mono gallery-code__ts"><code set:html={typeScriptHtml} /></pre>
      </div>
    </div>
  </div>
  {
    !Astro.slots.has('default') ? null : bare ? (
      <slot />
    ) : (
      <div
        class:list={['line-grid', 'gallery-examples', cols === 3 && 'line-grid--fill-last']}
        style={COLUMNS_STYLE[cols]}
      >
        <slot />
      </div>
    )
  }
</Section>
<slot name="after" />

<style>
  .gallery-meta {
    padding: clamp(1rem, 2.5vw, 2rem);
    display: grid;
    gap: 0.5rem;
  }

  .gallery-meta__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    font-size: var(--text-sm, 0.875rem);
    color: var(--color-text-muted, inherit);
  }

  .gallery-meta__key {
    min-width: 4.5rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--text-label);
    color: var(--color-text-subtle, inherit);
  }

  .gallery-meta__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .gallery-meta a,
  .gallery-meta__links a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .gallery-meta a:hover {
    color: var(--color-text);
  }

  .gallery-meta code {
    overflow-wrap: anywhere;
  }

  .gallery-code {
    min-width: 0;
    flex: 1;
  }

  .gallery-code pre {
    margin: 0;
    white-space: pre-wrap;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .gallery-code__ts {
    display: none;
  }

  :global([data-props-mode='ts']) .gallery-code__plain {
    display: none;
  }

  :global([data-props-mode='ts']) .gallery-code__ts {
    display: block;
  }

  .gallery-code :global(.tok-key) {
    color: var(--color-text);
  }

  .gallery-code :global(.tok-type) {
    color: var(--color-accent);
  }

  .gallery-code :global(.tok-str) {
    color: var(--color-text-secondary);
  }

  .gallery-code :global(.tok-keyword),
  .gallery-code :global(.tok-punct),
  .gallery-code :global(.tok-comment) {
    color: var(--color-text-subtle);
  }

  .gallery-examples :global(.card-container) {
    color: var(--color-text-secondary);
  }

  .gallery-examples :global(.card-container h3) {
    color: var(--color-text);
  }

</style>
