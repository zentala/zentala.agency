---
/**
 * Gallery group "Variants under review": the four named SectionHeader looks, each
 * pinned with the `variant` prop, and the dev variant switcher.
 */
import SectionHeader from '@/components/primitives/sections/SectionHeader.astro'
import GalleryCell from '@/components/demo/GalleryCell.astro'
import GalleryEntry from '@/components/demo/GalleryEntry.astro'
import { VARIANT_AXES } from '@/components/dev/variant-switcher/axes'

const HEADLINE = 'Agent-Native Harness'
const SUBHEAD = 'How to build a repo an AI agent can actually work in'
const META = '17 parts'
const VARIANTS = ['a', 'b', 'c', 'd'] as const
---

<GalleryEntry id="section-header-variants" bare>
  {
    VARIANTS.map((variant) => (
      <SectionHeader
        variant={variant}
        tag="h3"
        headline={HEADLINE}
        subhead={SUBHEAD}
        labelIcon="series"
        meta={META}
      />
    ))
  }
</GalleryEntry>

<GalleryEntry id="variant-switcher" cols={1}>
  <GalleryCell label="where it is">
    <p>
      The panel is the "Warianty" button at the bottom left of this page. Its axes:
      {VARIANT_AXES.map((axis) => axis.id).join(', ')}. The first option of an axis
      is the current look and sets no attribute.
    </p>
  </GalleryCell>
</GalleryEntry>
