---
/**
 * Client strip. Renders nothing until a client has a real logo: add `logo` (a path
 * under /public or a URL of the client's own mark) to a client below. No placeholder
 * logos: the gallery lists this component as "needs real client logos".
 */
interface Client {
  name: string
  desc: string
  logo?: string
}

const clients: Client[] = [
  {
    name: 'Ubudu',
    desc: 'French RTLS startup. Developed RTLS admin panel and deployed systems across Asia.',
  },
  {
    name: 'Hypermedia',
    desc: 'International marketing agency. Engaged in modern web development with React.',
  },
  {
    name: 'Beamly',
    desc: 'British marketing agency. Developed website for Marc Jacobs fragrances.',
  },
  {
    name: 'GreenParrot',
    desc: 'Warsaw marketing agency. Specialized in WordPress web development.',
  },
  {
    name: 'DSB',
    desc: 'Dutch national railways. Built Backstage Developer Portal from scratch.',
  },
  {
    name: 'BSH',
    desc: 'Bosch Siemens home appliances. Developed software for home appliances.',
  },
  {
    name: 'ZF',
    desc: 'Car components manufacturer. Developed web panel for flashing software on car platforms.',
  },
  {
    name: 'Cheil',
    desc: 'Global marketing agency by Samsung. Developed merch robot and NFC-table for brand stores.',
  },
]

const logoClients = clients.filter((client) => client.logo)
---

{
  logoClients.length > 0 && (
<aside class="trusted-me-container">
  <ul>
    {
      logoClients.map((client) => (
        <li data-key={client.name}>
          <img src={client.logo} alt={client.name} class="client-logo" />
          <span class="tooltip">{client.desc}</span>
        </li>
      ))
    }
  </ul>
</aside>
  )
}

<style>
  .trusted-me-container {
    width: 100%;
    overflow-x: auto;
    display: flex;
    justify-content: center;
    align-items: center;

    ul {
      display: flex;
      gap: 20px;
      li {
        position: relative;
        .client-logo {
          width: 100px;
          height: auto;
          transition: transform var(--motion-base) var(--ease-standard);
          &:hover {
            transform: scale(1.1);

            @media (prefers-reduced-motion: reduce) {
              transform: none;
            }
          }
        }
        .tooltip {
          position: absolute;
          bottom: 100%;
          left: 50%;
          transform: translateX(-50%);
          background-color: var(--color-surface);
          border: 1px solid var(--color-line-strong);
          color: var(--color-text);
          padding: 10px;
          border-radius: var(--radius-sm);
          display: none;
          text-align: center;
          &:before {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            border-width: 5px;
            border-style: solid;
            border-color: var(--color-line-strong) transparent transparent transparent;
          }
        }
        &:hover .tooltip {
          display: block;
        }
      }
    }
  }
</style>
