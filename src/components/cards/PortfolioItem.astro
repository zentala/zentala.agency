---
import CardContainer from './CardContainer.astro'
import Tag from '../primitives/Tag.astro'
import SiteIcon from '../primitives/SiteIcon.astro'
import { isParkedLink } from '@/lib/links/parked'

export interface PortfolioItemProps {
  title: string
  subtitle: string
  image?: string
  link?: string
  linkTitle?: string
  key: string
  tags?: string[]
}

const { title, subtitle, linkTitle, key, tags } = Astro.props
// A parked link (src/data/parked-links.ts) renders the card as plain text, without link or CTA.
const parked = isParkedLink(Astro.props.link)
const link = parked ? undefined : Astro.props.link

// Determine target for external links
const target =
  link && (link.startsWith('http://') || link.startsWith('https://'))
    ? '_blank'
    : '_self'
---

<CardContainer
  href={link}
  target={target}
  class="portfolio-item"
  data-key={key}
>
  <!-- {image && <img src={image} alt={title} class="portfolio-item__image" />} -->

  <h2 class="portfolio-item__title">{title}</h2>
  <p class="portfolio-item__subtitle">{subtitle}</p>

  {
    tags && tags.length > 0 && (
      <div class="portfolio-item__tags">
        {tags.map((tag: string) => (
          <Tag theme="label" text={tag} tech={tag} />
        ))}
      </div>
    )
  }

  {
    linkTitle && !parked && (
      <p class="portfolio-item__link-title">
        {linkTitle}
        <SiteIcon name="caret-right" size="sm" class="portfolio-item__chevron" />
      </p>
    )
  }
</CardContainer>

<style lang="scss">
  @use '../../styles/components/cards' as *;

  .portfolio-item__title {
    @extend %card-title-medium;
  }

  .portfolio-item__subtitle {
    @extend %card-content;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .portfolio-item__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .portfolio-item__link-title {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 1rem;
    font-size: 0.875rem; /* text-sm */
    color: var(--color-accent);
    text-decoration: none;
  }

  .portfolio-item__link-title :global(.portfolio-item__chevron) {
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  :global(.card-container):hover .portfolio-item__link-title :global(.portfolio-item__chevron) {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.card-container):hover .portfolio-item__link-title :global(.portfolio-item__chevron) {
      transform: none;
    }
  }

  .portfolio-item__image {
    width: 100%;
    height: 12rem; /* h-48 */
    object-fit: cover;
    margin-bottom: 1rem;
    border-radius: 0.5rem;
  }

  /* Responsive typography */
  @media (max-width: 770px) {
    .portfolio-item__title {
      font-size: 1.25rem; /* text-xl */
    }

    .portfolio-item__subtitle {
      font-size: 1rem; /* text-base */
    }

    .portfolio-item__tags {
      margin-top: 0.75rem;
      gap: 0.375rem;
    }
  }

  @media (max-width: 480px) {
    .portfolio-item__title {
      font-size: 1.125rem; /* text-lg */
    }

    .portfolio-item__subtitle {
      font-size: 0.875rem; /* text-sm */
    }

    .portfolio-item__tags {
      margin-top: 0.5rem;
    }
  }
</style>
