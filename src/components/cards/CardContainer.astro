---
import CardBackgroundIcon from '../primitives/CardBackgroundIcon.astro'

export interface CardContainerProps {
  /** Anchor id, for links from elsewhere on the page. */
  id?: string
  href?: string
  hasHover?: boolean
  backgroundIcon?: string
  class?: string
  target?: '_blank' | '_self'
}

const {
  id,
  href,
  hasHover = !!href, // Default: hover if link exists
  backgroundIcon,
  class: className = '',
  target = '_self',
} = Astro.props

const Element = href ? 'a' : 'div'
---

<Element
  id={id}
  href={href}
  target={href ? target : undefined}
  class:list={[
    'card-container',
    hasHover && 'card-container--hover',
    className,
  ]}
>
  <div class="card-container__clip">
    {backgroundIcon && <CardBackgroundIcon icon={backgroundIcon} />}
    <div class="card-container__content">
      <slot />
    </div>
  </div>
</Element>

<style lang="scss">
  @use '../../styles/variables' as *;

  // A grid cell: lines come from the parent .line-grid, never from the card.
  .card-container {
    display: flex;
    flex-direction: column;
  }

  .card-container--hover {
    @include cell-interactive;
  }

  // Clipping lives on this inner wrapper so the cell's overlay can reach the neighbouring lines
  .card-container__clip {
    position: relative;
    flex: 1;
    overflow: clip;
    isolation: isolate;
  }

  .card-container__content {
    @include cell-padding;
    position: relative;
    z-index: 1;
    height: 100%;
  }
</style>
