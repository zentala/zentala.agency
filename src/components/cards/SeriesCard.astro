---
import type { CollectionEntry } from 'astro:content'
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import DraftBadge from '@/components/primitives/DraftBadge.astro'
import { formatDate } from '@/lib/blog/format-date'

export interface SeriesCardProps {
  title: string
  slug: string
  parts: CollectionEntry<'blog'>[]
  newestSlug: string
  isFresh: boolean
  /** Dev only: published parts of a series that production would hide. */
  hiddenInProduction?: number
}

const { title, slug, parts, newestSlug, isFresh, hiddenInProduction } =
  Astro.props as SeriesCardProps

const VISIBLE_EDGE_COUNT = 3
const isCollapsed = parts.length > 6
const hiddenCount = isCollapsed ? parts.length - VISIBLE_EDGE_COUNT * 2 : 0
---

<article class="cell-interactive">
  <div
    class="padding-responsive-md relative flex h-full flex-col items-start"
  >
    <a href={`/series/${slug}`} class="absolute inset-0 z-0" aria-label={title}
    ></a>
    {
      hiddenInProduction !== undefined && (
        <DraftBadge
          label={`Hidden in production (${hiddenInProduction} published)`}
        />
      )
    }

    <div class="card-content-wrapper flex w-full flex-col">
      <div
        class="flex items-center gap-x-1 text-label uppercase text-fg-subtle"
      >
        <SiteIcon name="layers" size="sm" />
        <span>Series</span>
        {
          isFresh && (
            <span class="relative z-10 ml-auto bg-surface-hover px-2 text-label uppercase leading-none text-fg-secondary">
              New
            </span>
          )
        }
      </div>
      <h3 class="mt-2">{title}</h3>
    </div>

    <ul class="mt-5 w-full space-y-1" data-series-parts>
      {
        parts.map((part, index) => {
          const isHidden =
            isCollapsed &&
            index >= VISIBLE_EDGE_COUNT &&
            index < parts.length - VISIBLE_EDGE_COUNT
          // The toggle sits where the gap actually is — right before the first
          // collapsed row — so the card reads 1 2 3 ··· 6 7 8.
          const isFirstHidden = isCollapsed && index === VISIBLE_EDGE_COUNT
          const isNewest = part.slug === newestSlug
          const partNumber = part.data.part ?? index + 1
          const date = formatDate(part.data.date)
          return (
            <>
              {isFirstHidden && (
                <li class="relative z-10">
                  <button
                    type="button"
                    class="-mx-2 w-full px-2 py-1 text-left text-sm text-fg-secondary transition-colors duration-fast ease-standard hover:bg-surface-hover hover:text-fg"
                    aria-expanded="false"
                    data-series-expand
                  >
                    Show {hiddenCount} more parts
                  </button>
                </li>
              )}
              <li
                class={isHidden ? 'hidden' : undefined}
                data-series-part
                data-series-middle={isHidden ? '' : undefined}
              >
                <a
                  href={`/blog/${part.slug}`}
                  class="relative z-10 -mx-2 flex items-start gap-x-2 px-2 py-1 text-sm transition-colors duration-fast ease-standard hover:bg-surface-hover hover:text-fg"
                  aria-current={isNewest ? 'true' : undefined}
                >
                  <span class="w-4 shrink-0 text-right text-xs tabular-nums text-fg-subtle">
                    <span class="sr-only">Part </span>
                    {partNumber}
                  </span>
                  <span class="flex min-w-0 flex-1 flex-col gap-y-0.5">
                    <span class="line-clamp-2 text-fg-secondary">
                      {part.data.title}
                    </span>
                    {part.data.published === false && <DraftBadge placement="edge" review={part.data.review} />}
                    {isNewest && (
                      <time
                        datetime={date.datetime}
                        class="text-xs text-fg-subtle"
                      >
                        {date.label}
                      </time>
                    )}
                  </span>
                </a>
              </li>
            </>
          )
        })
      }
    </ul>
  </div>
</article>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>(
      '[data-series-expand]',
    )
    const list = button?.closest('[data-series-parts]')
    if (!button || !list) return
    const isExpanding = button.getAttribute('aria-expanded') !== 'true'
    const middle = list.querySelectorAll<HTMLElement>('[data-series-middle]')
    middle.forEach((item) => item.classList.toggle('hidden', !isExpanding))
    button.setAttribute('aria-expanded', String(isExpanding))
    button.textContent = isExpanding
      ? 'Show fewer parts'
      : `Show ${middle.length} more parts`
    if (isExpanding) middle[0]?.querySelector('a')?.focus()
  })
</script>
