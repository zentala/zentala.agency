---
/**
 * Link monitor, dev only (/monitor/links): every outgoing link of the site with its last check
 * result. Dead links are grouped by source page with their place in source (file:line); then
 * the disabled links, page errors, unverified and reachable links. Reads the report written by
 * `just links` or a LINK_CHECK=1 build. Rendered by src/pages/monitor/[page].astro in dev only.
 * Layout: line-grid primitives only, neutral tokens, no colour for status.
 */
import Layout from '@/layouts/Layout.astro'
import Hero from '@/components/Hero.astro'
import Section from '@/components/primitives/sections/Section.astro'
import SectionHeader from '@/components/primitives/sections/SectionHeader.astro'
import DeadLinksByPage from '@/components/monitor/DeadLinksByPage.astro'
import LinkSummaryBar from '@/components/monitor/LinkSummaryBar.astro'
import { groupByStatus, outcomeLabel, readLatestReport } from '@/lib/links/report'
import { locateUrls } from '@/lib/links/source-map'
import { deadSummary, groupDeadByPage, isStale, reportAgeDays, STALE_AFTER_DAYS } from '@/lib/links/view'

const report = readLatestReport()
const groups = report ? groupByStatus(report.links) : null
const deadUrls = groups ? groups.dead.map((link) => link.url) : []
const locations = locateUrls(deadUrls)
const checkedAt = (iso: string) => iso.replace('T', ' ').slice(0, 16) + ' UTC'
const singleColumn = '--cols-wide: 1; --cols-medium: 1; --cols-narrow: 1'
---

<Layout title="Monitor linków" description="Linki wychodzące i ich ostatni status. Tylko dev." noindex>
  <Hero
    eyebrow="Tylko dev"
    title="Monitor linków"
    subtitle={report
      ? `${report.counts.total} linków wychodzących na ${report.pageCount} stronach`
      : 'Brak raportu'}
  />

  {
    !report || !groups ? (
      <Section id="empty">
        <div class="line-grid" style={singleColumn}>
          <div class="content-grid__text">
            <p class="text-fg-secondary">
              Nie ma raportu linków. Zbuduj stronę (<code>just build</code>), uruchom{' '}
              <code>just links</code> (albo zbuduj z <code>LINK_CHECK=1</code>) i odśwież tę
              stronę.
            </p>
          </div>
        </div>
      </Section>
    ) : (
      <>
        {isStale(report) && (
          <Section id="stale">
            <div class="line-grid" style={singleColumn}>
              <div class="content-grid__text">
                <p class="text-fg">
                  Raport ma {reportAgeDays(report)} dni (próg {STALE_AFTER_DAYS}). Uruchom{' '}
                  <code>just links</code>, żeby go odświeżyć.
                </p>
              </div>
            </div>
          </Section>
        )}

        <Section id="summary">
          <div class="line-grid">
            <div class="content-grid__text monitor-bar-cell">
              <LinkSummaryBar counts={report.counts} />
            </div>
            <div class="content-grid__text">
              <p class="monitor-figure">{report.counts.dead}</p>
              <p class="monitor-label">Martwe</p>
            </div>
            <div class="content-grid__text">
              <p class="monitor-figure">{report.counts.unverified}</p>
              <p class="monitor-label">Niezweryfikowane</p>
            </div>
            <div class="content-grid__text">
              <p class="monitor-figure">{report.counts.ok}</p>
              <p class="monitor-label">Osiągalne</p>
            </div>
            <div class="content-grid__text">
              <p class="monitor-figure">{report.disabled}</p>
              <p class="monitor-label">Wyłączone w dist</p>
            </div>
            <div class="content-grid__text">
              <p class="monitor-label">Źródło</p>
              <p class="text-fg-secondary">{report.source}</p>
            </div>
            <div class="content-grid__text">
              <p class="monitor-label">Raport zapisany</p>
              <p class="text-fg-secondary">{checkedAt(report.generatedAt)}</p>
            </div>
          </div>
        </Section>

        <DeadLinksByPage
          groups={groupDeadByPage(report.links)}
          summary={deadSummary(report.links)}
          {locations}
        />

        <Section id="disabled">
          <SectionHeader
            headline={`Wyłączone w dist (${report.disabled})`}
            subhead="Martwe linki zamienione w zwykły tekst przez build z LINK_CHECK=1."
          />
          <div class="line-grid" style={singleColumn}>
            {
              report.disabled === 0 ? (
                <div class="content-grid__text">
                  <p class="text-fg-muted">
                    Żaden. Ten dist nie był budowany z LINK_CHECK=1, więc martwe linki zostały na
                    stronach.
                  </p>
                </div>
              ) : (
                groups.dead.map((link) => (
                  <div class="monitor-row">
                    <p class="monitor-url text-fg">{link.url}</p>
                    <p class="monitor-meta">
                      <span>{outcomeLabel(link)}</span>
                    </p>
                  </div>
                ))
              )
            }
          </div>
        </Section>

        {report.pageErrors.length > 0 && (
          <Section id="page-errors">
            <SectionHeader
              headline={`Błędy stron (${report.pageErrors.length})`}
              subhead="Strony, których nie udało się odczytać przy zbieraniu linków."
            />
            <div class="line-grid" style={singleColumn}>
              {report.pageErrors.map((error) => (
                <div class="monitor-row">
                  <p class="monitor-url text-fg">{error}</p>
                </div>
              ))}
            </div>
          </Section>
        )}

        <Section id="unverified">
          <SectionHeader
            headline={`Niezweryfikowane (${groups.unverified.length})`}
            subhead="Zablokowane, ograniczone, zawodzące albo bez odpowiedzi w czasie. W przeglądarce mogą działać; nigdy nie są wyłączane."
          />
          <div class="line-grid" style={singleColumn}>
            {
              groups.unverified.length === 0 ? (
                <div class="content-grid__text">
                  <p class="text-fg-muted">Brak.</p>
                </div>
              ) : (
                groups.unverified.map((link) => (
                  <div class="monitor-row">
                    <p class="monitor-url text-fg">{link.url}</p>
                    <p class="monitor-meta">
                      <span>{outcomeLabel(link)}</span>
                      <span>{checkedAt(link.checkedAt)}</span>
                    </p>
                    <p class="monitor-pages">
                      {link.pages.map((page) => (
                        <a href={page}>{page}</a>
                      ))}
                    </p>
                  </div>
                ))
              )
            }
          </div>
        </Section>

        <Section id="ok">
          <details>
            <summary class="monitor-summary">Osiągalne ({groups.ok.length})</summary>
            <div class="line-grid" style={singleColumn}>
              {groups.ok.map((link) => (
                <div class="monitor-row">
                  <p class="monitor-url text-fg">{link.url}</p>
                  <p class="monitor-meta">
                    <span>{outcomeLabel(link)}</span>
                    <span>{checkedAt(link.checkedAt)}</span>
                  </p>
                  <p class="monitor-pages">
                    {link.pages.map((page) => (
                      <a href={page}>{page}</a>
                    ))}
                  </p>
                </div>
              ))}
            </div>
          </details>
        </Section>
      </>
    )
  }
</Layout>

<style lang="scss">
  @use '../../styles/variables' as *;

  .monitor-figure {
    @apply text-3xl font-light text-fg;
  }

  .monitor-bar-cell {
    grid-column: 1 / -1;
  }

  .monitor-label {
    @apply text-sm text-fg-muted;
  }

  .monitor-summary {
    @include px-responsive('md');
    @include py-responsive('sm');
    @apply text-lg text-fg-secondary transition-colors duration-fast ease-standard hover:text-fg;
    cursor: pointer;
  }

  .monitor-row {
    @include px-responsive('md');
    @include py-responsive('sm');
    display: grid;
    gap: 0.25rem 2rem;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr) minmax(0, 2fr);
    align-items: baseline;

    @media (max-width: 770px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .monitor-url {
    overflow-wrap: anywhere;
  }

  .monitor-meta,
  .monitor-pages {
    @apply text-sm text-fg-secondary;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .monitor-pages a {
    @apply transition-colors duration-fast ease-standard hover:text-fg;
  }
</style>
