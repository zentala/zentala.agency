---
/**
 * The 18 old capability cards condensed into six areas under the umbrella, each
 * linking to the closest existing page. A short list under each area keeps the
 * facts of the old cards (technologies, platforms) on the page. Each card has an
 * anchor id (the domain cells link to it), a 176 px background icon and, while
 * SHOW_AREA_IMAGES is on, an image placeholder at the top. The lists stay uneven:
 * the owner adds text later, so nothing is shortened.
 */
import Section from '@/components/primitives/sections/Section.astro'
import SectionHeader from '@/components/primitives/sections/SectionHeader.astro'
import CardContainer from '@/components/cards/CardContainer.astro'
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import AreaImagePlaceholder from './AreaImagePlaceholder.astro'
import { SHOW_AREA_IMAGES } from './area-images'
import { AREAS } from './copy'
---

<Section id="areas">
  <SectionHeader headline={AREAS.headline} subhead={AREAS.subhead} />
  <div class="line-grid">
    {
      AREAS.items.map((area) => (
        <CardContainer
          id={area.id}
          href={area.href}
          backgroundIcon={area.icon}
          class="area-card"
        >
          <div class="area">
            {SHOW_AREA_IMAGES && <AreaImagePlaceholder icon={area.icon} />}
            <h3 class="area__title">{area.title}</h3>
            <p class="area__body">{area.body}</p>
            <ul class="area__facts">
              {area.facts.map((fact) => (
                <li>{fact}</li>
              ))}
            </ul>
            <p class="area__link">
              <span>{area.linkLabel}</span>
              <SiteIcon name="next" size="sm" class="arrow-nudge" />
            </p>
          </div>
        </CardContainer>
      ))
    }
  </div>
</Section>

<style lang="scss">
  @use '../../styles/components/cards' as *;

  :global(.area-card) {
    scroll-margin-top: calc(var(--header-spacer-height, 5.5rem) + 1rem);
  }

  .area {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .area__title {
    @extend %card-title-medium;
  }

  .area__body {
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .area__link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    transition: color var(--motion-fast) var(--ease-standard);
  }

  :global(a:hover) .area__link,
  :global(a:focus-visible) .area__link {
    color: var(--color-text);
  }

  /* Hanging indent: a wrapped line reads as part of its item, not as a new one. */
  .area__facts {
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .area__facts li {
    padding-left: 1em;
    text-indent: -1em;
  }

  .area__facts li + li {
    margin-top: 0.375rem;
  }
</style>
