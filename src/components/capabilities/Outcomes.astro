---
/**
 * "What you get": three linked cells, each a claim plus one real example that
 * backs it, with a large faint background icon. No numbers: the example line is
 * what sets a cell apart.
 */
import Section from '@/components/primitives/sections/Section.astro'
import SectionHeader from '@/components/primitives/sections/SectionHeader.astro'
import CardContainer from '@/components/cards/CardContainer.astro'
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import { OUTCOMES } from './copy'
---

<Section id="what-you-get">
  <SectionHeader headline={OUTCOMES.headline} subhead={OUTCOMES.subhead} />
  <div class="line-grid outcomes">
    {
      OUTCOMES.items.map((item) => {
        const lastSpace = item.proof.lastIndexOf(' ')
        const proofHead = item.proof.slice(0, lastSpace)
        const proofLast = item.proof.slice(lastSpace + 1)
        return (
          <CardContainer href={item.href} backgroundIcon={item.icon}>
            <div class="outcome">
              <h3 class="outcome__title">{item.title}</h3>
              <p class="outcome__body">{item.body}</p>
              <div class="outcome__foot">
                <p class="outcome__proof">
                  {proofHead}&nbsp;
                  <span class="outcome__last">
                    {proofLast}
                    <SiteIcon name="next" size="sm" class="arrow-nudge" />
                  </span>
                </p>
              </div>
            </div>
          </CardContainer>
        )
      })
    }
  </div>
</Section>

<style lang="scss">
  @use '../../styles/components/cards' as *;

  .outcomes {
    --cols-wide: 3;
    --cols-medium: 3;
    --cols-narrow: 1;
  }

  .outcome {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Two lines are reserved so the body text of neighbouring cells starts level. */
  .outcome__title {
    @extend %card-title-medium;

    @media (min-width: 1001px) {
      min-height: 2lh;
    }
  }

  /* The last word and the chevron never part. */
  .outcome__last {
    white-space: nowrap;
  }

  .outcome__body {
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .outcome__foot {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  /* The chevron follows the last word, whether the line wraps or not. */
  .outcome__proof {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.45;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .outcome__proof :global(.site-icon) {
    vertical-align: -0.2em;
  }

  :global(a:hover) .outcome__proof,
  :global(a:focus-visible) .outcome__proof {
    color: var(--color-text);
  }
</style>
