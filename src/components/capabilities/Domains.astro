---
/**
 * "T-shaped experience": six domain cells in a line grid, experience only (keywords, a small
 * icon, no description, no image), so they read differently from the area cards. Each cell is a
 * direct-child link to its area card (#area-...), which gives it the card hover and the focus
 * overlay. Replaces the T drawing (owner feedback 2026-11-24, R4, R5, R8).
 */
import Section from '@/components/primitives/sections/Section.astro'
import SectionHeader from '@/components/primitives/sections/SectionHeader.astro'
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import { AREAS, DOMAINS } from './copy'

const areaTitle = (id: string) =>
  AREAS.items.find((area) => area.id === id)?.title
---

<Section id="experience">
  <SectionHeader headline={DOMAINS.headline} subhead={DOMAINS.subhead} />
  <div class="line-grid domains">
    {
      DOMAINS.items.map((domain) => (
        <a class="domain" href={`#${domain.areaId}`}>
          <span class="domain__head">
            <SiteIcon
              name={domain.icon}
              size={32}
              class="domain__icon domain__icon--lg"
            />
            <SiteIcon
              name={domain.icon}
              size={24}
              class="domain__icon domain__icon--sm"
            />
            <h3 class="domain__name">{domain.name}</h3>
          </span>
          <p class="domain__keywords">{domain.keywords.join(' · ')}</p>
          <span class="domain__target">
            <span>{areaTitle(domain.areaId)}</span>
            <SiteIcon name="next" size="sm" class="arrow-nudge" />
          </span>
        </a>
      ))
    }
  </div>
</Section>

<style lang="scss">
  @use '../../styles/variables' as *;

  .domains {
    --cols-wide: 3;
    --cols-medium: 2;
    --cols-narrow: 1;
  }

  .domain {
    @include cell-padding;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-height: 14rem;
    color: var(--color-text);
  }

  .domain__head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .domain__icon {
    color: var(--color-text-secondary);
  }

  .domain__icon--sm {
    display: none;
  }

  .domain__name {
    font-size: var(--text-h4);
    font-weight: 400;
    line-height: 1.3;
  }

  .domain__keywords {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .domain__target {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .domain:hover .domain__target,
  .domain:focus-visible .domain__target {
    color: var(--color-text);
  }

  @include tablet {
    .domain {
      gap: 0.75rem;
      min-height: 0;
    }

    /* The name keeps the content's left edge; the 24 px icon sits at the far end of its row. */
    .domain__head {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .domain__icon--lg {
      display: none;
    }

    .domain__icon--sm {
      display: block;
      order: 2;
    }
  }
</style>
