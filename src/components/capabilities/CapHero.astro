---
/**
 * Page header of /about/capabilities: eyebrow, the umbrella name (h1) and two
 * lines under it. Left-aligned on the logo edge (S1-C direction), unlike the
 * centred site Hero.
 */
import { HERO, NAME } from './copy'
---

<section class="section-full">
  <div class="container-bordered">
    <div class="cap-hero">
      <p class="cap-hero__eyebrow">{HERO.eyebrow}</p>
      <h1
        class="cap-hero__title text-4xl font-light leading-tight sm:text-5xl md:text-6xl xl:text-7xl"
      >
        {NAME}
      </h1>
      <p class="cap-hero__subtitle text-xl font-light md:text-2xl">
        {HERO.subtitle}
      </p>
      <p class="cap-hero__approach">{HERO.approach}</p>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../../styles/variables' as *;

  .cap-hero {
    @include px-responsive('md');
    @include py-responsive('lg');
  }

  .cap-hero__eyebrow {
    color: var(--color-text-subtle);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .cap-hero__title {
    margin-top: 1rem;
    color: var(--color-text);
  }

  .cap-hero__subtitle {
    margin-top: 1.5rem;
    max-width: 54ch;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .cap-hero__approach {
    margin-top: 1.25rem;
    max-width: 60ch;
    color: var(--color-text-muted);
    font-size: var(--text-lead);
    line-height: 1.6;
  }
</style>
