---
/**
 * The T drawn with the line grid (owner decision DB-9 A). Above 1000px a five-column grid:
 * the top row holds the five breadth fields, the middle column under it is the
 * stem, and the two side areas carry only the axis captions. The side areas stay
 * cells because their left and top lines close the underside of the arms and the
 * right edge of the stem. The stem is one cell (layers separated by spacing), so it is as short as full cell padding allows and the side areas
 * are no taller than needed. At 1000px and below the same cells read as two
 * labelled lists. The wrapper filler is off: every row is full at every width.
 */
import Section from '@/components/primitives/sections/Section.astro'
import SectionHeader from '@/components/primitives/sections/SectionHeader.astro'
import FieldItem from './FieldItem.astro'
import StackItem from './StackItem.astro'
import { TSHAPE } from './copy'

const lastField = TSHAPE.fields.length - 1
---

<Section id="t-shape">
  <SectionHeader headline={TSHAPE.headline} subhead={TSHAPE.subhead} />
  <div class="line-grid t-grid">
    <div class="t-axis t-axis--breadth">
      <p class="t-axis__label">{TSHAPE.breadth.label}</p>
      <p class="t-axis__caption">{TSHAPE.breadth.caption}</p>
    </div>
    {
      TSHAPE.fields.map((field, index) => (
        <div class:list={['t-cell', index === lastField && 't-cell--last-field']}>
          <FieldItem {...field} />
        </div>
      ))
    }
    <div class="t-axis t-axis--depth">
      <p class="t-axis__label">{TSHAPE.depth.label}</p>
      <p class="t-axis__caption">{TSHAPE.depth.caption}</p>
    </div>
    <div class="t-cell t-stem">
      <ul class="t-stem__list">
        {
          TSHAPE.stack.map((layer) => (
            <li>
              <StackItem {...layer} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

<style lang="scss">
  @use '../../styles/variables' as *;

  .t-grid {
    --cols-wide: 5;
    --cols-medium: 2;
    --cols-narrow: 1;

    &::after {
      display: none;
    }
  }

  .t-cell,
  .t-axis {
    @include padding-responsive('md');
  }

  .t-axis__label {
    color: var(--color-text-subtle);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .t-axis__caption {
    margin-top: 0.5rem;
    max-width: 30ch;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  /* Spacing between the stack layers. */
  .t-stem__list {
    display: grid;
    gap: 2rem;
  }

  /* The letter T: fields across row 1, the stem cell under the middle column. */
  @include medium-up {
    .t-axis--breadth {
      grid-column: 1 / 3;
      grid-row: 2;
    }

    .t-axis--depth {
      grid-column: 4 / 6;
      grid-row: 2;
    }

    .t-stem {
      grid-column: 3;
      grid-row: 2;
    }
  }

  /* Two labelled lists: captions, the odd last field and the stem take a full row. */
  @include medium {
    .t-axis,
    .t-cell--last-field,
    .t-stem {
      grid-column: 1 / -1;
    }
  }

  /* 771-1000px: the full-row stem keeps the two columns the fields use; a gap of
     twice the cell padding puts its second column on the fields' second column. */
  @include medium-only {
    .t-stem__list {
      grid-template-columns: 1fr 1fr;
      column-gap: $spacing-medium * 2;
    }
  }
</style>
