---
/**
 * One breadth field of the T-shape: the field name and a short detail line,
 */
import type { Field } from './copy'

type Props = Field

const { name, detail } = Astro.props
---

<div class="field-item">
  <h3 class="field-item__name">{name}</h3>
  <p class="field-item__detail">{detail}</p>
</div>

<style>
  .field-item__name {
    color: var(--color-text);
    font-size: var(--text-lead);
    font-weight: 400;
    line-height: 1.35;
  }

  .field-item__detail {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
</style>
