---
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import { formatDate } from '@/lib/blog/format-date'
import type { BlogIndexSeries } from '@/lib/blog/index-data'
import { partStatus } from '@/lib/blog/part-status'
import SlugCover from './SlugCover.astro'
import StatusBadge from './StatusBadge.astro'

/**
 * One series as a grid cell on the /blog index (DB-6): generated cover, name, short
 * description, parts count with an icon and a "Start" link, then every part as a row.
 * The status badge flows in the text, right after the last word of the title, so the
 * title keeps the whole row width.
 */
interface Props {
  series: BlogIndexSeries
}

const { series } = Astro.props

const rows = series.parts.map((part, index) => ({
  slug: part.slug,
  title: part.data.title,
  number: String(part.data.part ?? index + 1).padStart(2, '0'),
  status: partStatus(part),
  date: formatDate(part.data.date),
}))
const firstPart = series.parts[0]
---

<div class="series-block">
  <SlugCover seed={series.slug} />
  <div class="series-block__body padding-responsive-md">
    <h3 class="series-block__name">
      <a href={`/series/${series.slug}`}>{series.title}</a>
    </h3>
    {series.tagline && <p class="series-block__tagline">{series.tagline}</p>}
    <div class="series-block__meta">
      <p class="series-block__count">
        <SiteIcon name="series" size="sm" />
        {series.parts.length} parts
      </p>
      {
        firstPart && (
          <a href={`/blog/${firstPart.slug}`} class="series-block__start group">
            <SiteIcon name="start" size="sm" />
            Start
            <SiteIcon name="next" size="sm" class="arrow-nudge" />
          </a>
        )
      }
    </div>

    <ol class="series-block__rows">
      {
        rows.map((row) => (
          <li>
            <a href={`/blog/${row.slug}`} class="part-row">
              <span class="part-row__number">
                <span class="sr-only">Part </span>
                {row.number}
              </span>
              <span class="part-row__title">
                {row.title}
                <span class="part-row__badge">
                  <StatusBadge
                    status={row.status}
                    datetime={row.date.datetime}
                    dateLabel={row.date.label}
                  />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  .series-block {
    position: relative;
    isolation: isolate;
  }

  .series-block__name {
    color: var(--color-text);
    font-size: var(--text-h3);
    font-weight: 300;
    line-height: 1.25;
  }

  .series-block__name a,
  .series-block__start {
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .series-block__name a:hover {
    color: var(--color-text-secondary);
  }

  .series-block__tagline {
    margin-top: 0.5rem;
    color: var(--color-text-secondary);
    line-height: 1.5rem;
  }

  .series-block__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5rem;
  }

  .series-block__count,
  .series-block__start {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-variant-numeric: tabular-nums;
  }

  .series-block__start {
    gap: 0.25rem;
    color: var(--color-text);
  }

  .series-block__start:hover {
    color: var(--color-text-secondary);
  }

  .series-block__rows {
    margin-top: 0.75rem;
  }

  .part-row {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    align-items: start;
    column-gap: 0.5rem;
    margin: 0 -0.5rem;
    padding: 0.25rem 0.5rem;
    color: var(--color-text-secondary);
    line-height: 1.5rem;
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .part-row:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-text);
  }

  .part-row__number {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  /* Adds to the word space before the badge; small enough to go unseen when the badge wraps. */
  .part-row__badge {
    margin-left: 0.125rem;
  }
</style>
