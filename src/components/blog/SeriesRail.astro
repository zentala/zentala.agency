---
import type { CollectionEntry } from 'astro:content'
import StatusBadge from '@/components/blog/index/StatusBadge.astro'
import DraftBadge from '@/components/primitives/DraftBadge.astro'
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import { formatDate } from '@/lib/blog/format-date'
import { partStatus } from '@/lib/blog/part-status'

/**
 * Series navigation for a post, in the look of the series table (B2-D): the series
 * display title, the current part's label, the parts count with an icon and a
 * "Start" link, then the previous, current and next part as rows (number, title,
 * status marker with icon; a draft or review row also carries the 1 px rule between
 * number and title), and a link to the whole series. Short on purpose so it fits one
 * screen in the sticky rail.
 */
export interface SeriesRailProps {
  seriesSlug: string
  seriesTitle: string
  posts: CollectionEntry<'blog'>[]
  currentSlug: string
  currentLabel: string
}

const { seriesSlug, seriesTitle, posts, currentSlug, currentLabel } =
  Astro.props as SeriesRailProps

const currentIndex = posts.findIndex((post) => post.slug === currentSlug)
const rows = posts
  .map((post, index) => ({
    slug: post.slug,
    title: post.data.title,
    number: String(post.data.part ?? index + 1).padStart(2, '0'),
    status: partStatus(post),
    isReview: post.data.review === true,
    date: formatDate(post.data.date),
  }))
  .slice(Math.max(0, currentIndex - 1), currentIndex + 2)
const firstPart = posts[0]
---

<nav aria-label="Series navigation">
  <p class="text-label uppercase text-fg-subtle">Series</p>
  <a
    href={`/series/${seriesSlug}`}
    class="mt-1 block text-base text-fg no-underline hover:text-accent"
  >
    {seriesTitle}
  </a>
  <p class="mt-1 text-sm text-fg-muted">{currentLabel}</p>
  <div class="rail-meta">
    <p class="rail-meta__count">
      <SiteIcon name="series" size="sm" />
      {posts.length} parts
    </p>
    {
      firstPart && (
        <a href={`/blog/${firstPart.slug}`} class="rail-meta__start">
          <SiteIcon name="start" size="sm" />
          Start
          <SiteIcon name="next" size="sm" class="arrow-nudge" />
        </a>
      )
    }
  </div>
  <ol class="rail-rows">
    {
      rows.map((row) => (
        <li>
          <a
            href={`/blog/${row.slug}`}
            class:list={['rail-row', row.slug === currentSlug && 'rail-row--current']}
            aria-current={row.slug === currentSlug ? 'page' : undefined}
          >
            <span class="rail-row__number">
              <span class="sr-only">Part </span>
              {row.number}
            </span>
            <span class="rail-row__rule">
              {row.status !== 'published' && (
                <DraftBadge placement="rule" review={row.isReview} />
              )}
            </span>
            <span class="rail-row__title">
              {row.title}
              <StatusBadge
                status={row.status}
                datetime={row.date.datetime}
                dateLabel={row.date.label}
              />
            </span>
          </a>
        </li>
      ))
    }
  </ol>
  <a
    href={`/series/${seriesSlug}`}
    class="mt-4 inline-block text-sm text-accent no-underline hover:text-accent-hover"
  >
    See all {posts.length} parts
  </a>
</nav>

<style>
  .rail-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5rem;
  }

  .rail-meta__count,
  .rail-meta__start {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-variant-numeric: tabular-nums;
  }

  .rail-meta__start {
    gap: 0.25rem;
    color: var(--color-text);
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .rail-meta__start:hover {
    color: var(--color-text-secondary);
  }

  .rail-rows {
    margin-top: 0.75rem;
    padding: 0;
  }

  .rail-row {
    display: grid;
    grid-template-columns: 1.25rem 1px minmax(0, 1fr);
    align-items: start;
    column-gap: 0.5rem;
    margin: 0 -0.5rem;
    padding: 0.25rem 0.5rem;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.5rem;
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .rail-row:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-text);
  }

  .rail-row--current {
    color: var(--color-text);
  }

  .rail-row__number {
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }

  .rail-row__rule {
    align-self: stretch;
    display: flex;
  }

  .rail-row__rule :global(.draft-rule) {
    margin: 0;
  }
</style>
