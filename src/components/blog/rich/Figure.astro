---
/**
 * Frame for an article diagram: numbered label, the diagram, a caption.
 * `not-prose` keeps blog typography rules out of the diagram.
 */
interface Props {
  /** Short label above the frame, e.g. "Layer 2". */
  label?: string
  /** One-sentence caption under the diagram. */
  caption: string
}

const { label, caption } = Astro.props
---

<figure class="rich-figure not-prose">
  {label && <p class="rich-figure__label">{label}</p>}
  <div class="rich-figure__body"><slot /></div>
  <figcaption class="rich-figure__caption">{caption}</figcaption>
</figure>

<style lang="scss">
  .rich-figure {
    margin: 2.5rem 0;
    border: 1px solid rgb(31 41 55);
    border-radius: 0.5rem;
    background: rgb(3 7 18 / 0.6);
  }

  .rich-figure .rich-figure__label {
    margin: 0;
    padding: 0.625rem 1.25rem;
    border-bottom: 1px solid rgb(31 41 55);
    color: rgb(156 163 175);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rich-figure__body {
    padding: 1.5rem 1.25rem;
    overflow-x: auto;
  }

  .rich-figure__caption {
    padding: 0.75rem 1.25rem;
    border-top: 1px solid rgb(31 41 55);
    color: rgb(156 163 175);
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.5;
  }
</style>
