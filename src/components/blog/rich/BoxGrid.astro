---
/**
 * Grid of titled boxes, each listing a few items: hosts with their
 * services, roles with their duties, packages with their purpose.
 */
export interface GridBox {
  /** Box heading, e.g. a host name or a role. */
  title: string
  /** One line under the heading saying what the box is. */
  sub?: string
  /** Short entries listed inside the box. */
  items?: string[]
  /** Draws the box with a stronger border. */
  highlight?: boolean
}

interface Props {
  boxes: GridBox[]
  /** Render titles and items in a monospace face (host names, paths). */
  mono?: boolean
}

const { boxes, mono = false } = Astro.props

if (!boxes?.length) {
  throw new Error('BoxGrid: "boxes" must contain at least one box')
}
---

<div data-prose-widget class:list={['box-grid', { 'box-grid--mono': mono }]}>
  {
    boxes.map((box) => (
      <section class:list={['box-grid__box', { 'box-grid__box--highlight': box.highlight }]}>
        <h4 class="box-grid__title">{box.title}</h4>
        {box.sub && <p class="box-grid__sub">{box.sub}</p>}
        {box.items && (
          <ul class="box-grid__items">
            {box.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</div>

<style lang="scss">
  /* Nested under the figure frame: these rules must outrank the blog
     prose rules for headings, lists and code. */
  :global(.rich-figure) {
      .box-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
        gap: 0.75rem;
      }

      .box-grid__box {
        min-width: 0;
        padding: 0.875rem;
        border: 1px solid var(--color-line-strong);
        border-radius: var(--radius-none);
        background: var(--color-surface-raised);
      }

      .box-grid__box--highlight {
        border-color: var(--color-text-secondary);
      }

      .box-grid__title {
        margin: 0;
        color: var(--color-text);
        font-size: 0.9375rem;
        font-weight: 500;
        line-height: 1.3;
        overflow-wrap: anywhere;
      }

      .box-grid__sub {
        margin: 0.25rem 0 0;
        color: var(--color-text-muted);
        font-size: 0.8125rem;
        font-weight: 300;
        line-height: 1.4;
      }

      .box-grid__items {
        margin: 0.625rem 0 0;
        padding: 0.625rem 0 0;
        border-top: 1px solid var(--color-line);
        list-style: none;
        color: var(--color-text-secondary);
        font-size: 0.8125rem;
        font-weight: 300;
        line-height: 1.5;
        overflow-wrap: anywhere;
      }

      .box-grid__items li {
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: inherit;
        line-height: inherit;
      }

      .box-grid__items li::before {
        content: none;
      }

      .box-grid--mono .box-grid__title,
      .box-grid--mono .box-grid__items {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8125rem;
      }
  }
</style>
