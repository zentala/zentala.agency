---
/**
 * Boxes joined by arrows: a left-to-right flow that stacks vertically on
 * narrow screens. Each step may carry a second line of detail.
 */
export interface FlowStep {
  /** Name of the step, shown in the box. */
  label: string
  /** Optional second line under the label. */
  note?: string
  /** Draws the box with a stronger border: the step the text is about. */
  highlight?: boolean
}

interface Props {
  steps: FlowStep[]
  /** Optional line under the flow describing the way back, e.g. a retry. */
  returnNote?: string
}

const { steps, returnNote } = Astro.props

if (!steps?.length) {
  throw new Error('Flow: "steps" must contain at least one step')
}
---

<div class="flow" data-prose-widget>
  <ol class="flow__steps">
    {
      steps.map((step) => (
        <li class:list={['flow__step', { 'flow__step--highlight': step.highlight }]}>
          <span class="flow__label">{step.label}</span>
          {step.note && <span class="flow__note">{step.note}</span>}
        </li>
      ))
    }
  </ol>
  {returnNote && <p class="flow__return">↺ {returnNote}</p>}
</div>

<style lang="scss">
  /* Nested under the figure frame: these rules must outrank the blog
     prose rules for headings, lists and code. */
  :global(.rich-figure) {
      .flow__steps {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .flow__step {
        position: relative;
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-width: 0;
        margin: 0;
        padding: 0.75rem 0.875rem;
        border: 1px solid var(--color-line-strong);
        border-radius: var(--radius-none);
        background: var(--color-surface-raised);
      }

      .flow__step--highlight {
        border-color: var(--color-text-secondary);
      }

      /* Chevron to the next step (no shaft): below on narrow screens, to the right on wide. */
      .flow__step:not(:last-child)::after {
        content: '';
        position: absolute;
        left: 50%;
        top: calc(100% + 0.375rem);
        width: 0.5rem;
        height: 0.5rem;
        border-right: 1px solid var(--color-text-muted);
        border-bottom: 1px solid var(--color-text-muted);
        transform: translateX(-50%) rotate(45deg);
      }

      .flow__label {
        color: var(--color-text);
        font-size: 0.9375rem;
        font-weight: 500;
        line-height: 1.3;
      }

      .flow__note {
        color: var(--color-text-muted);
        font-size: 0.8125rem;
        font-weight: 300;
        line-height: 1.4;
      }

      .flow__return {
        margin: 1rem 0 0;
        padding-top: 0.75rem;
        border-top: 1px solid var(--color-line);
        color: var(--color-text-muted);
        font-size: 0.8125rem;
        font-weight: 300;
      }

      @media (min-width: 768px) {
        .flow__steps {
          flex-direction: row;
          align-items: stretch;
        }

        .flow__step:not(:last-child)::after {
          left: calc(100% + 0.875rem);
          top: 50%;
          transform: translate(-50%, -50%) rotate(-45deg);
        }
      }
  }
</style>
