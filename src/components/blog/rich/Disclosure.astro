---
/**
 * Collapsed detail inside an article: short text stays on the surface,
 * the longer explanation opens on click. Native <details>, no script.
 */
interface Props {
  /** The always-visible line the reader clicks. */
  summary: string
}

const { summary } = Astro.props
---

<details class="disclosure" data-prose-widget>
  <summary class="disclosure__summary">{summary}</summary>
  <div class="disclosure__body"><slot /></div>
</details>

<style lang="scss">
  .disclosure {
    margin: 1.5rem 0;
    border-left: 1px solid var(--color-line-strong);
    background: var(--color-surface-raised);
    border-radius: var(--radius-none);
  }

  .disclosure__summary {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 0.875rem 1.25rem;
    color: var(--color-text-secondary);
    font-size: 1rem;
    font-weight: 400;
    cursor: pointer;
    list-style: none;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .disclosure__summary::-webkit-details-marker {
    display: none;
  }

  .disclosure__summary::before {
    content: '+';
    flex: none;
    width: 1ch;
    color: var(--color-text-muted);
    font-family: ui-monospace, monospace;
  }

  .disclosure[open] > .disclosure__summary::before {
    content: '−';
  }

  .disclosure__summary:hover {
    color: var(--color-text);
  }

  .disclosure__body {
    padding: 0 1.25rem 0.5rem 2.5rem;
  }

  .disclosure__body :global(p),
  .disclosure__body :global(li) {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
  }
</style>
