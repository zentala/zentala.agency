---
import SiteIcon from '@/components/primitives/SiteIcon.astro'

/** Share links (LinkedIn, Teams, email) and a copy-link button. The copy handler lives in the post page. */
export interface ShareButtonsProps {
  postUrl: string
  title: string
}

const { postUrl, title } = Astro.props as ShareButtonsProps

const externalLinks = [
  {
    label: 'Share on LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`,
    icon: 'linkedin',
  },
  {
    label: 'Share on Microsoft Teams',
    href: `https://teams.microsoft.com/share?href=${encodeURIComponent(postUrl)}&msgText=${encodeURIComponent(title)}`,
    icon: 'teams',
  },
]
const emailHref = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`${title}\n\n${postUrl}`)}`
const buttonClass =
  'group inline-flex h-8 w-8 items-center justify-center border border-line bg-transparent p-0 text-fg-muted transition-colors duration-fast ease-standard hover:border-line-strong hover:bg-surface-hover hover:text-fg [&.is-copied]:border-success [&.is-copied]:text-success'
---

<div class="flex flex-wrap gap-1.5" role="group" aria-label="Share this article">
  {
    externalLinks.map((link) => (
      <a
        class={buttonClass}
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={link.label}
        title={link.label}
      >
        <SiteIcon name={link.icon} size="md" />
      </a>
    ))
  }
  <a
    class={buttonClass}
    href={emailHref}
    aria-label="Share via email"
    title="Share via email"
  >
    <SiteIcon name="email" size="md" />
  </a>
  <button
    type="button"
    class={buttonClass}
    data-copy-url={postUrl}
    aria-label="Copy link"
    title="Copy link"
  >
    <SiteIcon name="copy-link" size="md" class="group-[.is-copied]:hidden" />
    <SiteIcon name="done" size="md" class="hidden group-[.is-copied]:block" />
  </button>
</div>
