---
/** Share links (LinkedIn, Teams, email) and a copy-link button. The copy handler lives in the post page. */
export interface ShareButtonsProps {
  postUrl: string
  title: string
}

const { postUrl, title } = Astro.props as ShareButtonsProps

const externalLinks = [
  {
    label: 'Share on LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`,
    icon: 'M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 1 1 8.3 6.5a1.78 1.78 0 0 1-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0 0 13 14.19a.66.66 0 0 0 0 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 0 1 2.7-1.4c1.55 0 3.36.86 3.36 3.66z',
  },
  {
    label: 'Share on Microsoft Teams',
    href: `https://teams.microsoft.com/share?href=${encodeURIComponent(postUrl)}&msgText=${encodeURIComponent(title)}`,
    icon: 'M2.5 6.5h13a.5.5 0 0 1 .5.5v10a.5.5 0 0 1-.5.5h-13A.5.5 0 0 1 2 17V7a.5.5 0 0 1 .5-.5zM12 9.5H4v1.4h3v5.6h2v-5.6h3zM21 9.5h-4.5V13a3 3 0 0 0 3 3h.25A2.25 2.25 0 0 0 22 13.75v-3.25a1 1 0 0 0-1-1z',
  },
]
const emailHref = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`${title}\n\n${postUrl}`)}`
const buttonClass =
  'group inline-flex h-8 w-8 items-center justify-center border border-line bg-transparent p-0 text-fg-muted transition-colors duration-fast ease-standard hover:border-line-strong hover:bg-surface-hover hover:text-fg [&.is-copied]:border-success [&.is-copied]:text-success'
const svgProps = {
  viewBox: '0 0 24 24',
  width: 18,
  height: 18,
  'aria-hidden': 'true',
} as const
const strokeProps = {
  ...svgProps,
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.5,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
} as const
---

<div class="flex flex-wrap gap-1.5" role="group" aria-label="Share this article">
  {
    externalLinks.map((link) => (
      <a
        class={buttonClass}
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={link.label}
        title={link.label}
      >
        <svg {...svgProps} fill="currentColor">
          <path d={link.icon} />
        </svg>
      </a>
    ))
  }
  <a
    class={buttonClass}
    href={emailHref}
    aria-label="Share via email"
    title="Share via email"
  >
    <svg {...strokeProps}>
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <path d="M3 7l9 6 9-6"></path>
    </svg>
  </a>
  <button
    type="button"
    class={buttonClass}
    data-copy-url={postUrl}
    aria-label="Copy link"
    title="Copy link"
  >
    <svg {...strokeProps} class="group-[.is-copied]:hidden">
      <path d="M9 17H7A5 5 0 0 1 7 7h2"></path>
      <path d="M15 7h2a5 5 0 0 1 0 10h-2"></path>
      <line x1="8" y1="12" x2="16" y2="12"></line>
    </svg>
    <svg {...strokeProps} class="hidden group-[.is-copied]:block">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
  </button>
</div>
