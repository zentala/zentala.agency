---
/**
 * Small dev-only label for mockup pages: marks draft copy or a mockup note.
 * Mockup pages exist only in the dev server, so this never ships.
 */
---

<span class="mockup-dev-label"><slot /></span>

<style>
  .mockup-dev-label {
    display: inline-block;
    padding: 2px 5px;
    border: 1px dashed var(--color-line-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text-subtle);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
