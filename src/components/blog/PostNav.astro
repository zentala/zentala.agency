---
import type { CollectionEntry } from 'astro:content'
import DraftBadge from '@/components/primitives/DraftBadge.astro'

/**
 * End-of-article navigation, shown at every width, as its own section after the post
 * body. A series post gets the previous and next part as line-grid cells plus a link to
 * all parts; any other post gets related posts from the same category, so a reader is
 * never left at a dead end. The cells are direct-child links, so the grid draws their
 * lines and the hover/focus overlay (DESIGN.md section 3); no boxes of its own.
 */
export interface PostNavProps {
  seriesSlug?: string
  seriesPosts: CollectionEntry<'blog'>[]
  related: CollectionEntry<'blog'>[]
  currentSlug: string
}

const { seriesSlug, seriesPosts, related, currentSlug } =
  Astro.props as PostNavProps

const currentIndex = seriesPosts.findIndex((post) => post.slug === currentSlug)
const previous = currentIndex > 0 ? seriesPosts[currentIndex - 1] : undefined
const next = currentIndex >= 0 ? seriesPosts[currentIndex + 1] : undefined

const cellClass = 'block p-5 no-underline md:p-6'
const labelClass = 'text-label uppercase text-fg-subtle'
const titleClass = 'mt-2 block text-lg leading-snug text-fg'
const textLinkClass = 'text-sm no-underline'
const hasPair = Boolean(previous || next)
---

<section class="section-full">
  <nav class="container-bordered" aria-label="More to read" data-post-nav>
    <div
      class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-responsive py-5"
    >
      {
        seriesSlug ? (
          seriesPosts.length > 1 ? (
            <a
              href={`/series/${seriesSlug}`}
              class={`${textLinkClass} text-accent hover:text-accent-hover hover:underline`}
            >
              All {seriesPosts.length} parts →
            </a>
          ) : (
            <span />
          )
        ) : (
          <p class={labelClass}>{related.length > 0 ? 'Related posts' : ''}</p>
        )
      }
      <a href="/blog" class={`${textLinkClass} text-fg-muted hover:text-fg`}>
        ← All posts
      </a>
    </div>

    {
      seriesSlug && hasPair && (
        <div class="line-grid" style="--cols-wide: 2">
          {previous && (
            <a href={`/blog/${previous.slug}`} class={cellClass} rel="prev">
              <span class={labelClass}>
                ← Previous part
                {previous.data.published === false && (
                  <DraftBadge placement="inline" />
                )}
              </span>
              <span class={titleClass}>
                Part {previous.data.part}: {previous.data.title}
              </span>
            </a>
          )}
          {next && (
            <a
              href={`/blog/${next.slug}`}
              class={`${cellClass} ${previous ? 'md:text-right' : ''}`}
              rel="next"
            >
              <span class={labelClass}>
                Next part →
                {next.data.published === false && (
                  <DraftBadge placement="inline" />
                )}
              </span>
              <span class={titleClass}>
                Part {next.data.part}: {next.data.title}
              </span>
            </a>
          )}
        </div>
      )
    }
    {
      !seriesSlug && related.length > 0 && (
        <div class="line-grid line-grid--fill-last">
          {related.map((post) => (
            <a href={`/blog/${post.slug}`} class={cellClass}>
              <span class="block text-base leading-snug text-fg">
                {post.data.title}
              </span>
              <span class="mt-2 line-clamp-3 block text-sm text-fg-muted">
                {post.data.excerpt}
              </span>
            </a>
          ))}
        </div>
      )
    }
  </nav>
</section>
