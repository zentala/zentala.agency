---
import { AgentationReview } from './index'

/** Needs an explicit flag: DEV alone must not turn the review toolbar on. */
const isReviewEnabled =
  import.meta.env.DEV && import.meta.env.PUBLIC_AGENTATION_REVIEW === '1'
---

{isReviewEnabled && <AgentationReview client:only="react" />}

<style is:global>
  /* Own offset: keeps the round button clear of the chat bubble slot (bottom-right). */
  agentation-toolbar {
    bottom: 5.5rem;
  }
</style>
