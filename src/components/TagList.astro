---
interface Props {
  tags: string[]
  className?: string
}

const { tags, className = '' } = Astro.props
---

<div class={`flex gap-2 flex-wrap ${className}`}>
  {
    tags.map((tag) => (
      <a
        href={`/tag/${tag}`}
        class="relative z-10 rounded-chip bg-surface-raised px-3 py-1.5 text-label font-semibold uppercase text-fg-subtle transition-colors duration-fast ease-standard hover:text-fg-secondary"
      >
        #{tag}
      </a>
    ))
  }
</div>
