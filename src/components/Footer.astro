---
import Logo from '../components/Logo.astro'
import BrandIcon from '@/components/primitives/BrandIcon.astro'
import { getCollection } from 'astro:content'
import { getVisiblePosts } from '@/lib/blog/visibility'
import { isParkedLink } from '@/lib/links/parked'
import '../styles/footer.scss'

const currentYear = new Date().getFullYear()

// Responsive logo props - using auto-scaling system
const footerLogoProps = {
  link: '/',
  color: '#FFFFFF',
  type: 'full',
  width: '240px', // Responsive - will be overridden by CSS
  height: '44px', // Base height for CSS variables system
}

/** Same source as the series route: a series has a page exactly when a visible post carries its slug. */
const seriesWithPage = new Set(
  (await getVisiblePosts()).flatMap((post) =>
    post.data.series ? [post.data.series] : [],
  ),
)
const seriesLinks = (await getCollection('series-descriptions'))
  .filter((entry) => seriesWithPage.has(entry.slug))
  .map((entry) => ({ href: `/series/${entry.slug}/`, text: entry.data.title }))

interface FooterLink {
  href: string
  text: string
  external?: boolean
}

const FOOTER_GROUPS: { label: string; links: FooterLink[] }[] = [
  {
    label: 'Blog',
    links: [{ href: '/blog/', text: 'All posts' }, ...seriesLinks],
  },
  {
    label: 'Offer',
    links: [
      { href: '/about/capabilities/', text: 'Capabilities' },
      { href: '/offer/harness-engineering/', text: 'Harness Engineering' },
      { href: '/about/capabilities/backstage/', text: 'Backstage Consulting' },
    ],
  },
  {
    label: 'Company',
    links: [
      { href: '/portfolio/', text: 'Portfolio' },
      { href: '/contact/', text: 'Contact' },
    ],
  },
  {
    label: 'Elsewhere',
    links: [
      { href: 'https://ideas.zentala.agency', text: 'Startup Ideas', external: true },
      { href: 'https://idom.zentala.pl', text: 'Intelligent Home', external: true },
      { href: 'https://wifi.edu.zentala.agency', text: 'WiFi 802.11 Tech', external: true },
      { href: 'https://dev.edu.zentala.agency', text: 'Clever Developer', external: true },
      { href: 'https://devstage.io', text: 'DevStage.io', external: true },
    ],
  },
]
---

<footer class="bg-surface text-fg">
  <div class="section-bordered">
  <div class="container-footer-small">
    <div class="footer-logo-social mb-0">
      <div>
        <Logo {...footerLogoProps} />
      </div>
      <div class="footer-social-icons">
        <a
          href="https://www.linkedin.com/in/zentala/"
          target="_blank"
          rel="noopener noreferrer"><BrandIcon name="linkedin" /><span class="sr-only">LinkedIn</span></a
        >
        <a
          href="https://github.com/zentala"
          target="_blank"
          rel="noopener noreferrer"><BrandIcon name="github" /><span class="sr-only">GitHub</span></a
        >
        <a
          href="mailto:zentala@gmail.com"
          target="_blank"
          rel="noopener noreferrer"><BrandIcon name="email" /><span class="sr-only">Email</span></a
        >
      </div>
    </div>

    <div class="grid grid-cols-1 gap-8 text-sm lg:grid-cols-5">
      <!-- <div class="mb-6 lg:mb-0">
        Żentała Innovation Agency specializes in implementing comprehensive
        applications and solutions in software, web development, marketing,
        artificial intelligence, automation, robotics, and the Internet of
        Things (IoT). I deliver advanced technologies that effectively enhance
        the operational value and competitiveness of your company in the market.
      </div>
      <div>
        I actively engage in developing customized solutions, starting from
        understanding client challenges to prototyping and implementing tailored
        solutions. This process includes a thorough needs analysis and bespoke
        solution design, ensuring that each prototype precisely meets the
        specific requirements of the project.
      </div>
      <div>
        My services include a broad spectrum focused on the early stages of
        future technology deployment. Key activities involve education and
        consulting on new technologies, prototype building (Proof of Concept),
        and forming IT teams for ongoing development and maintenance.
      </div>-->
    </div>
  </div>
  </div>
  <div class="section-bordered flex items-center">
    <div class="container-padded flex justify-between">
      <div class="footer-ia">
        <div class="footer-ia-about">
          <h2 class="footer-heading">About</h2>
          <p>
            Żentała Innovation Agency specializes in R&D projects and innovative
            solutions in software, Developer Experience, IoT, automation, and
            robotics. We deliver advanced technologies through customized
            solutions, from needs analysis to Proof of Concept, enhancing your
            company's competitiveness.
          </p>
        </div>
        {
          FOOTER_GROUPS.map((group) => (
            <div class="footer-ia-group">
              <h2 class="footer-heading">{group.label}</h2>
              <ul class="space-y-2">
                {group.links.filter((link) => !isParkedLink(link.href)).map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      {link.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="flex items-center">
    <div class="container-footer-small flex justify-between">
      <div class="footer-copyright text-sm text-fg-muted">
        © {currentYear} <a href="/">Żentała Innovation Agency</a>
        <span class="mx-2">·</span>
        <a href="/privacy-policy/">Privacy Policy</a>
      </div>
      <div>
        <!-- <button class="text-gray-300 hover:text-gray-100">
          🇵🇱 <span class="sr-only">Switch language</span>
        </button> -->
      </div>
    </div>
  </div>
</footer>

<style lang="scss">
  @use '../styles/variables' as *;

  /* Footer links stay calm: colour change only, no highlight bar or underline. */
  footer a {
    text-decoration: none;

    &:hover::after {
      content: none;
    }
  }

  .footer-ia {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }

  .footer-ia-about {
    grid-column: span 4;
  }

  .footer-ia-group {
    grid-column: span 2;
  }

  @include tablet {
    .footer-ia-about {
      grid-column: span 12;
      margin-bottom: 1.5rem;
    }

    .footer-ia-group {
      grid-column: span 6;
    }
  }

  @include mobile {
    .footer-ia-group {
      grid-column: span 12;
    }
  }
</style>
