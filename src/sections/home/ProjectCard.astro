---
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import { isParkedLink } from '@/lib/links/parked'
import { headerImage } from '@/config/features'

interface Props {
  title: string
  description: string
  image: string
  link: string
  linkText?: string
}

const { title, description, image, link, linkText = 'Learn more' } =
  Astro.props
// A parked link (src/data/parked-links.ts) renders the card as plain text, without link or CTA.
const parked = isParkedLink(link)
const Element = parked ? 'div' : 'a'
---

<Element href={parked ? undefined : link} class="project-card">
  {
    headerImage.render && (
      <div class="project-image" {...headerImage.attrs}>
        <img src={image} alt={title} />
      </div>
    )
  }
  <div class="project-content">
    <h4 class="project-title">{title}</h4>
    <p class="project-description">{description}</p>
    {
      !parked && (
        <span class="project-link">
          {linkText}
          <SiteIcon name="next" size="sm" class="arrow-nudge" />
        </span>
      )
    }
  </div>
</Element>
