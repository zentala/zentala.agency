---
/**
 * BentoAboutMe
 *
 * Demonstrates the new Section Primitives system with:
 * - Asymmetric bento grid layout
 * - Mixed content types (text, images, quotes, CTAs)
 * - Custom column/row spans
 *
 */

import Section from '../../components/primitives/sections/Section.astro'
import SectionBento from '../../components/primitives/sections/SectionBento.astro'
import BentoCard from '../../components/primitives/sections/bento/BentoCard.astro'
import SectionContent from '../../components/primitives/sections/SectionContent.astro'
import SectionImage from '../../components/primitives/sections/SectionImage.astro'
import BentoCentralStage from '../../components/primitives/sections/bento/BentoCentralStage.astro'
import BentoStageState from '../../components/primitives/sections/bento/BentoStageState.astro'
import SiteIcon from '@/components/primitives/SiteIcon.astro'
import Logo from '../../components/Logo.astro'
import TagGroup from '../../components/primitives/TagGroup.astro'
import PhaseLabel from '../../components/primitives/PhaseLabel.astro'
import CardIconMosaic, {
  type MosaicTile,
} from '../../components/primitives/CardIconMosaic.astro'

/** The nine portfolio areas: the four from the card copy around the robot, the rest in the corners. */
const PORTFOLIO_TILES: MosaicTile[] = [
  { icon: 'web-design', label: 'Web design' },
  { icon: 'indoor-location', label: 'Indoor location' },
  { icon: 'nfc-table', label: 'NFC table' },
  { icon: 'capabilities', label: 'Developer portals' },
  { icon: 'ai-agent', label: 'Humanoid robot' },
  { icon: 'home', label: 'Smart home' },
  { icon: 'wifi-community', label: 'WiFi community' },
  { icon: 'smart-desk', label: 'Smart desk' },
  { icon: 'nick-finder', label: 'Nick finder' },
]

const bentoStates = {
  default: 'default',
  avatar: 'avatar',
  prototyping: 'prototyping',
  cto: 'cto',
  ai: 'ai',
  logo: 'logo',
} as const
---

<Section id="bento-about-me">
  <SectionBento rowHeight="minmax(14rem, auto)">
    <!-- Row 1-2: Col 1 - Starting an Innovative Project? (1:2) -->
    <BentoCard colSpan={1} rowSpan={2} padding="sm" class="group">
      <!-- hoverState={bentoStates.prototyping} -->
      <div
        class="absolute inset-0 opacity-[0.03] transition-opacity duration-base ease-standard group-hover:opacity-[0.07]"
        style="background-image: radial-gradient(var(--color-text) 1px, transparent 1px); background-size: 20px 20px;"
      >
      </div>
      <SectionContent context="grid" prose={true}>
        <div class="relative z-10">
          <div class="mb-2 flex items-baseline gap-2">
            <h3 class="m-0 transition-colors group-hover:text-fg">
              Discovery & Strategy
            </h3>
            <PhaseLabel phase={1} />
          </div>
          <p>
            Let me help turn your vision into a strategy, and your idea into a
            clear direction.
          </p>
          <p>
            We start with focused discovery sessions and design-thinking
            workshops to sharpen your idea: define target users, value
            proposition, key user journeys, and success metrics.
          </p>
          <p>
            You get a Product Strategy document with problem statement, MVP
            scope, user personas, and roadmap — everything needed to start
            building.
          </p>
          <!-- <p>
            Than I will deliver and publish a production-ready MVP. Then I
            translate that clarity into a coherent blueprint, designing the
            entire system architecture with a holistic view of all project
            aspects—from user flows to technology stacks, roles, data flows, and
            analytics.
          </p> -->

          <!-- <p>
            I act as your <strong>all-in-one architect</strong>, designing the
            entire system with a holistic view of all project aspects—from user
            flows to technology stacks.
          </p> -->
          <!-- <TagGroup
            class="mt-6 gap-2 opacity-40 transition-opacity group-hover:opacity-100"
            tags={['Workshops', 'Architecture', 'Feasibility']}
            theme="chip"
            tagClass=""
          /> -->
        </div>
      </SectionContent>
    </BentoCard>

    <!-- Row 1: Col 2 - R&D & Prototyping (1:1) -->
    <BentoCard colSpan={1} rowSpan={1} padding="sm" class="group">
      <!-- hoverState={bentoStates.prototyping} -->
      <!-- I research the best path
            to validate your idea. -->
      <SectionContent context="grid" prose={true}>
        <div class="relative z-10">
          <div class="mb-1 flex items-baseline gap-2">
            <h3 class="m-0">R&D & Prototyping</h3>
            <PhaseLabel phase={2} />
          </div>
          <p class="text-sm leading-relaxed">
            I translate the Product Strategy into UX mockups and technical
            specification, and build a rough-but-usable prototype — something
            real to align on before we commit to the final build.
          </p>
        </div>
      </SectionContent>
    </BentoCard>

    <!-- Row 1: Col 3 - Holistic Design (1:1) -->
    <BentoCard colSpan={1} rowSpan={1} padding="sm" class="group">
      <!-- hoverState={bentoStates.logo} -->
      <SectionContent context="grid" prose={true}>
        <TagGroup class="mb-2" theme="label" tags={['Systems Thinking']} />
        <h3>End-to-End Design</h3>
        <p>
          Not just the app — the whole system. User flows, data flows,
          analytics, admin experience, and deployment — all aligned in one
          coherent blueprint.
        </p>
      </SectionContent>
    </BentoCard>

    <!-- Row 1-2: Col 4 - Avatar (1:2) (Was Col 1) -->
    <BentoCard colSpan={1} rowSpan={2} padding="none">
      <!-- hoverState={bentoStates.avatar} -->
      <SectionImage
        src="https://cdn.zentala.agency/images/avatar.jpg"
        alt="Paweł Żentała"
        aspectRatio="auto"
        objectFit="cover"
        hoverZoom={true}
        overlayPosition="bottom-left"
      >
        <h2 class="m-0 text-2xl font-light text-fg-subtle">
          Paweł Żentała
        </h2>

        <p class="font-light text-fg-subtle">
          20+ years in IT — between marketing, UX, web design, software
          development, through IoT, robotics, and management — perspectives that
          allow me to design solutions that work technically and practically.
          <!-- add: perrpkty pozowlily mi wiec i rozumiec szeroko, dzieki czemu moge... designs solutions that.... -->
        </p>
      </SectionImage>
    </BentoCard>

    <BentoCentralStage>
      <!-- Default: Sygnet -->
      <BentoStageState
        state={bentoStates.default}
        class="active flex h-full items-center justify-center bg-surface"
      >
        <div class="sygnet-wrapper">
          <Logo type="sygnet" width="220px" height="220px" color="var(--color-text)" />
        </div>
      </BentoStageState>

      <!-- State: Avatar -->
      <BentoStageState
        state={bentoStates.avatar}
        class="absolute inset-0 opacity-0"
      >
        <div class="relative h-full w-full">
          <img
            src="https://cdn.zentala.agency/images/avatar.jpg"
            alt="Paweł Żentała"
            class="h-full w-full object-cover opacity-40 grayscale"
          />
          <div
            class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black via-black/40 to-transparent p-6 md:p-10"
          >
            <h3 class="mb-2 text-2xl font-light text-fg md:text-3xl">
              Paweł Żentała
            </h3>
            <p
              class="max-w-md text-xs leading-relaxed text-fg-secondary md:text-sm"
            >
              Architect, Engineer, and Technical Leader with business and client
              understanding. I bridge the gap between abstract vision and
              functional reality.
            </p>
          </div>
        </div>
      </BentoStageState>

      <!-- State: Discovery/Prototyping (for Cards 1 & 2) -->
      <BentoStageState
        state={bentoStates.prototyping}
        class="absolute inset-0 flex flex-col justify-center bg-surface-raised p-8 opacity-0 md:p-12"
      >
        <h3 class="mb-4 text-2xl font-light text-fg md:text-3xl">
          Fast-Track MVP
        </h3>
        <div class="space-y-3 border-l border-line-strong pl-6 md:space-y-4">
          <div>
            <span
              class="text-label font-medium uppercase text-fg-subtle"
              >Step 01</span
            >
            <p class="text-base text-fg-secondary md:text-lg">
              Business & Tech Workshops
            </p>
          </div>
          <div>
            <span
              class="text-label font-medium uppercase text-fg-subtle"
              >Step 02</span
            >
            <p class="text-base text-fg-secondary md:text-lg">
              Rapid Functional Prototyping
            </p>
          </div>
          <div>
            <span
              class="text-label font-medium uppercase text-fg-subtle"
              >Step 03</span
            >
            <p class="text-base text-fg-secondary md:text-lg">
              Market Validation & Scale
            </p>
          </div>
        </div>
      </BentoStageState>

      <!-- State: CTO (for Card 7) -->
      <BentoStageState
        state={bentoStates.cto}
        class="absolute inset-0 flex flex-col justify-center bg-surface-raised p-8 opacity-0 md:p-12"
      >
        <h3 class="mb-2 text-2xl font-light text-fg md:text-3xl">
          Fractional CTO
        </h3>
        <p
          class="max-w-md text-lg italic leading-relaxed text-fg-muted md:text-xl"
        >
          "I don't just manage; I architect the future of your product while
          building the team that will carry it forward."
        </p>
      </BentoStageState>

      <!-- State: AI (for Card 8) -->
      <BentoStageState
        state={bentoStates.ai}
        class="absolute inset-0 flex flex-col justify-center bg-surface-raised p-8 opacity-0 md:p-12"
      >
        <h3 class="mb-6 text-2xl font-light text-fg md:text-3xl">
          AI Orchestration
        </h3>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4">
          <div>
            <p class="text-label font-medium uppercase text-fg-subtle">
              Multi-Agent Systems
            </p>
            <p class="text-xs text-fg-secondary md:text-sm">
              Automating complex workflows.
            </p>
          </div>
          <div>
            <p class="text-label font-medium uppercase text-fg-subtle">
              LLM Integration
            </p>
            <p class="text-xs text-fg-secondary md:text-sm">
              Context-aware architectures.
            </p>
          </div>
        </div>
      </BentoStageState>

      <!-- State: Logo/Agency (Hover info) -->
      <BentoStageState
        state={bentoStates.logo}
        class="absolute inset-0 flex items-center p-4 text-fg opacity-0 md:p-8 lg:p-10"
      >
        <div
          class="logo-state-content flex w-full flex-col items-center gap-3 text-center md:gap-4"
        >
          <Logo
            type="full"
            color="var(--color-text)"
            width="400px"
            height="72px"
            tagline="Innovation Agency"
          />
          <div class="mt-10 w-full px-16">
            <p
              class="text-base font-normal leading-tight md:text-lg lg:text-xl"
            >
              The ultimate format for technological bootstrapping.
            </p>
            <p
              class="mt-4 text-xs leading-relaxed text-fg-secondary md:text-sm lg:text-base"
            >
              I don't do everything. I focus on
              <strong class="font-medium text-fg">prototyping</strong>,
              providing the shortest path from idea to minimal viable product
              release.
            </p>
          </div>
        </div>
      </BentoStageState>
    </BentoCentralStage>

    <!-- Row 3-4: Col 1 - Portfolio (1:2) -->
    <BentoCard colSpan={1} rowSpan={2} padding="none">
      <a
        href="/portfolio"
        class="group relative block h-full w-full overflow-clip"
      >
        <CardIconMosaic tiles={PORTFOLIO_TILES} />
        <div
          class="pointer-events-none absolute inset-0 flex flex-col justify-end p-6 md:p-10"
        >
          <h3 class="mb-2 text-2xl font-light text-fg md:text-3xl">
            Portfolio
          </h3>
          <p
            class="max-w-md text-xs leading-relaxed text-fg-secondary md:text-sm"
          >
            Twenty years of shipped work — indoor location systems for
            retail, a socially-aware humanoid robot, Backstage portals for
            enterprises, and a smart home built into my own walls.
          </p>
          <span
            class="mt-3 inline-flex items-center gap-1 text-label font-medium uppercase text-fg-subtle transition-colors duration-fast ease-standard group-hover:text-fg-secondary"
          >
            See the portfolio
            <SiteIcon name="next" size="sm" class="arrow-nudge" />
          </span>
        </div>
      </a>
    </BentoCard>

    <!-- Row 3: Col 4 - Hands-On CTO (1:1) -->
    <BentoCard colSpan={1} rowSpan={1} padding="sm" class="group">
      <SectionContent context="grid" prose={true}>
        <div class="flex h-full flex-col justify-between">
          <div>
            <TagGroup
              class="mb-4 inline-flex gap-2"
              theme="label"
              tags={['Product‑Minded']}
            />
            <!-- 'Systems Thinker' -->
            <h1 style="font-size: var(--text-h2);">
              Your Hands-On CTO for an innovative project
            </h1>
            <p>
              I act as your technical co-founder to kick-up your idea into
              user-friendly live application.
            </p>
          </div>
          <div
            class="mt-4 border-l-2 border-line pl-3 transition-colors duration-fast ease-standard group-hover:border-line-strong"
          >
          </div>
        </div>
      </SectionContent>
    </BentoCard>

    <!-- Row 4: Col 2 - Orchestrating AI (1:1) -->
    <BentoCard colSpan={1} rowSpan={1} padding="sm" class="group">
      <!-- hoverState={bentoStates.ai} -->
      <SectionContent context="grid" prose={true}>
        <div class="relative z-10">
          <h3>AI-Accelerated Delivery</h3>
          <p class="text-sm leading-relaxed">
            I operate as an architect orchestrating a "team" of AI agents. This
            allows me to provide production-ready applications with the speed of
            an entire agency.
          </p>
          <!-- <TagGroup
            class="mt-4 gap-2 opacity-40 transition-opacity group-hover:opacity-100"
            tags={['AI-Agents', 'LLMs', 'Automation']}
            tagClass=""
          /> -->
        </div>
      </SectionContent>
    </BentoCard>

    <!-- Row 4: Col 3-4 - Strategy to Execution (2:1) -->
    <BentoCard colSpan={2} rowSpan={1} padding="sm" class="group">
      <!-- hoverState={bentoStates.logo} -->
      <!-- The whole card books the call. Raised above the z-10 content block,
           otherwise the text would swallow the click. -->
      <a
        href="https://cal.com/zentala"
        target="_blank"
        rel="noopener noreferrer"
        class="absolute inset-0 z-20"
        aria-label="Book a call about execution and delivery"></a>
      <div
        class="absolute right-6 top-1/2 -translate-y-1/2 opacity-[0.02] transition-[opacity,transform] duration-slow ease-standard group-hover:translate-x-2 group-hover:opacity-[0.08]"
      >
        <SiteIcon name="next" size={120} class="text-fg" />
      </div>
      <SectionContent context="grid" prose={true}>
        <div class="relative z-10 max-w-[85%]">
          <div class="mb-2 flex items-baseline gap-2">
            <h3 class="m-0">Execution & Delivery</h3>
            <PhaseLabel phase={3} />
          </div>
          <p>
            Once we align on the MVP scope and spec, I turn it into execution:
            complete solution architecture, implementation, and deployment. You
            get a production-ready first version online — ready to share with
            users, gather feedback, and validate in the market.
          </p>
          <span
            class="mt-3 inline-flex items-center gap-1 text-label font-medium uppercase text-fg-muted transition-colors duration-fast ease-standard group-hover:text-fg"
          >
            Book a call
            <SiteIcon name="next" size="sm" class="arrow-nudge" />
          </span>
        </div>
      </SectionContent>
    </BentoCard>
  </SectionBento>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const cards = document.querySelectorAll('[data-bento-hover]')
      const states = document.querySelectorAll('.state-content')
      const sygnetWrapper = document.querySelector(
        '.sygnet-wrapper',
      ) as HTMLElement
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      )

      const showState = (targetState: string | null) => {
        states.forEach((state) => {
          const isTarget = state.getAttribute('data-state') === targetState
          state.classList.toggle('active', isTarget)
          state.classList.toggle('opacity-100', isTarget)
          state.classList.toggle('opacity-0', !isTarget)
          state.classList.toggle('pointer-events-none', !isTarget)
        })

        if (sygnetWrapper) {
          const zoomLogo =
            targetState === 'logo' && !prefersReducedMotion.matches
          sygnetWrapper.style.transform = zoomLogo ? 'scale(20)' : 'scale(1)'
        }
      }

      // Hover and keyboard focus run the same state switch
      cards.forEach((card) => {
        const enter = () => showState(card.getAttribute('data-bento-hover'))
        const leave = () => showState('default')
        card.addEventListener('mouseenter', enter)
        card.addEventListener('mouseleave', leave)
        card.addEventListener('focusin', enter)
        card.addEventListener('focusout', leave)
      })
    })
  </script>

  <style lang="scss">
    .state-content {
      transition:
        opacity var(--motion-slow) var(--ease-standard),
        transform var(--motion-slow) var(--ease-standard);
      pointer-events: none;

      &.active {
        pointer-events: auto;
      }

      &[data-state='logo'] {
        .logo-state-content {
          transform: scale(0.01);
          transform-origin: center;
          transition: transform var(--motion-slow) var(--ease-standard);
        }

        &.active {
          .logo-state-content {
            transform: scale(1);
          }
        }
      }

      &[data-state='avatar'] {
        transform: scale(1.05);
        &.active {
          transform: scale(1);
        }
      }
    }

    .nav-font {
      @apply font-medium uppercase;
      font-size: 1.5rem;
      letter-spacing: 0.26rem;
      line-height: 1.2;

      @media (min-width: 771px) {
        font-size: 2rem;
      }
      @media (min-width: 1001px) {
        font-size: 2.5rem;
      }
    }

    .logo-text-anim {
      .active & {
        .logo-part-wrapper,
        span {
          transform: translateY(0) !important;
        }
      }
    }

    .sygnet-wrapper {
      will-change: transform;
      transition: transform var(--motion-slow) var(--ease-standard);
    }
  </style>
</Section>
