    "ai": "^4.3.16",
    "astro": "^5.11.0",
    "astro-icon": "^1.1.5",
    "lodash": "^4.17.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.4.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.1.1",
