{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "scripts": {
    "browserslist:update": "npx --yes update-browserslist-db@latest",
    "browserslist:update:if-stale": "node ./scripts/browserslist-update-if-stale.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "predev": "npm run browserslist:update:if-stale",
    "prestart": "npm run browserslist:update:if-stale",
    "prebuild": "npm run browserslist:update:if-stale",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:links": "playwright test tests/e2e/all-links.spec.ts",
    "test:links:banners": "playwright test tests/e2e/banner-links.spec.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "prepush": "npm run build && npm run test:links"
  },
  "dependencies": {
