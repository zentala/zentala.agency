    "eslint": "^9.4.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-prettier": "^5.1.3",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.1.0",
    "playwright": "^1.57.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-tailwindcss": "^0.6.1",
    "sass": "^1.77.4",
    "simple-git": "^3.36.0",
    "tailwindcss": "^3.4.17",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
